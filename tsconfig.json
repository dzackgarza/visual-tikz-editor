{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "types": [
      "bun",
      "mocha"
    ]
  },
  "include": [
    "src/**/*",
    "standalone/**/*",
    "test/**/*"
  ],
  "exclude": [
    "standalone/dist"
  ]
}
