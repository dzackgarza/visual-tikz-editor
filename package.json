{
  "name": "tikz-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone visual editor for mathematical diagrams with editable TikZ source.",
  "license": "GPL-3.0",
  "scripts": {
    "standalone": "bun run standalone/server.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "update-tikz-editor-vendor": "bun run scripts/update-tikz-editor-vendor.mjs",
    "update-quiver-vendor": "bun run scripts/update-quiver-vendor.mjs",
    "build": "vite build",
    "test": "mocha --no-config --no-package --require tsx --timeout 240000 test/*.spec.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.9",
    "@primeuix/themes": "^1",
    "@tikz-editor/lang-tikz": "0.5.1",
    "primeicons": "^7",
    "primevue": "^4",
    "viewerjs": "1.14.0",
    "vue": "^3.5.41",
    "zod": "^4.6.5",
    "svg2tikz": "0.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/bun": "^1.4.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "less": "^4.9.0",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vue-tsc": "^3.3.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dzackgarza/visual-tikz-editor.git"
  },
  "patchedDependencies": {
    "@tikz-editor/lang-tikz@0.5.1": "patches/@tikz-editor%2Flang-tikz@0.5.1.patch",
    "@tikz-editor/lezer-tikz@0.5.1": "patches/@tikz-editor%2Flezer-tikz@0.5.1.patch"
  },
  "packageManager": "bun@1.3.11"
}
