diff --git a/packages/app/src/ui/canvas-panel/paper-scope.ts b/packages/app/src/ui/canvas-panel/paper-scope.ts
new file mode 100644
index 00000000..c6d66e2a
--- /dev/null
+++ b/packages/app/src/ui/canvas-panel/paper-scope.ts
@@ -0,0 +1,17 @@
+import paper from "paper";
+
+let scope: paper.PaperScope | null = null;
+
+/**
+ * The one paper.js scope for off-screen geometry. paper.js creates every item in the
+ * project of the active scope, so each use activates this one
+ * (http://paperjs.org/reference/paperscope/#activate).
+ */
+export function geometryScope(): paper.PaperScope {
+  if (!scope) {
+    scope = new paper.PaperScope();
+    scope.setup(new scope.Size(1, 1));
+  }
+  scope.activate();
+  return scope;
+}
diff --git a/packages/app/src/ui/canvas-panel/partial-erase.ts b/packages/app/src/ui/canvas-panel/partial-erase.ts
new file mode 100644
index 00000000..3ba9062e
--- /dev/null
+++ b/packages/app/src/ui/canvas-panel/partial-erase.ts
@@ -0,0 +1,124 @@
+import type paper from "paper";
+import type { WorldPoint } from "../coords/types";
+import { localToSourceUnits, worldToLocal } from "tikz-editor/edit/coords";
+import { formatNumber } from "tikz-editor/edit/format";
+import type { EditParseOptions } from "tikz-editor/edit/parse-options";
+import { buildStatementText, resolveEligibleExplicitPath, resolvePathControlHandle } from "tikz-editor/edit/path-editing";
+import { isFrameLocalCoordinateEditHandle, type EditHandle } from "tikz-editor/semantic/types";
+import { geometryScope } from "./paper-scope";
+
+/**
+ * Partial erasing: the eraser sweep is a region of capsules in world space, and an
+ * explicit line or cubic path keeps the parts outside it as separate statements.
+ * The cut is paper.js boolean subtraction of the region from the open path
+ * (`PathItem#subtract` with `trace: false`, http://paperjs.org/reference/pathitem/#subtract-path).
+ */
+
+type SourcePoint = { world: WorldPoint; raw: string | null };
+
+/** A path statement the sweep can cut: its world geometry and how to write points back in its frame. */
+export type CuttablePath = {
+  span: { from: number; to: number };
+  text: (body: string) => string;
+  sourcePoint: (world: { x: number; y: number }) => string | null;
+  anchors: SourcePoint[];
+  /** For each segment, its two controls, or null for a line. */
+  controls: Array<[SourcePoint, SourcePoint] | null>;
+  closed: boolean;
+};
+
+function samePoint(a: { x: number; y: number }, b: { x: number; y: number }): boolean {
+  return Math.abs(a.x - b.x) < 1e-6 && Math.abs(a.y - b.y) < 1e-6;
+}
+
+/** The statement `sourceId` as a cuttable path, or null when it is not an explicit line or cubic path with editable points. */
+export function cuttablePath(source: string, sourceId: string, handles: readonly EditHandle[], parseOptions: EditParseOptions): CuttablePath | null {
+  const resolved = resolveEligibleExplicitPath(source, sourceId, parseOptions);
+  if (resolved.kind !== "eligible") return null;
+  const { analysis } = resolved;
+  const anchorHandles = analysis.anchors.map((anchor) => handles.find((handle) => handle.kind === "path-point" &&
+    handle.sourceRef.sourceId === sourceId && handle.sourceRef.sourceSpan.from === anchor.item.span.from && handle.sourceRef.sourceSpan.to === anchor.item.span.to));
+  const frameHandle = anchorHandles[0];
+  if (!frameHandle || !isFrameLocalCoordinateEditHandle(frameHandle) || anchorHandles.some((handle) => !handle)) return null;
+  const frame = frameHandle.frame;
+  // A relative coordinate depends on the point before it, so only absolute text survives a cut unchanged.
+  const keep = (handle: EditHandle, raw: string): SourcePoint => ({ world: handle.world, raw: isFrameLocalCoordinateEditHandle(handle) && handle.rewriteMode !== "delta" ? raw : null });
+  const anchors = analysis.anchors.map((anchor, index) => keep(anchorHandles[index]!, anchor.raw));
+  const controls: CuttablePath["controls"] = [];
+  for (const segment of analysis.segments) {
+    if (segment.kind === "line") { controls.push(null); continue; }
+    const items = [segment.control1Index, segment.control2Index].map((index) => analysis.statement.items[index]);
+    const pair = items.map((item) => item?.kind === "Coordinate" ? resolvePathControlHandle(handles, sourceId, item, source) : null);
+    if (!pair[0] || !pair[1] || items[0]?.kind !== "Coordinate" || items[1]?.kind !== "Coordinate") return null;
+    controls.push([keep(pair[0], source.slice(items[0].span.from, items[0].span.to)), keep(pair[1], source.slice(items[1].span.from, items[1].span.to))]);
+  }
+  return {
+    span: analysis.statement.span,
+    text: (body) => buildStatementText(source, analysis, body),
+    sourcePoint: (world) => {
+      const local = worldToLocal(world as WorldPoint, frame);
+      if (!local) return null;
+      const cm = localToSourceUnits(local);
+      return `(${formatNumber(cm.x)},${formatNumber(cm.y)})`;
+    },
+    anchors,
+    controls,
+    closed: analysis.closed
+  };
+}
+
+/** The capsule a sweep from `from` to `to` covers with radius `radius`. */
+export function sweepCapsule(from: { x: number; y: number }, to: { x: number; y: number }, radius: number): paper.PathItem {
+  const scope = geometryScope();
+  const start = new scope.Point(from.x, from.y);
+  const end = new scope.Point(to.x, to.y);
+  let capsule: paper.PathItem = new scope.Path.Circle({ center: start, radius, insert: false });
+  if (end.getDistance(start) > 1e-9) {
+    const normal = end.subtract(start).normalize(radius).rotate(90, new scope.Point(0, 0));
+    const band = new scope.Path({ segments: [start.add(normal), end.add(normal), end.subtract(normal), start.subtract(normal)], closed: true, insert: false });
+    capsule = capsule.unite(band, { insert: false }).unite(new scope.Path.Circle({ center: end, radius, insert: false }), { insert: false });
+  }
+  return capsule;
+}
+
+/**
+ * The statements left of `path` after `region` is erased: null when the region misses it,
+ * an empty list when it covers it, otherwise one statement per remaining piece.
+ */
+export function remainingStatements(path: CuttablePath, region: paper.PathItem, minimumLength: number): string[] | null {
+  const scope = geometryScope();
+  const segments = path.anchors.map((anchor) => new scope.Segment(new scope.Point(anchor.world.x, anchor.world.y)));
+  path.controls.forEach((pair, index) => {
+    if (!pair) return;
+    const start = segments[index], end = segments[(index + 1) % segments.length];
+    start.handleOut = new scope.Point(pair[0].world.x, pair[0].world.y).subtract(start.point);
+    end.handleIn = new scope.Point(pair[1].world.x, pair[1].world.y).subtract(end.point);
+  });
+  const geometry = new scope.Path({ segments, closed: path.closed, insert: false });
+  if (geometry.getIntersections(region).length === 0) return region.contains(geometry.firstSegment.point) ? [] : null;
+  const rest = geometry.subtract(region, { trace: false, insert: false });
+  const pieces = (rest instanceof scope.CompoundPath ? rest.children : [rest]) as paper.Path[];
+  const statements: string[] = [];
+  for (const piece of pieces) {
+    if (piece.length < minimumLength) continue;
+    const write = (point: paper.Point): string | null => {
+      const original = [...path.anchors, ...path.controls.flatMap((pair) => pair ?? [])].find((item) => item.raw && samePoint(item.world, point));
+      return original?.raw ?? path.sourcePoint(point);
+    };
+    const first = write(piece.firstSegment.point);
+    if (!first) return null;
+    const parts = [first];
+    const count = piece.closed ? piece.segments.length : piece.segments.length - 1;
+    for (let index = 0; index < count; index++) {
+      const start = piece.segments[index], end = piece.segments[(index + 1) % piece.segments.length];
+      const target = index + 1 === piece.segments.length ? "cycle" : write(end.point);
+      if (!target) return null;
+      if (start.handleOut.isZero() && end.handleIn.isZero()) { parts.push(`-- ${target}`); continue; }
+      const control1 = write(start.point.add(start.handleOut)), control2 = write(end.point.add(end.handleIn));
+      if (!control1 || !control2) return null;
+      parts.push(`.. controls ${control1} and ${control2} .. ${target}`);
+    }
+    statements.push(path.text(parts.join(" ")));
+  }
+  return statements;
+}
