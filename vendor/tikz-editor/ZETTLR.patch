+    const belowNearStart = applyEditAction(source, handles, { kind: 'addPathAttachedNode', elementId: 'path:0', point: wp(cm(6), cm(2.8)), text: 'node' });
+    expect(belowNearStart.kind).toBe('success');
+    if (belowNearStart.kind !== 'success') return;
+    expect(belowNearStart.newSource).toBe(figure('\\draw (5,3) -- (9,3) node[near start,auto=right] {node};'));
+    const second = applyEditAction(above.newSource, handlesOf(above.newSource), { kind: 'addPathAttachedNode', elementId: 'path:0', point: wp(cm(8.9), cm(3.1)), text: 'end' });
+    expect(second.kind).toBe('success');
+    if (second.kind !== 'success') return;
