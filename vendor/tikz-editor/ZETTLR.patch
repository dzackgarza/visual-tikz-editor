@@ -0,0 +1,61 @@
+import { useMemo, useState } from "react";
+import { resolveFigureCoordinateFrame } from "tikz-editor/edit/coordinate-frame";
+import { latticeStepStatement } from "tikz-editor/edit/lattice-units";
+import type { CanvasSettings } from "../settings/types";
+import { useSettingsStore } from "../settings/useSettingsStore";
+import { useEditorStore } from "../store/store";
+import { ToolbarToolPopup, ToolbarPopupSection } from "./ToolbarToolPopup";
+import css from "./SnapControl.module.css";
+
+type SnapRuleKey = keyof Pick<CanvasSettings, "latticeLock" | "snapObjects" | "snapAlignment" | "constrainGeometry">;
+
+type SnapRule = {
+  key: SnapRuleKey;
+  label: string;
+  /** The word after "Snap:" when this is the first rule that is on. */
+  name: string;
+  description: string;
+};
+
+/** The snapping rules in precedence order; the control is named after the first one that is on. */
+const SNAP_RULES: readonly SnapRule[] = [
+  { key: "latticeLock", label: "Lattice", name: "lattice", description: "Points land on the lattice" },
+  { key: "snapObjects", label: "Objects", name: "objects", description: "Endpoints attach to nodes and to the ends of open paths" },
+  { key: "snapAlignment", label: "Alignment", name: "alignment", description: "Edges, centres, and equal gaps line up with other objects and ruler guides" },
+  { key: "constrainGeometry", label: "Angle", name: "angle", description: "Lines keep 15-degree steps, rectangles stay square, moves stay on one axis" }
+];
+
+/** One rail control that names the active snapping rule and opens every rule with its state. */
+export function SnapControl({ triggerClassName }: { triggerClassName: string }) {
+  const [open, setOpen] = useState(false);
+  const canvas = useSettingsStore((state) => state.settings.canvas);
+  const updateCanvasSettings = useSettingsStore((state) => state.updateCanvasSettings);
+  const source = useEditorStore((state) => state.source);
+  const activeFigureId = useEditorStore((state) => state.activeFigureId);
+  const active = SNAP_RULES.find((rule) => canvas[rule.key]);
+  const ruleName = active?.name ?? "off";
+  const latticeStep = useMemo(
+    () => open ? latticeStepStatement(resolveFigureCoordinateFrame(source, { activeFigureId })) : null,
+    [open, source, activeFigureId]
+  );
+
+  return (
+    <ToolbarToolPopup open={open} onClose={() => setOpen(false)} popup={
+      <ToolbarPopupSection title="Snapping">
+        <div className={css.rules}>{SNAP_RULES.map((rule) => (
+          <button type="button" key={rule.key} className={css.rule} aria-label={rule.label} aria-pressed={canvas[rule.key]}
+            aria-description={rule.description} onClick={() => updateCanvasSettings({ [rule.key]: !canvas[rule.key] })}>
+            <span className={css.ruleLabel}>{rule.label}</span>
+            <span className={css.ruleDescription}>{rule.description}</span>
+          </button>
+        ))}</div>
+        <p className={css.latticeStep}>{latticeStep}</p>
+      </ToolbarPopupSection>}>
+      <button type="button" className={`${triggerClassName} ${css.trigger}`} aria-label={`Snap: ${ruleName}`}
+        aria-haspopup="dialog" aria-expanded={open} onClick={() => setOpen((current) => !current)}>
+        <span className={css.triggerIcon} aria-hidden="true">Snap</span>
+        <span className={css.triggerRule} aria-hidden="true">{ruleName}</span>
+      </button>
+    </ToolbarToolPopup>
+  );
+}
