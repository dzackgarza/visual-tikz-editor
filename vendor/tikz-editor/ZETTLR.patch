 /* ── FlexLayout theme overrides ─────────────────────────────────────────────── */
 /* Built on top of flexlayout-react/style/gray.css imported in DockLayout.tsx  */
 
+.dock-layout,
+.embed-dock-layout {
+  position: relative;
+  width: 100%;
+  height: 100%;
+  min-width: 0;
+  min-height: 0;
+}
+
+.embed-inspector {
+  position: absolute;
+  top: calc(var(--rail-inset-top) + 8px);
+  right: calc(var(--rail-inset-right) + 8px);
+  z-index: 30;
+  display: flex;
+  flex-direction: column;
+  width: min(280px, calc(100% - 16px - var(--rail-inset-left) - var(--rail-inset-right)));
+  height: min(600px, 70%);
+  min-height: 0;
+  border: 1px solid var(--border);
+  border-radius: 12px;
+  background: var(--bg-pane);
+  box-shadow: 0 8px 30px color-mix(in srgb, black 24%, transparent);
+  overflow: hidden;
+}
+
+/* A portrait sheet spans the canvas above the dock and stays in its lower half,
+   which starts below the canvas header and ruler band; expanded, it takes the
+   canvas height the rail leaves. An open keyboard raises it and caps its height. */
+.embed-inspector[data-placement="sheet"] {
+  top: auto;
+  left: calc(var(--rail-inset-left) + 8px);
+  right: calc(var(--rail-inset-right) + 8px);
+  bottom: calc(max(var(--rail-inset-bottom), var(--keyboard-inset-bottom)) + 8px);
+  width: auto;
+  height: calc(50% - var(--rail-inset-bottom) - 48px);
+  max-height: calc(100% - var(--rail-inset-top) - max(var(--rail-inset-bottom), var(--keyboard-inset-bottom)) - 56px);
+}
+
+.embed-inspector[data-placement="sheet"][data-expanded="true"] {
+  height: calc(100% - var(--rail-inset-top) - var(--rail-inset-bottom) - 24px);
+}
+
+.embed-inspector-tabs {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 4px;
+  padding: 6px;
+  border-bottom: 1px solid var(--border);
+  background: var(--bg-header);
+}
+
+.embed-inspector-tabs button {
+  min-width: 44px;
+  min-height: 44px;
+  padding: 0 9px;
+  border: 0;
+  border-radius: 8px;
+  background: transparent;
+  color: var(--text);
+  font: 14px var(--font-ui);
+  cursor: pointer;
+}
+
+.embed-inspector-tabs button[aria-selected="true"] {
+  background: var(--accent-btn-bg);
+  color: var(--accent-dark);
+}
+
+.embed-inspector-tabs .embed-inspector-expand {
+  margin-left: auto;
+  font-size: 20px;
+}
+
+.embed-inspector-tabs .embed-inspector-close {
+  margin-left: auto;
+  font-size: 24px;
+}
+
+.embed-inspector-tabs .embed-inspector-expand + .embed-inspector-close {
+  margin-left: 0;
+}
+
+.embed-inspector-content {
+  flex: 1;
+  min-height: 0;
+  overflow: auto;
+}
