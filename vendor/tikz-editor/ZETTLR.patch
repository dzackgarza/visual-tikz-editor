+    expect(ensurePointHasName(source, named, {})).toEqual({ source, reference: 'A', insertedAt: null });
+    const unnamed = handles.find((handle) => handle.kind === 'node-position' && handle.sourceRef.sourceId === 'path:1')!;
+    const namedNode = ensurePointHasName(source, unnamed, {})!;
+    expect(namedNode.reference).toBe('node1');
+    expect(namedNode.source).toContain('\\node[draw] (node1) at (1,1) {B};');
+    const start = handles.find((handle) => handle.kind === 'path-point' && handle.sourceRef.sourceId === 'path:2' && handle.sourceText === '(3.37,8.61)')!;
+    const first = ensurePointHasName(source, start, {})!;
+    expect(first.reference).toBe('p2');
+    expect(first.source).toContain('\\draw (3.37,8.61) coordinate (p2) -- (7.23,9.29);');
+    expect(first.insertedAt).toBe(source.indexOf('(3.37,8.61)') + '(3.37,8.61)'.length);
+    const again = handlesOf(first.source).find((handle) => handle.kind === 'path-point' && handle.sourceRef.sourceId === 'path:2' && handle.sourceText === '(3.37,8.61)')!;
