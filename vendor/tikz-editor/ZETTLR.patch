@@ -0,0 +1,353 @@
+import { boundsInLatticeUnits, latticeStepStatement } from '../packages/core/src/edit/lattice-units';
+import { resolveFigureCoordinateFrame } from '../packages/core/src/edit/coordinate-frame';
+import { worldBounds, worldTransform, worldVector, pt } from '../packages/core/src/coords/index';
+import { constrainTranslationToAxis, resolveToolCreateCurrentWorld } from '../packages/app/src/ui/canvas-panel/interaction-helpers';
+import { resolveArcToolPoint } from '../packages/app/src/ui/canvas-panel/arc-tool';
+import { editorReducer, makeInitialState } from '../packages/app/src/store/reducer';
+import { APP_MENU_COMMAND_IDS as ID } from '../packages/app/src/app-menu/types';
+import { SHORTCUT_COMMANDS, matchesCommand, parseShortcutOverrides, recordShortcut, shortcutConflict } from '../packages/app/src/settings/keybindings';
+import { describe, expect, it } from 'vitest';
+import { tikzColorOptions, tikzColorValue } from '../packages/core/src/edit/color-value.js';
+import { applyAddLayerAction, applyMoveIntoScopeAction } from '../packages/core/src/edit/actions/layer-actions.js';
+import { parseStatementSnapshot } from '../packages/core/src/edit/statement-ops.js';
+import { buildSnapContext, snapToolPointer, LATTICE_UNIT_PT } from '../packages/core/src/edit/snapping/index.js';
+import { wp } from './coords-helpers.js';
+import { applyEditAction } from '../packages/core/src/edit/actions.js';
+import { resolveEligibleExplicitPath } from '../packages/core/src/edit/path-editing.js';
+import { ensurePointHasName } from '../packages/core/src/edit/point-naming.js';
+import { parseTikz } from '../packages/core/src/parser/index.js';
+import { evaluateTikzFigure } from '../packages/core/src/semantic/evaluate.js';
+import { cm } from './edit-actions-helpers.js';
+import { resolvePointTarget } from '../packages/app/src/ui/canvas-panel/point-target.js';
+import { computeDragCapability } from '../packages/app/src/ui/canvas-panel/drag-capability.js';
+
+// These exercise the same source transformations and snap entry point as the canvas,
+// without paying for a browser to prove arithmetic or dependency ordering.
+describe('tablet authoring logic', () => {
+  it('encodes picker channels and separates opacity from xcolor', () => {
+    expect(tikzColorOptions('draw', '#2196f3')).toEqual(['draw={rgb,255:red,33;green,150;blue,243}']);
+    expect(tikzColorOptions('fill', 'rgba(33, 150, 243, 0.35)')).toEqual([
+      'fill={rgb,255:red,33;green,150;blue,243}', 'fill opacity=0.35'
+    ]);
+    expect(tikzColorValue('#2196f380')).toEqual({ color: '{rgb,255:red,33;green,150;blue,243}', opacity: 128 / 255 });
+    expect(tikzColorValue('blue!30!red')).toEqual({ color: 'blue!30!red', opacity: null });
+    expect(() => tikzColorValue('#12345')).toThrow(Error);
+  });
+
+  it('quantizes a locked pointer but leaves a free pointer between lattice points', () => {
+    const pointer = wp(3.4 * LATTICE_UNIT_PT, -2.3 * LATTICE_UNIT_PT);
+    const context = buildSnapContext({ sceneElements: [], selectedSourceIds: [], zoom: 1 });
+    const locked = snapToolPointer({ context, pointer, kind: 'line-end', settings: { latticeLock: true } });
+    expect(locked.snappedPoint?.x).toBeCloseTo(3 * LATTICE_UNIT_PT, 8);
+    expect(locked.snappedPoint?.y).toBeCloseTo(-2 * LATTICE_UNIT_PT, 8);
+    const free = snapToolPointer({ context, pointer, kind: 'line-end', settings: { latticeLock: false } });
+    expect(free.snappedPoint).toEqual(pointer);
+  });
+
+  it('attracts a free pointer to a guide only within the screen threshold', () => {
+    const context = buildSnapContext({ sceneElements: [], selectedSourceIds: [], zoom: 2, guides: { x: [100] } });
+    const near = snapToolPointer({ context, pointer: wp(103, 73), kind: 'line-end' });
+    expect(near.snappedPoint).toEqual(wp(100, 73));
+    const far = snapToolPointer({ context, pointer: wp(105, 73), kind: 'line-end' });
+    expect(far.snappedPoint).toEqual(wp(105, 73));
+  });
+
+  it('moves a drawing into a named top-level scope without changing its geometry', () => {
+    const source = String.raw`\begin{tikzpicture}
+\draw[blue] (1,2) -- (4,6);
+\end{tikzpicture}`;
+    const added = applyAddLayerAction(source, 'Foreground');
+    expect(added.kind).toBe('success');
+    if (added.kind !== 'success') throw new Error('Adding a layer failed');
+    const snapshot = parseStatementSnapshot(added.newSource);
+    const scope = snapshot.all.find(ref => ref.statement.kind === 'Scope')!;
