+  cursor: pointer;
+}
+
+.actions button:focus-visible {
+  outline: 2px solid #9e2a2b;
+  outline-offset: 2px;
+}
+
+.reapply {
+  position: fixed;
+  z-index: 190;
+  min-height: 44px;
+  padding: 8px 14px;
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  background: var(--bg-pane);
