@@ -0,0 +1,49 @@
+import type { EditHandle } from "tikz-editor/semantic/types";
+import type { WorldPoint } from "../coords/types";
+
+/**
+ * Pen policy on existing points (docs/research/pen-input-on-existing-points.md in the host):
+ * a stroke that starts or ends on a point attaches to it; a finger held by the other hand,
+ * or the pen held still past a delay, moves the point instead.
+ */
+
+/** How far from a point, in screen pixels, a pen contact still lands on it. */
+export const POINT_TARGET_RADIUS_PX = 12;
+/** Pen travel, in screen pixels, that turns a hold on a point into a stroke. */
+export const POINT_HOLD_SLOP_PX = 6;
+/** A touch contact wider than this, in CSS pixels, is a resting palm, not a finger held as a modifier. */
+const FINGER_MAX_CONTACT_PX = 44;
+
+export type PointTarget = { handle: EditHandle; movable: boolean };
+
+/** What the mark on the target point says: a stroke attaches to it, a hold is filling, or the pen moves it. */
+export type PointTargetMark = { world: WorldPoint; state: "attach" | "hold" | "move"; holdMs: number };
+
+/** The nearest path point or node position within reach of `world`, and whether the pen may move it. */
+export function resolvePointTarget(input: {
+  world: WorldPoint;
+  scale: number;
+  handles: readonly EditHandle[];
+  draggableHandleIds: ReadonlySet<string>;
+  lockedSourceIds: ReadonlySet<string>;
+}): PointTarget | null {
+  const reach = POINT_TARGET_RADIUS_PX / Math.max(input.scale, 1e-6);
+  let best: EditHandle | null = null;
+  let bestDistance = reach * reach;
+  for (const handle of input.handles) {
+    if (handle.kind !== "path-point" && handle.kind !== "node-position") continue;
+    // A named reference such as `(p1)` follows the point it names, so the pen lands on that point, never on the reference.
+    if (handle.coordinateForm === "named") continue;
+    const distance = (handle.world.x - input.world.x) ** 2 + (handle.world.y - input.world.y) ** 2;
+    if (distance > bestDistance) continue;
+    best = handle;
+    bestDistance = distance;
+  }
+  if (!best) return null;
+  return { handle: best, movable: input.draggableHandleIds.has(best.id) && !input.lockedSourceIds.has(best.sourceRef.sourceId) };
+}
+
+/** Whether `event` is a finger contact, as opposed to a pen, a mouse, or a palm. */
+export function isFingerContact(event: PointerEvent): boolean {
+  return event.pointerType === "touch" && event.width <= FINGER_MAX_CONTACT_PX && event.height <= FINGER_MAX_CONTACT_PX;
+}
