+.popup {
+  position: fixed;
+  z-index: 200;
+  display: grid;
+  gap: 10px;
+  width: 268px;
+  max-width: min(300px, calc(100vw - 24px - var(--rail-inset-left) - var(--rail-inset-right)));
+  overflow-y: auto;
+  padding: 12px;
+  border: 1px solid var(--border);
+  border-radius: 12px;
+  color: var(--text);
+  background: var(--bg-pane);
+  box-shadow: 0 8px 24px color-mix(in srgb, black 25%, transparent);
+  font-size: 14px;
+}
+
+.popup strong {
+  text-transform: capitalize;
+}
+
+.popup label {
+  display: grid;
+  grid-template-columns: 1fr auto;
+  align-items: center;
+  gap: 6px;
+}
+
+.defaults {
+  display: grid;
+  gap: 8px;
+  padding-top: 8px;
+  border-top: 1px solid var(--border);
+}
+
+.popup input[type="checkbox"] {
+  accent-color: #9e2a2b;
+}
+
+.actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+}
+
+.actions button {
+  min-height: 44px;
+  padding: 4px 10px;
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  background: var(--bg-app);
+  color: var(--text);
+  font: inherit;
+  cursor: pointer;
+}
+
+.actions button:focus-visible {
+  outline: 2px solid #9e2a2b;
+  outline-offset: 2px;
+}
+
+.rangeControls {
+  position: fixed;
+  z-index: 190;
+  display: grid;
+  gap: 6px;
+  box-sizing: border-box;
+  width: 300px;
+  overflow: auto;
+  overscroll-behavior: contain;
+  max-width: min(300px, calc(100vw - 24px));
+  padding: 8px;
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  background: var(--bg-pane);
+  color: var(--text);
+  box-shadow: 0 4px 14px color-mix(in srgb, black 20%, transparent);
+  font: 14px var(--font-ui);
+}
+
+.rangeControls button {
+  min-height: 44px;
+  white-space: normal;
+  overflow-wrap: anywhere;
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  background: var(--bg-app);
+  color: var(--text);
+  font: inherit;
+  cursor: pointer;
+}
+
+.rangeControls button:focus-visible {
+  outline: 2px solid #9e2a2b;
+  outline-offset: 2px;
+}
+
+.rangeControls label {
+  display: grid;
+  gap: 4px;
+}
+
+.rangeControls input {
+  width: 100%;
+  accent-color: #9e2a2b;
+}
+
+.popup input[type="checkbox"], .rangeControls input[type="checkbox"] {
+  width: 20px;
+  height: 20px;
+  grid-column: auto;
+}
+
+.lockToggle { display: flex; align-items: center; justify-content: center; gap: 6px; }
