+}
+
+.actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+}
+
+.actions button {
+  min-height: 44px;
+  padding: 4px 10px;
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  background: var(--bg-app);
+  color: var(--text);
+  font: inherit;
+  cursor: pointer;
+}
+
+.actions button:focus-visible {
+  outline: 2px solid #9e2a2b;
+  outline-offset: 2px;
+}
+
+.reapply {
+  position: fixed;
+  z-index: 190;
+  min-height: 44px;
+  padding: 8px 14px;
+  border: 1px solid var(--border);
+  border-radius: 10px;
