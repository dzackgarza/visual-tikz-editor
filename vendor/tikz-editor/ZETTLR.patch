+describe('tablet geometry constraints and bounds', () => {
+  it('keeps snapped translations on the dominant canvas axis and leaves a stationary pointer stationary', () => {
+    expect(constrainTranslationToAxis(worldVector(pt(100), pt(30)), worldVector(pt(99), pt(5)))).toEqual(worldVector(pt(99), pt(0)));
+    expect(constrainTranslationToAxis(worldVector(pt(10), pt(-100)), worldVector(pt(5), pt(-99)))).toEqual(worldVector(pt(0), pt(-99)));
+    expect(constrainTranslationToAxis(worldVector(pt(0), pt(0)), worldVector(pt(5), pt(5)))).toEqual(worldVector(pt(0), pt(0)));
+  });
+
+  it('ends an arc on a lattice point of its circle within reach, else on a common angle, else where the pen points', () => {
+    const unit = LATTICE_UNIT_PT;
+    const rules = { latticeLock: true, constrainAngle: false, bypassLattice: false, latticeTransform: undefined, reachWorld: 6 };
+    const draft = { center: wp(10 * unit, -3 * unit), start: wp(12 * unit, -1 * unit) };
+    const towards = (degrees: number, radius = Math.SQRT2 * 2 * unit) =>
+      wp(10 * unit + radius * Math.cos(degrees * Math.PI / 180), -3 * unit + radius * Math.sin(degrees * Math.PI / 180));
+    // Two degrees past the half circle: the lattice point (8,-5) on that ray is within six points of the pen.
+    const half = resolveArcToolPoint(draft, towards(227), towards(227), rules);
+    expect(half).toEqual({ point: wp(8 * unit, -5 * unit), target: 'named', label: 'Lattice' });
+    // At ninety degrees the nearest lattice points of this circle are forty-five degrees away; the common angle takes it.
+    const up = resolveArcToolPoint(draft, towards(91), towards(91), rules);
+    expect(up.target === 'named' && up.label).toBe('Angle');
+    expect(Math.atan2(up.point.y + 3 * unit, up.point.x - 10 * unit) * 180 / Math.PI).toBeCloseTo(90, 8);
+    expect(Math.hypot(up.point.x - 10 * unit, up.point.y + 3 * unit)).toBeCloseTo(Math.SQRT2 * 2 * unit, 8);
+    // Nothing pulls at 101 degrees: the end stays on the circle at the pen's angle and no rule names it.
+    const free = resolveArcToolPoint(draft, towards(101), towards(101), rules);
+    expect(free.target).toBe('none');
+    expect(Math.atan2(free.point.y + 3 * unit, free.point.x - 10 * unit) * 180 / Math.PI).toBeCloseTo(101, 8);
+    // The angle constraint rounds to fifteen degrees before any other rule.
+    const stepped = resolveArcToolPoint(draft, towards(227), towards(227), { ...rules, constrainAngle: true });
+    expect(stepped.target === 'named' && stepped.label).toBe('Angle');
+    expect(Math.atan2(stepped.point.y + 3 * unit, stepped.point.x - 10 * unit) * 180 / Math.PI).toBeCloseTo(-135, 8);
+    // A centre off the lattice gives no lattice candidate and no warning; the common angle still pulls.
+    const offLattice = resolveArcToolPoint({ center: wp(-unit, 4.5 * unit), start: wp(unit, 5 * unit) }, wp(-unit + 0.05 * unit, 7 * unit), wp(-unit + 0.05 * unit, 7 * unit), rules);
+    expect(offLattice.target === 'named' && offLattice.label).toBe('Angle');
+    expect(offLattice.point.x).toBeCloseTo(-unit, 8);
+    // Before a start exists the engine's point stands and its target with it.
+    expect(resolveArcToolPoint({ center: draft.center }, towards(10), wp(13 * unit, -3 * unit), rules)).toEqual({ point: wp(13 * unit, -3 * unit), target: 'engine' });
+  });
+
+  it('constrains a free line to fifteen degrees and a rectangle to a square', () => {
+    const start = wp(0, 0);
+    const pointer = wp(100, 30);
+    expect(resolveToolCreateCurrentWorld(start, pointer, 'addLine', false)).toEqual(pointer);
+    const line = resolveToolCreateCurrentWorld(start, pointer, 'addLine', true);
+    expect(Math.atan2(line.y, line.x) * 180 / Math.PI).toBeCloseTo(15, 8);
+    const rectangle = resolveToolCreateCurrentWorld(start, pointer, 'addRect', true);
