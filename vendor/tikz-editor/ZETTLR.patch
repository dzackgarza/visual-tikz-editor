+      if (construction?.kind !== "arc") return "place the centre";
+      return construction.draft.start === undefined ? "place the start point" : "place the end point";
+    case "addCircle":
+      if (variant.circle === "three-points") return ORDINAL_POINTS[construction?.kind === "taps" ? construction.draft.points.length : 0];
+      if (variant.circle === "diameter") return construction?.kind === "taps" ? "place the other end of the diameter" : "place one end of the diameter";
+      return "drag from the centre to the edge";
+    case "addPath": return construction?.kind === "path" ? "place the next point, drag to bend, or tap the start to close" : "place the first point";
+    case "addBezier": return construction?.kind === "bezier" ? "drag to bend the curve" : "drag from the start to the end";
+    case "addLine": return "drag from the start to the end";
+    case "addArrow": return "drag from the tail to the head";
+    case "addRect":
+    case "addGrid": return "drag from corner to corner";
+    case "addEllipse": return "drag across its bounding box";
+    case "addShape": return "drag to set its size";
+    default: return "tap to place";
+  }
