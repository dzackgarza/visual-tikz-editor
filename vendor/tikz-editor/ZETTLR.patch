+.popup {
+  position: fixed;
+  z-index: 200;
+  display: grid;
+  gap: 10px;
+  width: 268px;
+  max-width: min(300px, calc(100vw - 24px - var(--rail-inset-left) - var(--rail-inset-right)));
+  overflow-y: auto;
+  padding: 12px;
+  border: 1px solid var(--border);
+  border-radius: 12px;
+  color: var(--text);
+  background: var(--bg-pane);
+  box-shadow: 0 8px 24px color-mix(in srgb, black 25%, transparent);
+  font-size: 14px;
+}
+
+.popup strong {
+  text-transform: capitalize;
+}
+
+.popup label {
+  display: grid;
+  grid-template-columns: 1fr auto;
+  align-items: center;
+  gap: 6px;
+}
+
+.actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+}
+
+.actions button {
+  min-height: 44px;
+  padding: 4px 10px;
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  background: var(--bg-app);
+  color: var(--text);
+  font: inherit;
+  cursor: pointer;
+}
+
+.actions button:focus-visible {
+  outline: 2px solid #9e2a2b;
+  outline-offset: 2px;
+}
+
+.rangeControls {
+  position: fixed;
+  z-index: 190;
+  display: grid;
+  gap: 6px;
+  box-sizing: border-box;
+  width: 300px;
+  overflow: auto;
+  overscroll-behavior: contain;
+  max-width: min(300px, calc(100vw - 24px));
+  padding: 8px;
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  background: var(--bg-pane);
+  color: var(--text);
+  box-shadow: 0 4px 14px color-mix(in srgb, black 20%, transparent);
+  font: 14px var(--font-ui);
+}
+
+.rangeControls button {
+  min-height: 44px;
+  white-space: normal;
+  overflow-wrap: anywhere;
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  background: var(--bg-app);
+  color: var(--text);
+  font: inherit;
+  cursor: pointer;
+}
+
+.rangeControls button:focus-visible {
+  outline: 2px solid #9e2a2b;
+  outline-offset: 2px;
+}
+
+.rangeControls label {
+  display: grid;
+  gap: 4px;
+}
+
+.rangeControls input {
+  width: 100%;
+  accent-color: #9e2a2b;
+}
+
+.rangeControls input[type="checkbox"] {
+  width: 20px;
+  height: 20px;
+  grid-column: auto;
+}
+
+.lockToggle[aria-pressed="true"] { border-color: var(--accent); background: var(--accent); color: #fff; }
+
+/* The object menu: one row of the commands that apply, then More. */
+.strip { max-width: calc(100vw - 24px); }
+.stripRow { display: flex; flex-wrap: wrap; gap: 6px; }
+.stripRow button { flex: 1 1 auto; display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 4px 10px; }
diff --git a/packages/app/src/ui/canvas-panel/SelectionStrip.tsx b/packages/app/src/ui/canvas-panel/SelectionStrip.tsx
new file mode 100644
index 00000000..04bd269b
--- /dev/null
+++ b/packages/app/src/ui/canvas-panel/SelectionStrip.tsx
@@ -0,0 +1,67 @@
+import { RiLockLine, RiLockUnlockLine, type RemixiconComponentType } from "@remixicon/react";
+import { useRef, useState, type CSSProperties, type MouseEvent as ReactMouseEvent, type Ref } from "react";
+import type { AppMenuCommandId, AppMenuItem } from "../../app-menu";
+import type { CommandBindings, CommandOrigin } from "../editor-command-runtime";
+import { ContextMenuPopup, applicableContextItems } from "../CanvasContextMenu";
+import css from "./FreehandResultPopup.module.css";
+
+/**
+ * One command of the object menu, in the order the menu shows it: an action, a list of
+ * commands that opens below the menu (Align, Distribute, More), or the selection's lock.
+ */
+export type StripEntry =
+  | { kind: "action"; label: string; icon: RemixiconComponentType; run: () => void }
+  | { kind: "menu"; label: string; icon: RemixiconComponentType; items: readonly AppMenuItem[] }
+  | { kind: "lock"; locked: boolean; toggle: () => void };
+
+/**
+ * The object menu of a selection: only the commands that apply to it, then More for the
+ * secondary commands (contracts/surfaces.md, Object menu; research R14). A list without an
+ * applicable command is not shown.
+ */
+export function SelectionStrip({ entries, bindings, onCommandRun, measureRef, style }: {
+  entries: readonly StripEntry[];
+  bindings: CommandBindings;
+  onCommandRun: (commandId: AppMenuCommandId, origin: CommandOrigin) => void;
+  measureRef: Ref<HTMLDivElement>;
+  style: CSSProperties;
+}) {
+  const [openMenu, setOpenMenu] = useState<string | null>(null);
+  // The menu appears while the tap that made the selection is still down. That tap's click
+  // lands on whatever button is now under it, so a pointer click runs a command only after a
+  // press that began on the menu. A keyboard click (detail 0) has no press.
+  const pressed = useRef(false);
+  const press = <E extends ReactMouseEvent<HTMLButtonElement>>(run: (event: E) => void) => (event: E) => {
+    if (event.detail !== 0 && !pressed.current) return;
+    pressed.current = false;
+    run(event);
+  };
+  const shown = entries.filter((entry) => entry.kind !== "menu" || applicableContextItems(entry.items, bindings).length > 0);
+  const expanded = shown.find((entry): entry is Extract<StripEntry, { kind: "menu" }> => entry.kind === "menu" && entry.label === openMenu) ?? null;
+  return (
+    <div ref={measureRef} role="toolbar" aria-label="Selection" className={`${css.rangeControls} ${css.strip}`} style={style}
+      onPointerDown={(event) => { pressed.current = true; event.stopPropagation(); }}
+      onKeyDown={(event) => { if (event.key === "Escape" && expanded) { event.stopPropagation(); setOpenMenu(null); } }}>
+      <div className={css.stripRow}>
+        {shown.map((entry) => {
+          if (entry.kind === "lock") {
+            const Icon = entry.locked ? RiLockLine : RiLockUnlockLine;
+            return <button key="lock" type="button" className={css.lockToggle} aria-pressed={entry.locked} onClick={press(entry.toggle)}>
+              <Icon aria-hidden size={18} /><span>Lock</span>
+            </button>;
+          }
+          const Icon = entry.icon;
+          if (entry.kind === "menu") {
+            return <button key={entry.label} type="button" aria-haspopup="menu" aria-expanded={expanded?.label === entry.label}
+              onClick={press(() => { setOpenMenu(expanded?.label === entry.label ? null : entry.label); })}>
+              <Icon aria-hidden size={18} /><span>{entry.label}</span>
+            </button>;
+          }
+          return <button key={entry.label} type="button" onClick={press(entry.run)}><Icon aria-hidden size={18} /><span>{entry.label}</span></button>;
+        })}
+      </div>
+      {expanded ? <ContextMenuPopup items={expanded.items} path={expanded.label} bindings={bindings} origin="context-menu"
+        onCommandRun={(commandId, origin) => { setOpenMenu(null); onCommandRun(commandId, origin); }} /> : null}
+    </div>
+  );
+}
