new file mode 100644
index 00000000..b1cb7629
--- /dev/null
+++ b/packages/app/src/layers.ts
@@ -0,0 +1,13 @@
+import type { ScopeStatement, Statement } from "tikz-editor/ast/types";
+
+/** A layer is a top-level scope with a name; an unnamed top-level scope is a group. */
+export function layerName(statement: Statement, topLevel: boolean): string | null {
+  if (!topLevel || statement.kind !== "Scope") return null;
+  const entry = statement.options?.entries.find((candidate) => candidate.kind === "kv" && candidate.key.trim().toLowerCase() === "name");
+  return entry?.kind === "kv" && entry.valueRaw.trim().length > 0 ? entry.valueRaw.trim() : null;
+}
+
+/** The figure's layers, back to front. */
+export function layerScopes(statements: readonly Statement[] | undefined): ScopeStatement[] {
+  return (statements ?? []).filter((statement): statement is ScopeStatement => layerName(statement, true) !== null);
+}
