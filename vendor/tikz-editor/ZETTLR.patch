diff --git a/packages/app/src/ui/inspector-panel/GeometryConstructionControls.tsx b/packages/app/src/ui/inspector-panel/GeometryConstructionControls.tsx
new file mode 100644
index 00000000..3c97d2b1
--- /dev/null
+++ b/packages/app/src/ui/inspector-panel/GeometryConstructionControls.tsx
@@ -0,0 +1,104 @@
+import { useState } from "react";
+import { worldPoint, pt } from "tikz-editor/coords/index";
+import { resolveFigureCoordinateFrame } from "tikz-editor/edit/coordinate-frame";
+import { applyMatrix } from "tikz-editor/semantic/transform";
+import { snapArcEndpointToLattice, snapToUnitLattice } from "tikz-editor/edit/snapping";
+import { PT_PER_CM } from "tikz-editor/edit/format";
+import { useEditorStore } from "../../store/store";
+import { SidePanel } from "../SidePanel";
+import css from "./InspectorPanel.module.css";
+
+type CircleConstruction = "radius" | "diameter" | "three-points";
+const INITIAL_VALUES = { x: 0, y: 0, radius: 3, start: 0, end: 90, x2: 4, y2: 0, x3: 0, y3: 4 };
+type GeometryValues = typeof INITIAL_VALUES;
+
+/** Numeric alternatives to the canvas center/radius gestures. */
+export function GeometryConstructionControls({ arc }: { arc: boolean }) {
+  const source = useEditorStore((state) => state.source);
+  const activeFigureId = useEditorStore((state) => state.activeFigureId);
+  const dispatch = useEditorStore((state) => state.dispatch);
+  const strokeColor = useEditorStore((state) => state.creationStrokeColor);
+  const latticeLock = useEditorStore((state) => state.snapModes.latticeLock);
+  const fillColor = useEditorStore((state) => state.creationFillColor);
+  const [construction, setConstruction] = useState<CircleConstruction>("radius");
+  const [drafts, setDrafts] = useState<{ [Key in keyof GeometryValues]: string }>({
+    x: String(INITIAL_VALUES.x), y: String(INITIAL_VALUES.y), radius: String(INITIAL_VALUES.radius),
+    start: String(INITIAL_VALUES.start), end: String(INITIAL_VALUES.end), x2: String(INITIAL_VALUES.x2),
+    y2: String(INITIAL_VALUES.y2), x3: String(INITIAL_VALUES.x3), y3: String(INITIAL_VALUES.y3)
+  });
+  const [error, setError] = useState<string | null>(null);
+  const numberField = (key: keyof GeometryValues, label: string, unit = "units") => (
+    <label className={css.property} key={key}>
+      <span className={css.propertyLabel}>{label} ({unit})</span>
+      <input className={css.numberInput} type="text" inputMode="decimal" aria-label={label} value={drafts[key]}
+        onChange={(event) => { const value = event.currentTarget.value; setDrafts((previous) => ({ ...previous, [key]: value })); }} />
+    </label>
+  );
+  const insert = () => {
+    const values: GeometryValues = { x: Number(drafts.x), y: Number(drafts.y), radius: Number(drafts.radius), start: Number(drafts.start), end: Number(drafts.end), x2: Number(drafts.x2), y2: Number(drafts.y2), x3: Number(drafts.x3), y3: Number(drafts.y3) };
+    const required: Array<keyof GeometryValues> = arc ? ["x", "y", "radius", "start", "end"] : construction === "radius" ? ["x", "y", "radius"] : construction === "diameter" ? ["x", "y", "x2", "y2"] : ["x", "y", "x2", "y2", "x3", "y3"];
+    if (required.some((key) => !drafts[key].trim() || !Number.isFinite(values[key]))) { setError("Complete each field with a finite number before inserting geometry."); return; }
+    let { x, y, radius } = values;
+    if (!arc && construction === "diameter") {
+      x = (values.x + values.x2) / 2;
+      y = (values.y + values.y2) / 2;
+      radius = Math.hypot(values.x2 - values.x, values.y2 - values.y) / 2;
+    } else if (!arc && construction === "three-points") {
+      const dx = values.x2 - values.x, dy = values.y2 - values.y;
+      const ex = values.x3 - values.x, ey = values.y3 - values.y;
+      const determinant = 2 * (dx * ey - dy * ex);
+      if (Math.abs(determinant) < 1e-10) { setError("Choose three distinct points that are not on one line."); return; }
+      const d2 = dx * dx + dy * dy, e2 = ex * ex + ey * ey;
+      x = values.x + (ey * d2 - dy * e2) / determinant;
+      y = values.y + (dx * e2 - ex * d2) / determinant;
+      radius = Math.hypot(x - values.x, y - values.y);
+    }
+    if (!(radius > 0) || !Number.isFinite(radius)) { setError("Radius must be positive."); return; }
+    let at = worldPoint(pt(x * PT_PER_CM), pt(y * PT_PER_CM));
+    const onCircle = (angle: number) => worldPoint(pt((x + radius * Math.cos(angle * Math.PI / 180)) * PT_PER_CM), pt((y + radius * Math.sin(angle * Math.PI / 180)) * PT_PER_CM));
+    let start = onCircle(values.start), end = onCircle(values.end);
+    let startAngle = values.start, endAngle = values.end;
+    if (latticeLock) {
+      if (!arc && construction !== "radius" && (Math.abs(x - Math.round(x)) > 1e-7 || Math.abs(y - Math.round(y)) > 1e-7)) {
+        setError("This construction has a fractional center. Disable lattice lock or choose points with an integer center."); return;
+      }
+      at = snapToUnitLattice(at);
+      x = at.x / PT_PER_CM; y = at.y / PT_PER_CM;
+      if (!arc && construction !== "radius") {
+        const points = construction === "three-points" ? [values.x, values.y, values.x2, values.y2, values.x3, values.y3] : [values.x, values.y, values.x2, values.y2];
+        if (points.some((value) => Math.abs(value - Math.round(value)) > 1e-7)) { setError("Enter lattice points or disable lattice lock to preserve fractional coordinates."); return; }
+      } else radius = Math.max(1, Math.round(radius));
+      const east = onCircle(0);
+      if (arc) {
+        const snappedStart = snapArcEndpointToLattice(at, east, onCircle(values.start));
+        const snappedEnd = snapArcEndpointToLattice(at, east, onCircle(values.end));
+        if (snappedStart.kind === "unavailable" || snappedEnd.kind === "unavailable") { setError("No exact lattice endpoint is available for this radius."); return; }
+        start = snappedStart.point; end = snappedEnd.point;
+        const angleOf = (point: typeof at, requested: number) => { const angle = Math.atan2(point.y - at.y, point.x - at.x) * 180 / Math.PI; return angle + 360 * Math.round((requested - angle) / 360); };
+        startAngle = angleOf(start, values.start); endAngle = angleOf(end, values.end);
+      }
+    }
+    const circleEdge = !arc && construction !== "radius" ? worldPoint(pt(values.x * PT_PER_CM), pt(values.y * PT_PER_CM)) : onCircle(0);
+    const frame = resolveFigureCoordinateFrame(source, { activeFigureId });
+    dispatch({ type: "APPLY_EDIT_ACTION", action: { kind: "addElement", at: applyMatrix(frame, at),
+      template: arc ? { kind: "arc", start: applyMatrix(frame, start), end: applyMatrix(frame, end), startAngle, endAngle, strokeColor } : { kind: "circle", edge: applyMatrix(frame, circleEdge), strokeColor, fillColor }
+    } });
+    setError(null);
+  };
+  return <SidePanel.Section>
+    <SidePanel.SectionHeader>{arc ? "Arc construction" : "Circle construction"}</SidePanel.SectionHeader>
+    <SidePanel.SectionBody>
+      {!arc && <label className={css.property}><span className={css.propertyLabel}>Construction</span><select className={css.numberInput} value={construction} onChange={(event) => { const value = event.currentTarget.value; if (value === "radius" || value === "diameter" || value === "three-points") setConstruction(value); }}>
+        <option value="radius">Center and radius</option><option value="diameter">Two diameter endpoints</option><option value="three-points">Through three points</option>
+      </select></label>}
+      {numberField("x", construction === "radius" || arc ? "Center X" : "Point 1 X")}
+      {numberField("y", construction === "radius" || arc ? "Center Y" : "Point 1 Y")}
+      {arc || construction === "radius" ? numberField("radius", "Radius") : <>{numberField("x2", "Point 2 X")}{numberField("y2", "Point 2 Y")}</>}
+      {!arc && construction === "three-points" && <>{numberField("x3", "Point 3 X")}{numberField("y3", "Point 3 Y")}</>}
+      {arc && <>{numberField("start", "Start angle", "degrees")}{numberField("end", "End angle", "degrees")}</>}
+      {latticeLock && <p className={css.hint}>Lattice lock keeps centers and defining points on integer coordinates; arc angles choose exact lattice points on the fixed circle.</p>}
+      <button type="button" onClick={insert}>Insert {arc ? "arc" : "circle"}</button>
+      {error && <p role="alert">{error}</p>}
+    </SidePanel.SectionBody>
+  </SidePanel.Section>;
+}
