+export function sampleSelectedCurvePath(path: ScenePath, zoom: number): FreehandToolDraft | null {
+  if (path.transform || !path.commands.some((command) => command.kind === "C")) return null;
+  const points: WorldPoint[] = [];
+  let current: WorldPoint | null = null;
+  for (const command of path.commands) {
+    if (command.kind === "M") {
+      if (points.length > 0) return null;
+      current = command.to;
+      points.push(command.to);
+    } else if (command.kind === "L" && current) {
+      const count = Math.min(64, Math.max(2, Math.ceil(Math.sqrt(distanceSquared(current, command.to)) * zoom / 8)));
+      for (let i = 1; i <= count; i += 1) {
+        const t = i / count;
+        points.push(worldPoint(pt(current.x + (command.to.x - current.x) * t), pt(current.y + (command.to.y - current.y) * t)));
+      }
+      current = command.to;
+    } else if (command.kind === "C" && current) {
+      const netLength = Math.sqrt(distanceSquared(current, command.c1)) +
+        Math.sqrt(distanceSquared(command.c1, command.c2)) +
+        Math.sqrt(distanceSquared(command.c2, command.to));
+      const count = Math.min(64, Math.max(4, Math.ceil(netLength * zoom / 8)));
+      for (let i = 1; i <= count; i += 1) {
+        const t = i / count;
+        const u = 1 - t;
+        points.push(worldPoint(
+          pt(u * u * u * current.x + 3 * u * u * t * command.c1.x + 3 * u * t * t * command.c2.x + t * t * t * command.to.x),
+          pt(u * u * u * current.y + 3 * u * u * t * command.c1.y + 3 * u * t * t * command.c2.y + t * t * t * command.to.y)
+        ));
+      }
+      current = command.to;
+    } else {
+      return null;
+    }
+  }
+  return points.length >= FREEHAND_MIN_POINTS
+    ? { points, minSampleDistanceWorld: FREEHAND_LIVE_POINT_SPACING_PX / Math.max(zoom, 1e-3) }
+    : null;
+}
