+describe('the eraser cuts a path that is not explicit lines and curves', () => {
+  const figure = (body: string) => `\\begin{tikzpicture}\n${body}\n\\end{tikzpicture}`;
+  const evaluate = (source: string) => evaluateTikzFigure(parseTikz(source, { recover: true, includeContextDefinitions: true }).figure, source);
+  /** The source after one straight sweep, in centimetres of the figure, across statement `path:0`. */
+  const sweep = (source: string, from: [number, number], to: [number, number], radius: number) => {
+    const scene = evaluate(source);
+    const path = cuttablePath(source, 'path:0', scene.editHandles, {}, scene.scene.elements);
+    if (!path) return null;
+    const pieces = remainingStatements(path, sweepCapsule(wp(cm(from[0]), cm(from[1])), wp(cm(to[0]), cm(to[1])), cm(radius)), cm(radius) / 20);
+    return pieces && source.slice(0, path.span.from) + pieces.join('\n') + source.slice(path.span.to);
+  };
+  /** The two ends of every drawn subpath of `source`, in centimetres. */
+  const ends = (source: string) => evaluate(source).scene.elements.flatMap((element) => element.kind === 'Path' ? splitPathIntoSubpaths(element.commands) : []).flatMap((commands) => {
+    const points = commands.flatMap((command) => command.kind === 'Z' ? [] : [command.to]);
+    return [points[0]!, points[points.length - 1]!].map((point) => [point.x / cm(1), point.y / cm(1)] as [number, number]);
+  });
+  const drawnLength = (source: string) => evaluate(source).scene.elements.reduce((sum, element) => sum + (element.kind === 'Path' ? totalSegmentLength(commandsToSegments(element.commands)) : 0), 0) / cm(1);
+  const distanceToSegment = ([x, y]: [number, number], [ax, ay]: [number, number], [bx, by]: [number, number]) => {
+    const t = Math.min(1, Math.max(0, ((x - ax) * (bx - ax) + (y - ay) * (by - ay)) / ((bx - ax) ** 2 + (by - ay) ** 2)));
+    return Math.hypot(x - ax - t * (bx - ax), y - ay - t * (by - ay));
+  };
+
+  it('leaves a rotated ellipse as one arc of the same ellipse that ends at the edge of the sweep', () => {
+    const along = [Math.cos(Math.PI / 6), Math.sin(Math.PI / 6)] as const;
+    const from: [number, number] = [2.5 * along[0], 2.5 * along[1]], to: [number, number] = [3.5 * along[0], 3.5 * along[1]];
+    const result = sweep(figure('\\draw[rotate=30] (0,0) ellipse (3 and 1.5);'), from, to, 0.2)!;
+    expect(result).toMatch(/^\\begin\{tikzpicture\}\n\\draw\[rotate=30\] \([^)]*\) arc\[start angle=[-\d.]+, end angle=[-\d.]+, x radius=3, y radius=1\.5\];\n\\end\{tikzpicture\}$/);
+    const cutEnds = ends(result);
+    expect(cutEnds).toHaveLength(2);
+    for (const end of cutEnds) {
+      const local = [end[0] * along[0] + end[1] * along[1], -end[0] * along[1] + end[1] * along[0]];
+      expect((local[0]! / 3) ** 2 + (local[1]! / 1.5) ** 2).toBeCloseTo(1, 2);
+      expect(distanceToSegment(end, from, to)).toBeCloseTo(0.2, 2);
+    }
+    expect(Math.hypot(cutEnds[0]![0] - cutEnds[1]![0], cutEnds[0]![1] - cutEnds[1]![1])).toBeCloseTo(0.4, 1);
+  });
+
+  it('keeps a grid one statement and removes only the swept length of one line', () => {
+    const source = figure('\\draw[gray] (0,0) grid (2,2);');
+    expect(drawnLength(source)).toBeCloseTo(12, 6);
+    const result = sweep(source, [0.5, 0.9], [0.5, 1.1], 0.1)!;
+    expect(result.match(/\\draw\[gray\]/g)).toHaveLength(1);
+    expect(drawnLength(result)).toBeCloseTo(11.8, 3);
+    const cutEnds = ends(result).filter((end) => Math.abs(end[1] - 1) < 1e-3 && end[0] > 0.01 && end[0] < 0.99).map((end) => end[0]).sort();
+    expect(cutEnds[0]).toBeCloseTo(0.4, 3);
+    expect(cutEnds[1]).toBeCloseTo(0.6, 3);
+  });
+
+  it('cuts a bent `to` path into two curves that keep its ends', () => {
+    const result = sweep(figure('\\draw[->] (0,0) to[bend left] (4,0);'), [2, -2], [2, 2], 0.2)!;
+    expect(result.match(/\\draw\[->\]/g)).toHaveLength(2);
+    const points = ends(result);
+    expect(points).toHaveLength(4);
+    expect(points.filter((point) => Math.hypot(point[0], point[1]) < 1e-3 || Math.hypot(point[0] - 4, point[1]) < 1e-3)).toHaveLength(2);
+    expect(points.filter((point) => Math.abs(Math.abs(point[0] - 2) - 0.2) < 2e-3)).toHaveLength(2);
+  });
+
+  it('does not cut a path whose pieces it cannot write', () => {
+    expect(sweep(figure('\\draw (0,0) -- node[above] {a} (4,0);'), [2, -1], [2, 1], 0.2)).toBeNull();
+    expect(sweep(figure('\\draw plot coordinates {(0,0) (2,1) (4,0)};'), [2, 0], [2, 2], 0.2)).toBeNull();
+  });
+});
