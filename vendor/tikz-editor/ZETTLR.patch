+    expect(boundsInLatticeUnits(bounds, worldTransform(0, 1, -1, 0, 0, 0))).toEqual({ x: 1, y: 2, width: 3, height: 4 });
+    expect(boundsInLatticeUnits(bounds, worldTransform(0, 0, 0, 1, 0, 0))).toBeNull();
+  });
+});
