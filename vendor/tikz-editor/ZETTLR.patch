new file mode 100644
index 00000000..6fbb3f26
--- /dev/null
+++ b/packages/app/src/ui/ExactRange.tsx
@@ -0,0 +1,31 @@
+import { useState } from "react";
+import { formatNumber } from "tikz-editor/edit/format";
+
+import css from "./ExactRange.module.css";
+
+type ExactRangeProps = { label: string; unit: string; min: number; max: number; step: number; value: number; onChange: (value: number) => void };
+
+/**
+ * A slider with an exact-value field beside it, the pairing Apple's Human Interface Guidelines (Sliders)
+ * recommend when a precise value matters.
+ * The field commits on Enter or when it loses focus, clamped to the slider's range.
+ */
+export function ExactRange({ label, unit, min, max, step, value, onChange }: ExactRangeProps) {
+  const [draft, setDraft] = useState<string | null>(null);
+  const commit = () => {
+    const next = Number(draft);
+    if (draft !== null && draft.trim() !== "" && Number.isFinite(next)) onChange(Math.min(max, Math.max(min, next)));
+    setDraft(null);
+  };
+  return (
+    <div className={css.field}>
+      <span>{label}</span>
+      <input className={css.value} type="number" inputMode="decimal" aria-label={`${label} value`} min={min} max={max} step={step}
+        value={draft ?? formatNumber(value)} onChange={(event) => setDraft(event.currentTarget.value)} onBlur={commit}
+        onKeyDown={(event) => { if (event.key === "Enter") commit(); }} />
+      <span className={css.unit}>{unit}</span>
+      <input className={css.range} type="range" aria-label={label} min={min} max={max} step={step} value={value}
+        onChange={(event) => onChange(Number(event.currentTarget.value))} />
+    </div>
+  );
+}
diff --git a/packages/app/src/ui/KeyboardShortcutsSettings.tsx b/packages/app/src/ui/KeyboardShortcutsSettings.tsx
new file mode 100644
index 00000000..2e96fde9
--- /dev/null
+++ b/packages/app/src/ui/KeyboardShortcutsSettings.tsx
@@ -0,0 +1,71 @@
+import { useEffect, useState } from "react";
+import type { AppMenuCommandId } from "../app-menu";
+import { getActiveEditorPlatform } from "../platform/current";
+import { SHORTCUT_COMMANDS, recordShortcut, shortcutConflict, shortcutLabel, shortcutsFor } from "../settings/keybindings";
+import { useSettingsStore } from "../settings/useSettingsStore";
+import css from "./SettingsModal.module.css";
+
+export function KeyboardShortcutsSettings() {
+  const overrides = useSettingsStore(state => state.settings.keybindings);
+  const setCommandShortcuts = useSettingsStore(state => state.setCommandShortcuts);
+  const resetKeybindings = useSettingsStore(state => state.resetKeybindings);
+  const [query, setQuery] = useState("");
+  const [recording, setRecording] = useState<AppMenuCommandId | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const embedded = getActiveEditorPlatform().id === "zettlr-embed";
+  useEffect(() => {
+    if (!recording) return;
+    const onKeyDown = (event: KeyboardEvent) => {
+      event.preventDefault();
+      event.stopImmediatePropagation();
+      if (event.key === "Escape") { setRecording(null); setError(null); return; }
+      const shortcut = recordShortcut(event);
+      if (!shortcut) return;
+      const conflict = shortcutConflict(recording, shortcut, overrides, embedded);
+      if (conflict) {
+        setError(embedded && !conflict.embedded
+          ? `${shortcutLabel(shortcut)} is reserved for ${conflict.label}. Choose different keys.`
+          : `${shortcutLabel(shortcut)} is already assigned to ${conflict.label}. Clear or change that shortcut first.`);
+        return;
+      }
+      setCommandShortcuts(recording, [shortcut]);
+      setRecording(null);
+      setError(null);
+    };
+    window.addEventListener("keydown", onKeyDown, true);
+    return () => window.removeEventListener("keydown", onKeyDown, true);
+  }, [embedded, overrides, recording, setCommandShortcuts]);
+  const commands = SHORTCUT_COMMANDS.filter(command => (!embedded || command.embedded) && command.label.toLowerCase().includes(query.toLowerCase()));
+  return <div className={css.panel}>
+    <div className={css.panelTitle}>Keyboard shortcuts</div>
+    <p>Choose a command, then press its new keys. Escape cancels recording. Touch controls remain available.</p>
+    <label htmlFor="shortcut-search">Find command</label>
+    <input id="shortcut-search" type="search" value={query} onChange={event => setQuery(event.currentTarget.value)} />
+    {error ? <div role="alert">{error}</div> : null}
+    {commands.map(command => <div key={command.id} role="group" aria-label={`${command.label} shortcut`} className={css.shortcutRow}>
+      <strong>{command.label}</strong>
+      <span>{shortcutsFor(command.id, overrides).map(shortcutLabel).join(" or ") || "Unassigned"}</span>
+      <div className={css.shortcutActions}>
+        <button type="button" aria-label={`Set shortcut for ${command.label}`} aria-pressed={recording === command.id}
+          onClick={() => { setError(null); setRecording(command.id); }}>{recording === command.id ? "Press keys…" : "Set keys"}</button>
+        <button type="button" aria-label={`Clear shortcut for ${command.label}`} disabled={shortcutsFor(command.id, overrides).length === 0}
+          onClick={() => { setRecording(null); setError(null); setCommandShortcuts(command.id, []); }}>Clear</button>
+        <button type="button" aria-label={`Reset shortcut for ${command.label}`} disabled={overrides[command.id] === undefined}
+          onClick={() => {
+            const conflict = command.defaults.map(shortcut => shortcutConflict(command.id, shortcut, overrides, embedded)).find(entry => entry !== undefined);
+            if (conflict) {
+              setError(embedded && !conflict.embedded
+                ? `The default shortcut is reserved for ${conflict.label}. Choose different keys.`
+                : `The default shortcut is assigned to ${conflict.label}. Clear or change that shortcut first.`);
+              return;
+            }
+            setRecording(null); setError(null); setCommandShortcuts(command.id, undefined);
+          }}>Reset</button>
+      </div>
+    </div>)}
+    {commands.length === 0 ? <p>No matching commands.</p> : null}
+    <div className={css.resetRow}><button type="button" className={css.resetButton} onClick={() => {
+      setRecording(null); setError(null); resetKeybindings();
+    }}>Reset all shortcuts</button></div>
+  </div>;
+}
