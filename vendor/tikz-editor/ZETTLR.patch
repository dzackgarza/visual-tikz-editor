+import { useEffect, useLayoutEffect, useRef, useState, type PointerEvent as ReactPointerEvent } from "react";
+import type { AppMenuCommandId } from "../app-menu";
+import { getActiveEditorPlatform } from "../platform/current";
+import {
+  SHORTCUT_COMMANDS, assignShortcuts, isShortcutCommandInScope, recordShortcut, sameShortcut, shortcutConflict,
+  shortcutLabel, shortcutsFor, type ShortcutCommand
+} from "../settings/keybindings";
+import { useSettingsStore } from "../settings/useSettingsStore";
+import { clampContextMenuAnchor, type ContextMenuAnchor } from "./canvas-panel/context-menu-target";
+import menuCss from "./CanvasContextMenu.module.css";
+import css from "./SettingsModal.module.css";
+
+// The canvas opens its context menu after the same hold (CanvasPanel).
+const LONG_PRESS_MS = 550;
+
+type PendingMove = { shortcut: string; from: ShortcutCommand };
+type RowMenu = { id: AppMenuCommandId; anchor: ContextMenuAnchor };
+
+/**
+ * The shortcut list follows VS Code's keybindings editor: one row per command, a
+ * press on the row records, the row menu removes or resets, and the search field
+ * finds a command by name or, with Record keys on, by the keys pressed.
+ */
+export function KeyboardShortcutsSettings() {
+  const overrides = useSettingsStore(state => state.settings.keybindings);
+  const setKeybindings = useSettingsStore(state => state.setKeybindings);
+  const resetKeybindings = useSettingsStore(state => state.resetKeybindings);
+  const [query, setQuery] = useState("");
+  const [searchKeys, setSearchKeys] = useState<string | null>(null);
+  const [recordingSearch, setRecordingSearch] = useState(false);
+  const [recording, setRecording] = useState<AppMenuCommandId | null>(null);
+  const [pending, setPending] = useState<PendingMove | null>(null);
+  const [menu, setMenu] = useState<RowMenu | null>(null);
+  const searchRef = useRef<HTMLInputElement | null>(null);
+  const holdRef = useRef<{ timer: number; opened: boolean } | null>(null);
+  const embedded = getActiveEditorPlatform().id === "zettlr-embed";
+  const assign = (id: AppMenuCommandId, shortcuts: readonly string[] | undefined) =>
+    setKeybindings(assignShortcuts(id, shortcuts, overrides, embedded));
+  const stopRecording = () => { setRecording(null); setPending(null); };
+
+  useEffect(() => {
+    if (!recording) return;
+    const onKeyDown = (event: KeyboardEvent) => {
+      event.preventDefault();
+      event.stopImmediatePropagation();
+      if (event.key === "Escape") { stopRecording(); return; }
+      if (event.key === "Enter" && pending) {
+        assign(recording, [pending.shortcut]);
+        stopRecording();
+        return;
+      }
+      const shortcut = recordShortcut(event);
+      if (!shortcut) return;
+      const from = shortcutConflict(recording, shortcut, overrides, embedded);
+      if (from) { setPending({ shortcut, from }); return; }
+      assign(recording, [shortcut]);
+      stopRecording();
+    };
+    window.addEventListener("keydown", onKeyDown, true);
+    return () => window.removeEventListener("keydown", onKeyDown, true);
+  });
+
+  useEffect(() => {
+    if (!recordingSearch) return;
+    const onKeyDown = (event: KeyboardEvent) => {
+      event.preventDefault();
+      event.stopImmediatePropagation();
+      if (event.key === "Escape") { setRecordingSearch(false); return; }
+      const shortcut = recordShortcut(event);
+      if (!shortcut) return;
+      setSearchKeys(shortcut);
+      setQuery(shortcutLabel(shortcut));
+    };
+    window.addEventListener("keydown", onKeyDown, true);
+    return () => window.removeEventListener("keydown", onKeyDown, true);
+  }, [recordingSearch]);
+
+  const name = query.trim().toLowerCase();
+  const commands = SHORTCUT_COMMANDS.filter(command => {
+    if (!isShortcutCommandInScope(command, embedded)) return false;
+    const shortcuts = shortcutsFor(command.id, overrides);
+    if (searchKeys) return shortcuts.some(shortcut => sameShortcut(shortcut, searchKeys));
+    return command.label.toLowerCase().includes(name) ||
+      shortcuts.some(shortcut => shortcutLabel(shortcut).toLowerCase().includes(name));
+  });
+  const keysShown = (command: ShortcutCommand): string[] => {
+    if (recording !== command.id) return shortcutsFor(command.id, overrides).map(shortcutLabel);
+    return [pending ? shortcutLabel(pending.shortcut) : "Press the new shortcut"];
+  };
+  const openMenu = (id: AppMenuCommandId, anchor: ContextMenuAnchor) => { stopRecording(); setMenu({ id, anchor }); };
+  const startHold = (event: ReactPointerEvent<HTMLButtonElement>, id: AppMenuCommandId) => {
+    holdRef.current = null;
+    if (event.pointerType === "mouse") return;
+    const anchor = { x: event.clientX, y: event.clientY };
+    const hold = { opened: false, timer: window.setTimeout(() => { hold.opened = true; openMenu(id, anchor); }, LONG_PRESS_MS) };
+    holdRef.current = hold;
+  };
+  const endHold = () => { if (holdRef.current) window.clearTimeout(holdRef.current.timer); };
+
+  return <div className={css.panel}>
+    <div className={css.panelTitle}>Keyboard shortcuts</div>
+    <label htmlFor="shortcut-search">Find command</label>
+    <div className={css.shortcutSearch}>
+      <input id="shortcut-search" ref={searchRef} type="search" value={query}
+        onChange={event => { setSearchKeys(null); setQuery(event.currentTarget.value); }} />
+      <button type="button" aria-pressed={recordingSearch} onClick={() => {
+        setRecordingSearch(!recordingSearch);
+        searchRef.current?.focus();
+      }}>Record keys</button>
+    </div>
+    {pending ? <div role="alert">
+      {`${shortcutLabel(pending.shortcut)} is used by ${pending.from.label}. It will be removed from there.`}
+    </div> : null}
+    <ul aria-label="Commands" className={css.shortcutList}>
+      {commands.map(command => <li key={command.id}>
+        <button type="button" className={css.shortcutRow} aria-pressed={recording === command.id}
+          onClick={() => {
+            if (holdRef.current?.opened) { holdRef.current = null; return; }
+            setPending(null);
+            setRecording(command.id);
+          }}
+          onContextMenu={event => { event.preventDefault(); endHold(); openMenu(command.id, { x: event.clientX, y: event.clientY }); }}
+          onPointerDown={event => startHold(event, command.id)}
+          onPointerUp={endHold} onPointerCancel={endHold} onPointerLeave={endHold}>
+          <span>{command.label}</span>
+          <span className={css.shortcutKeys}>{keysShown(command).map(keys => <kbd key={keys}>{keys}</kbd>)}</span>
+        </button>
+      </li>)}
+    </ul>
+    {commands.length === 0 ? <p>No matching commands.</p> : null}
+    {menu ? <ShortcutRowMenu anchor={menu.anchor}
+      canRemove={shortcutsFor(menu.id, overrides).length > 0}
+      changed={overrides[menu.id] !== undefined}
+      onRemove={() => assign(menu.id, [])}
+      onReset={() => assign(menu.id, undefined)}
+      onClose={() => setMenu(null)} /> : null}
+    <div className={css.resetRow}><button type="button" className={css.resetButton} onClick={() => {
+      stopRecording(); resetKeybindings();
+    }}>Reset all shortcuts</button></div>
+  </div>;
+}
+
+function ShortcutRowMenu({ anchor, canRemove, changed, onRemove, onReset, onClose }: {
+  anchor: ContextMenuAnchor;
+  canRemove: boolean;
+  changed: boolean;
+  onRemove: () => void;
+  onReset: () => void;
+  onClose: () => void;
+}) {
+  const rootRef = useRef<HTMLDivElement | null>(null);
+  const [position, setPosition] = useState(anchor);
+  useLayoutEffect(() => {
+    const root = rootRef.current;
+    if (!root) return;
+    setPosition(clampContextMenuAnchor(anchor, { width: root.offsetWidth, height: root.offsetHeight },
+      { width: window.innerWidth, height: window.innerHeight }));
+  }, [anchor]);
+  useEffect(() => {
+    const onPointerDown = (event: PointerEvent) => {
+      if (!rootRef.current?.contains(event.target as Node)) onClose();
+    };
+    const onKeyDown = (event: KeyboardEvent) => {
+      if (event.key !== "Escape") return;
+      // Escape closes the menu, not the Settings dialog around it.
+      event.preventDefault();
+      event.stopImmediatePropagation();
+      onClose();
+    };
+    window.addEventListener("pointerdown", onPointerDown, true);
