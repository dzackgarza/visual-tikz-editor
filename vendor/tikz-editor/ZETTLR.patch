@@ -0,0 +1,92 @@
+import type { OptionEntry, OptionListAst } from "../../options/types.js";
+import { parseOptionListRaw } from "../../options/parse.js";
+import { walkStatements } from "../../ast/walk.js";
+import { NON_STYLE_OPTION_FLAGS, NON_STYLE_OPTION_KEYS } from "../../semantic/style/constants.js";
+import { normalizeCustomStyleName, parseCustomStyleDefinition } from "../../semantic/style/custom-styles.js";
+import { collectContextDefinitions } from "../../transform/cst-to-ast.js";
+import { applyOptionMutationsToTarget, normalizeOptionKey, type OptionMutation } from "../option-mutations.js";
+import { parseTikzForEdit, type EditParseOptions } from "../parse-options.js";
+import { resolvePropertyTarget, TIKZPICTURE_GLOBAL_TARGET_ID } from "../property-target.js";
+import type { EditActionResultLike } from "../result-types.js";
+
+export type NamedStyleAction =
+  | { kind: "saveNamedStyle"; elementId: string; name: string }
+  | { kind: "applyNamedStyle"; elementId: string; name: string };
+
+const TRANSFORM_OPTION_KEYS = new Set([
+  "rotate", "rotate around", "scale", "scale around", "xscale", "yscale",
+  "shift", "xshift", "yshift", "cm", "transform canvas", "xslant", "yslant"
+]);
+
+export function collectNamedStyleNames(source: string, parseOptions: EditParseOptions = {}): string[] {
+  const parsed = parseTikzForEdit(source, parseOptions);
+  const names = new Set<string>();
+  const collectOptions = (options: OptionListAst | undefined) => {
+    for (const entry of options?.entries ?? []) {
+      if (entry.kind !== "kv") continue;
+      const definition = parseCustomStyleDefinition(entry.key);
+      if (definition) names.add(definition.name);
+    }
+  };
+  collectOptions(parsed.figure.options);
+  const statements = [
+    ...collectContextDefinitions(source.slice(0, parsed.figure.span.from)),
+    ...parsed.figure.body
+  ];
+  walkStatements(statements, { onStatement: (statement) => {
+    if (statement.kind === "TikzStyle") {
+      names.add(normalizeCustomStyleName(statement.styleNameRaw));
+    } else if (statement.kind === "TikzSet" || statement.kind === "Pgfkeys") {
+      collectOptions(statement.optionList);
+    }
+  } });
+  return [...names].filter(Boolean).sort((left, right) => left.localeCompare(right));
+}
+
+export function applyNamedStyleAction(source: string, action: NamedStyleAction, parseOptions: EditParseOptions = {}): EditActionResultLike {
+  const name = normalizeCustomStyleName(action.name);
+  const parsedName = parseOptionListRaw(`[${name}/.style={draw}]`).entries;
+  if (parsedName.length !== 1 || parsedName[0]?.kind !== "kv" || parseCustomStyleDefinition(parsedName[0].key)?.name !== name) {
+    return { kind: "unsupported", reason: "Enter one TikZ style name without option separators." };
+  }
+  const existing = collectNamedStyleNames(source, parseOptions);
+  if (action.kind === "saveNamedStyle" && existing.includes(name)) {
+    return { kind: "unsupported", reason: `The style ${name} already exists.` };
+  }
+  if (action.kind === "applyNamedStyle" && !existing.includes(name)) {
+    return { kind: "unsupported", reason: `The style ${name} is not defined in this figure.` };
+  }
+  const resolved = resolvePropertyTarget(source, action.elementId, parseOptions);
+  if (resolved.kind === "not-found") return { kind: "unsupported", reason: resolved.reason };
+  if (resolved.target.kind !== "path-statement" && resolved.target.kind !== "node-item") {
+    return { kind: "unsupported", reason: "This object has no command appearance options." };
+  }
+  const appearance = (resolved.target.options?.entries ?? []).filter(isAppearanceOption);
+  if (action.kind === "saveNamedStyle" && appearance.length === 0) {
+    return { kind: "unsupported", reason: "This object has no appearance options to save." };
+  }
+  const mutations = new Map<string, OptionMutation>();
+  for (const entry of appearance) {
+    mutations.set(normalizeOptionKey(entry.key), { kind: "remove" });
+  }
+  mutations.set(name, { kind: "set", value: "" });
+  const styled = applyOptionMutationsToTarget(source, resolved.target, mutations);
+  if (!styled) return { kind: "unsupported", reason: "The selected object already uses this style." };
+  if (action.kind === "applyNamedStyle") {
+    return { kind: "success", newSource: styled.source, patches: [styled.patch], changedSourceIds: [action.elementId] };
+  }
+  const figure = resolvePropertyTarget(styled.source, TIKZPICTURE_GLOBAL_TARGET_ID, parseOptions);
+  if (figure.kind === "not-found") return { kind: "unsupported", reason: figure.reason };
+  const definition = appearance.map((entry) => entry.raw.trim()).join(", ");
+  const declared = applyOptionMutationsToTarget(styled.source, figure.target,
+    new Map([[`${name}/.style`, { kind: "set", value: `{${definition}}` }]]));
+  if (!declared) return { kind: "error", message: `Could not write the style ${name}.` };
+  return { kind: "success", newSource: declared.source, patches: [], changedSourceIds: [action.elementId] };
+}
+
+function isAppearanceOption(entry: OptionEntry): entry is Extract<OptionEntry, { kind: "kv" | "flag" }> {
+  if (entry.kind === "unknown") return false;
+  const key = normalizeOptionKey(entry.key);
+  if (TRANSFORM_OPTION_KEYS.has(key.replace(/^\/tikz\//, ""))) return false;
+  return entry.kind === "kv" ? !NON_STYLE_OPTION_KEYS.has(key) : !NON_STYLE_OPTION_FLAGS.has(key);
+}
