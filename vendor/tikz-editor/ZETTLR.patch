+
+function readConstruction(): Construction | null {
+  return canvasSession.getSnapshot().context.construction;
+}
+
+function sendDraft(kind: Construction["kind"], construction: Construction | null): void {
+  canvasSession.send(construction ? { type: "construction.set", construction } : { type: "construction.clear", kind });
