@@ -0,0 +1,111 @@
+import paper from "paper";
+type Point = { x: number; y: number };
+export type EraserStroke = { sourceId: string; strokeRadius: number; segments: Array<readonly [Point, Point]> };
+
+function distanceToSegment(point: Point, start: Point, end: Point): number {
+  const dx = end.x - start.x;
+  const dy = end.y - start.y;
+  const length = dx * dx + dy * dy;
+  const t = length === 0 ? 0 : Math.max(0, Math.min(1, ((point.x - start.x) * dx + (point.y - start.y) * dy) / length));
+  return Math.hypot(point.x - start.x - t * dx, point.y - start.y - t * dy);
+}
+function cross(a: Point, b: Point, c: Point): number {
+  return (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x);
+}
+export function sweptStrokeIds(strokes: readonly EraserStroke[], from: Point, to: Point, radius: number): string[] {
+  return strokes.filter((stroke) => stroke.segments.some(([a, b]) => {
+    const c1 = cross(from, to, a), c2 = cross(from, to, b), c3 = cross(a, b, from), c4 = cross(a, b, to);
+    const crossing = c1 * c2 < 0 && c3 * c4 < 0;
+    return crossing || Math.min(distanceToSegment(a, from, to), distanceToSegment(b, from, to),
+      distanceToSegment(from, a, b), distanceToSegment(to, a, b)) <= radius + stroke.strokeRadius;
+  })).map((stroke) => stroke.sourceId);
+}
+
+function visibleGeometry(path: SVGGeometryElement): boolean {
+  for (let element: Element | null = path; element; element = element.parentElement) {
+    const style = getComputedStyle(element);
+    if (style.display === "none" || style.visibility === "hidden" || Number.parseFloat(style.opacity) === 0) return false;
+  }
+  const style = getComputedStyle(path);
+  const hasStroke = style.stroke !== "none" && Number.parseFloat(style.strokeOpacity) !== 0;
+  const hasFill = style.fill !== "none" && Number.parseFloat(style.fillOpacity) !== 0;
+  return hasStroke || hasFill;
+}
+
+function clipRegions(path: SVGGeometryElement, scope: paper.PaperScope): paper.PathItem[][] | null {
+  const regions: paper.PathItem[][] = [];
+  for (let element: Element | null = path; element instanceof SVGElement; element = element.parentElement) {
+    const clip = getComputedStyle(element).clipPath;
+    if (clip === "none") continue;
+    const id = /#([^"')]+)["']?\)$/u.exec(clip)?.[1];
+    const definition = id ? path.ownerSVGElement?.querySelector<SVGClipPathElement>(`#${CSS.escape(id)}`) : null;
+    if (!definition || definition.getAttribute("clipPathUnits") === "objectBoundingBox") return null;
+    const region: paper.PathItem[] = [];
+    for (const geometry of definition.querySelectorAll<SVGGeometryElement>("path, circle, ellipse, rect, line, polyline, polygon")) {
+      const matrix = geometry.getScreenCTM();
+      if (!matrix) return null;
+      const clone = geometry.cloneNode(true) as SVGGeometryElement;
+      clone.removeAttribute("transform");
+      clone.setAttribute("fill-rule", getComputedStyle(geometry).clipRule);
+      const item = scope.project.importSVG(clone, { insert: false, expandShapes: true });
+      if (!(item instanceof scope.PathItem)) { item.remove(); return null; }
+      item.fillRule = getComputedStyle(geometry).clipRule === "evenodd" ? "evenodd" : "nonzero";
+      item.transform(new scope.Matrix(matrix.a, matrix.b, matrix.c, matrix.d, matrix.e, matrix.f));
+      region.push(item);
+    }
+    regions.push(region);
+  }
+  return regions;
+}
+
+/** Split at true clip boundary intersections, including visible intervals narrower than the sampling step. */
+function clippedSegments(from: Point, to: Point, regions: readonly paper.PathItem[][], scope: paper.PaperScope): Array<readonly [Point, Point]> {
+  if (regions.length === 0) return [[from, to]];
+  const inside = (point: Point) => regions.every((region) => region.some((path) => path.contains(new scope.Point(point.x, point.y))));
+  const line = new scope.Path.Line({ from: new scope.Point(from.x, from.y), to: new scope.Point(to.x, to.y), insert: false });
+  const length = line.length;
+  if (length === 0) { line.remove(); return inside(from) ? [[from, to]] : []; }
+  const parameters = [0, 1];
+  for (const region of regions) for (const clip of region) {
+    for (const intersection of line.getIntersections(clip)) parameters.push(Math.max(0, Math.min(1, line.getOffsetOf(intersection.point) / length)));
+  }
+  parameters.sort((left, right) => left - right);
+  const at = (t: number): Point => ({ x: from.x + (to.x - from.x) * t, y: from.y + (to.y - from.y) * t });
+  const visible: Array<readonly [Point, Point]> = [];
+  for (let index = 1; index < parameters.length; index++) {
+    const start = parameters[index - 1], end = parameters[index];
+    if (end > start && inside(at((start + end) / 2))) visible.push([at(start), at(end)]);
+  }
+  line.remove();
+  return visible;
+}
+
+/** Freeze rendered geometry before deleting source changes IDs or removes DOM paths. */
+export function collectEraserStrokes(host: HTMLElement | null, eligibleIds: ReadonlySet<string>): EraserStroke[] {
+  if (!host) return [];
+  const strokes: EraserStroke[] = [];
+  const scope = new paper.PaperScope();
+  scope.setup(new scope.Size(1, 1));
+  for (const path of host.querySelectorAll<SVGGeometryElement>("path[data-source-id], circle[data-source-id], ellipse[data-source-id], rect[data-source-id], line[data-source-id], polyline[data-source-id], polygon[data-source-id]")) {
+    const sourceId = path.getAttribute("data-source-id");
+    if (!sourceId || !eligibleIds.has(sourceId) || !visibleGeometry(path)) continue;
+    const clips = clipRegions(path, scope);
+    if (!clips) continue;
+    const matrix = path.getScreenCTM();
+    if (!matrix) continue;
+    const length = path.getTotalLength();
+    const count = Math.max(1, Math.ceil(length * Math.hypot(matrix.a, matrix.b) / (clips.length > 0 ? 0.5 : 2)));
+    const segments: EraserStroke["segments"] = [];
+    let previous = path.getPointAtLength(0).matrixTransform(matrix);
+    for (let index = 1; index <= count; index++) {
+      const next = path.getPointAtLength(length * index / count).matrixTransform(matrix);
+      segments.push(...clippedSegments(previous, next, clips, scope));
+      previous = next;
+    }
+    const strokeWidth = Number.parseFloat(getComputedStyle(path).strokeWidth);
+    clips.flat().forEach((clip) => clip.remove());
+    strokes.push({ sourceId, segments, strokeRadius: Number.isFinite(strokeWidth) ? strokeWidth * Math.max(Math.hypot(matrix.a, matrix.b), Math.hypot(matrix.c, matrix.d)) / 2 : 0 });
+  }
+  scope.project.remove();
+  return strokes;
+}
