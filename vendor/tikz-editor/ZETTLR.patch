+
+/** Compose edits against recomputed handles and commit the whole gesture atomically. */
+export function editSemanticCurveNodes(
+  source: string,
+  elementId: string,
+  selectedIndices: ReadonlySet<number>,
+  operation: "delete" | "smooth",
+  autoSmooth: boolean,
+  activeFigureId: string | null,
+  lockedElementIds: ReadonlySet<string>
+): SemanticCurveEditResult {
+  if (lockedElementIds.has(elementId)) return { kind: "unsupported", reason: "This curve is locked." };
+  let nextSource = source;
+  const handlesFor = (input: string) => {
+    const rendered = renderTikzToSvg(input, { parse: { activeFigureId } });
+    return {
+      scene: rendered.semantic.scene,
+      all: rendered.semantic.editHandles,
+      nodes: rendered.semantic.editHandles.filter((handle) => handle.kind === "path-point" && handle.sourceRef.sourceId === elementId)
+        .sort((left, right) => left.sourceRef.sourceSpan.from - right.sourceRef.sourceSpan.from)
+    };
+  };
+  const original = handlesFor(source);
+  const indices = selectedIndices.size > 0 ? [...selectedIndices] : operation === "smooth"
+    ? original.nodes.map((_, index) => index) : [];
+  if (indices.length === 0) return { kind: "unsupported", reason: "Select editable interior curve nodes." };
+  if (indices.some((index) => index < 0 || index >= original.nodes.length)) return { kind: "unsupported", reason: "The selected curve nodes are stale." };
+  if (operation === "delete" && original.nodes.length - indices.length < 2) {
+    const selected = original.scene.elements.find((element) => element.sourceRef.sourceId === elementId);
+    if (!selected) return { kind: "unsupported", reason: "The selected curve could not be resolved." };
+    const span = selected.sourceRef.sourceSpan;
+    const envelope = originalStrokes(source).find((entry) => span.from >= entry.drawingFrom && span.to <= entry.drawingTo);
+    if (envelope) {
+      if (original.scene.elements.some((element) => lockedElementIds.has(element.sourceRef.sourceId) && element.sourceRef.sourceSpan.from >= envelope.drawingFrom && element.sourceRef.sourceSpan.to <= envelope.drawingTo)) {
+        return { kind: "unsupported", reason: "The original stroke contains a locked element." };
+      }
+      return { kind: "success", source: source.slice(0, envelope.from) + source.slice(envelope.to) };
+    }
+    const deletion = applyEditAction(source, original.all, { kind: "deleteElements", elementIds: [elementId] }, { parseOptions: { activeFigureId } });
+    return deletion.kind === "success" ? { kind: "success", source: deletion.newSource }
+      : { kind: "unsupported", reason: deletion.kind === "error" ? deletion.message : deletion.reason };
+  }
+  const perform = (index: number, kind: "delete" | "smooth"): SemanticCurveEditResult => {
+    const handles = handlesFor(nextSource);
+    const handle = handles.nodes[index];
+    if (!handle) return { kind: "unsupported", reason: "The selected curve node could not be resolved." };
+    const endpoint = endpointEdit(nextSource, elementId, handle, handles.all, kind, activeFigureId);
+    if (endpoint) { if (endpoint.kind === "success") nextSource = endpoint.source; return endpoint; }
+    const action: EditAction = kind === "delete"
+      ? { kind: "deletePathPoint", elementId, handleId: handle.id }
+      : { kind: "setPathPointKind", elementId, handleId: handle.id, pointKind: "smooth" };
+    const result = applyEditAction(nextSource, handles.all, action, { parseOptions: { activeFigureId } });
+    if (result.kind !== "success") return { kind: "unsupported", reason: result.kind === "error" ? result.message : result.reason };
+    nextSource = result.newSource;
+    return { kind: "success", source: nextSource };
+  };
+  for (const index of indices.sort((left, right) => right - left)) {
+    const result = perform(index, operation);
+    if (result.kind !== "success") return result;
+  }
+  if (operation === "delete" && autoSmooth) {
+    const count = handlesFor(nextSource).nodes.length;
+    for (let index = count - 1; index >= 0; index--) {
+      const result = perform(index, "smooth");
+      if (result.kind !== "success") return result;
+    }
+  }
+  return { kind: "success", source: nextSource };
+}
