new file mode 100644
index 00000000..d6cfc9a7
--- /dev/null
+++ b/packages/app/src/ui/canvas-panel/partial-erase.ts
@@ -0,0 +1,293 @@
+import type paper from "paper";
+import type { WorldPoint } from "../coords/types";
+import type { PathStatement } from "tikz-editor/ast/types";
+import { localToSourceUnits, worldToLocal } from "tikz-editor/edit/coords";
+import { formatNumber } from "tikz-editor/edit/format";
+import { parseTikzForEdit, type EditParseOptions } from "tikz-editor/edit/parse-options";
+import { buildStatementText, resolveEligibleExplicitPath, resolvePathControlHandle } from "tikz-editor/edit/path-editing";
+import { findPathStatementById } from "tikz-editor/edit/statement-find";
+import { commandsToSegments } from "tikz-editor/geometry/path-sampler";
+import { isFrameLocalCoordinateEditHandle, type EditHandle, type SceneElement, type ScenePathCommand } from "tikz-editor/semantic/types";
+import { geometryScope } from "./paper-scope";
+
+/**
+ * Partial erasing: the eraser sweep is a region of capsules in world space, and a
+ * path keeps the parts outside it. The cut is paper.js boolean subtraction of the
+ * region from the open path (`PathItem#subtract` with `trace: false`,
+ * http://paperjs.org/reference/pathitem/#subtract-path).
+ *
+ * An explicit line or cubic path is rebuilt from its authored points. Any other path
+ * (circle, ellipse, arc, rectangle, plot, ...) is rebuilt from its scene geometry: a
+ * remaining part that lies on an authored circle or ellipse is written as an `arc`
+ * operation, a straight part as a line, anything else as a cubic.
+ */
+
+type Point = { x: number; y: number };
+type SourcePoint = { world: WorldPoint; raw: string | null };
+/** A circle or ellipse of the path in world space; `rotation` is in degrees. */
+type WorldEllipse = { center: Point; rx: number; ry: number; rotation: number };
+
+/** A path statement the sweep can cut: its world geometry and how to write points back in its frame. */
+export type CuttablePath = {
+  span: { from: number; to: number };
+  text: (body: string) => string;
+  /** A world point in the statement's own coordinates, in source units. */
+  local: (world: Point) => Point | null;
+  /** Authored points whose source text survives a cut unchanged. */
+  kept: SourcePoint[];
+  /** The subpaths of the statement in world space. */
+  geometry: () => paper.Path[];
+  ellipses: WorldEllipse[];
+  /** Whether the remaining pieces stay one statement: true for a path of several subpaths. */
+  onePath: boolean;
+};
+
+function samePoint(a: Point, b: Point): boolean {
+  return Math.abs(a.x - b.x) < 1e-6 && Math.abs(a.y - b.y) < 1e-6;
+}
+
+function frameLocal(frame: Parameters<typeof worldToLocal>[1]): CuttablePath["local"] {
+  return (world) => {
+    const local = worldToLocal(world as WorldPoint, frame);
+    return local ? localToSourceUnits(local) : null;
+  };
+}
+
+/** The whole source span of the path statement `sourceId`, or null when it is not a path statement. */
+export function pathStatementSpan(source: string, sourceId: string, parseOptions: EditParseOptions): { from: number; to: number } | null {
+  return findPathStatementById(parseTikzForEdit(source, parseOptions).figure.body, sourceId)?.span ?? null;
+}
+
+/** Path items whose geometry the scene path of the statement shows in full. */
+const GEOMETRY_ITEM_KINDS: ReadonlySet<PathStatement["items"][number]["kind"]> = new Set(["Coordinate", "PathOption", "PathComment", "PathKeyword", "PlotOperation", "ToOperation", "SvgOperation"]);
+
+/** The subpaths of scene commands. Scene arcs follow the SVG endpoint form in world coordinates, which paper.js reads as path data (http://paperjs.org/reference/pathitem/#pathdata). */
+function commandsPath(scope: paper.PaperScope, commands: readonly ScenePathCommand[]): paper.Path[] {
+  // The scene repeats a move to the current point after an arc; that move does not start a subpath.
+  const data = commands.filter((command, index) => {
+    const before = commands[index - 1];
+    return !(command.kind === "M" && before && before.kind !== "Z" && samePoint(before.to, command.to));
+  }).map((command) => {
+    if (command.kind === "Z") return "Z";
+    if (command.kind === "C") return `C ${command.c1.x} ${command.c1.y} ${command.c2.x} ${command.c2.y} ${command.to.x} ${command.to.y}`;
+    if (command.kind === "A") return `A ${command.rx} ${command.ry} ${command.xAxisRotation} ${command.largeArc ? 1 : 0} ${command.sweep ? 1 : 0} ${command.to.x} ${command.to.y}`;
+    return `${command.kind} ${command.to.x} ${command.to.y}`;
+  }).join(" ");
+  const compound = new scope.CompoundPath({ pathData: data, insert: false });
+  return (compound.removeChildren() as paper.Path[]).filter((item) => item.segments.length > 1);
+}
+
+/** A path statement that is not an explicit line or cubic path, cut by its scene geometry. */
+function sceneCuttablePath(source: string, sourceId: string, handles: readonly EditHandle[], parseOptions: EditParseOptions, elements: readonly SceneElement[]): CuttablePath | null {
+  const statement = findPathStatementById(parseTikzForEdit(source, parseOptions).figure.body, sourceId);
+  // Options before the first coordinate belong to the statement, not to its path.
+  const firstItem = statement?.items.find((item) => item.kind === "Coordinate"), lastItem = statement?.items.at(-1);
+  if (!statement || !firstItem || !lastItem || statement.items.some((item) => !GEOMETRY_ITEM_KINDS.has(item.kind))) return null;
+  const own = handles.filter((handle) => handle.sourceRef.sourceId === sourceId);
+  const frameHandle = own.find(isFrameLocalCoordinateEditHandle);
+  const shapes = elements.filter((element) => element.sourceRef.sourceId === sourceId && !element.adornment);
+  if (!frameHandle || shapes.length === 0 || shapes.some((element) => element.kind === "Text" || element.transform)) return null;
+  const ellipses: WorldEllipse[] = [];
+  for (const element of shapes) {
+    if (element.kind === "Circle") ellipses.push({ center: element.center, rx: element.radius, ry: element.radius, rotation: 0 });
+    else if (element.kind === "Ellipse") ellipses.push({ center: element.center, rx: element.rx, ry: element.ry, rotation: element.rotation ?? 0 });
+    else if (element.kind === "Path") for (const segment of commandsToSegments(element.undecoratedCommands ?? element.commands)) {
+      if (segment.kind === "A" && segment.arc) ellipses.push({ center: { x: segment.arc.cx, y: segment.arc.cy }, rx: segment.arc.rx, ry: segment.arc.ry, rotation: segment.arc.xAxisRotation });
+    }
+  }
+  const geometry = (): paper.Path[] => {
+    const scope = geometryScope();
+    return shapes.flatMap((element): paper.Path[] => {
+      if (element.kind === "Circle") return [new scope.Path.Circle({ center: [element.center.x, element.center.y], radius: element.radius, insert: false })];
+      if (element.kind === "Ellipse") {
+        const ellipse = new scope.Path.Ellipse({ center: [element.center.x, element.center.y], radius: [element.rx, element.ry], insert: false });
+        ellipse.rotate(element.rotation ?? 0, new scope.Point(element.center.x, element.center.y));
+        return [ellipse];
+      }
+      return element.kind === "Path" ? commandsPath(scope, element.undecoratedCommands ?? element.commands) : [];
+    });
+  };
+  return {
+    span: statement.span,
+    text: (body) => `${source.slice(statement.span.from, firstItem.span.from)}${body}${source.slice(lastItem.span.to, statement.span.to)}`,
+    local: frameLocal(frameHandle.frame),
+    // A relative coordinate depends on the point before it, so only absolute text survives a cut unchanged.
+    kept: own.filter((handle) => handle.kind === "path-point" && isFrameLocalCoordinateEditHandle(handle) && handle.rewriteMode !== "delta")
+      .map((handle) => ({ world: handle.world, raw: source.slice(handle.sourceRef.sourceSpan.from, handle.sourceRef.sourceSpan.to) })),
+    geometry,
+    ellipses,
+    onePath: geometry().length > 1
+  };
+}
+
+/** The statement `sourceId` as a cuttable path, or null when its geometry or frame cannot be written back. */
+export function cuttablePath(source: string, sourceId: string, handles: readonly EditHandle[], parseOptions: EditParseOptions, elements: readonly SceneElement[]): CuttablePath | null {
+  const resolved = resolveEligibleExplicitPath(source, sourceId, parseOptions);
+  if (resolved.kind !== "eligible") return sceneCuttablePath(source, sourceId, handles, parseOptions, elements);
+  const { analysis } = resolved;
+  const anchorHandles = analysis.anchors.map((anchor) => handles.find((handle) => handle.kind === "path-point" &&
+    handle.sourceRef.sourceId === sourceId && handle.sourceRef.sourceSpan.from === anchor.item.span.from && handle.sourceRef.sourceSpan.to === anchor.item.span.to));
+  const frameHandle = anchorHandles[0];
+  if (!frameHandle || !isFrameLocalCoordinateEditHandle(frameHandle) || anchorHandles.some((handle) => !handle)) return null;
+  // A relative coordinate depends on the point before it, so only absolute text survives a cut unchanged.
+  const keep = (handle: EditHandle, raw: string): SourcePoint => ({ world: handle.world, raw: isFrameLocalCoordinateEditHandle(handle) && handle.rewriteMode !== "delta" ? raw : null });
+  const anchors = analysis.anchors.map((anchor, index) => keep(anchorHandles[index]!, anchor.raw));
+  /** For each segment, its two controls, or null for a line. */
+  const controls: Array<[SourcePoint, SourcePoint] | null> = [];
+  for (const segment of analysis.segments) {
+    if (segment.kind === "line") { controls.push(null); continue; }
+    const items = [segment.control1Index, segment.control2Index].map((index) => analysis.statement.items[index]);
+    const pair = items.map((item) => item?.kind === "Coordinate" ? resolvePathControlHandle(handles, sourceId, item, source) : null);
+    if (!pair[0] || !pair[1] || items[0]?.kind !== "Coordinate" || items[1]?.kind !== "Coordinate") return null;
+    controls.push([keep(pair[0], source.slice(items[0].span.from, items[0].span.to)), keep(pair[1], source.slice(items[1].span.from, items[1].span.to))]);
+  }
+  return {
+    span: analysis.statement.span,
+    text: (body) => buildStatementText(source, analysis, body),
+    local: frameLocal(frameHandle.frame),
+    kept: [...anchors, ...controls.flatMap((pair) => pair ?? [])],
+    geometry: () => {
+      const scope = geometryScope();
+      const segments = anchors.map((anchor) => new scope.Segment(new scope.Point(anchor.world.x, anchor.world.y)));
+      controls.forEach((pair, index) => {
+        if (!pair) return;
+        const start = segments[index], end = segments[(index + 1) % segments.length];
+        start.handleOut = new scope.Point(pair[0].world.x, pair[0].world.y).subtract(start.point);
+        end.handleIn = new scope.Point(pair[1].world.x, pair[1].world.y).subtract(end.point);
+      });
+      return [new scope.Path({ segments, closed: analysis.closed, insert: false })];
+    },
+    ellipses: [],
+    onePath: false
+  };
+}
+
+/** The capsule a sweep from `from` to `to` covers with radius `radius`. */
+export function sweepCapsule(from: { x: number; y: number }, to: { x: number; y: number }, radius: number): paper.PathItem {
+  const scope = geometryScope();
+  const start = new scope.Point(from.x, from.y);
+  const end = new scope.Point(to.x, to.y);
+  let capsule: paper.PathItem = new scope.Path.Circle({ center: start, radius, insert: false });
+  if (end.getDistance(start) > 1e-9) {
+    const normal = end.subtract(start).normalize(radius).rotate(90, new scope.Point(0, 0));
+    const band = new scope.Path({ segments: [start.add(normal), end.add(normal), end.subtract(normal), start.subtract(normal)], closed: true, insert: false });
+    capsule = capsule.unite(band, { insert: false }).unite(new scope.Path.Circle({ center: end, radius, insert: false }), { insert: false });
+  }
+  return capsule;
+}
+
+/** An ellipse in the statement's own coordinates whose axes lie along the coordinate axes, as a TikZ `arc` needs. */
+type LocalEllipse = { world: WorldEllipse; center: Point; rx: number; ry: number };
+
+function localEllipse(path: CuttablePath, world: WorldEllipse): LocalEllipse | null {
+  const angle = world.rotation * Math.PI / 180;
+  const center = path.local(world.center);
+  const alongX = path.local({ x: world.center.x + world.rx * Math.cos(angle), y: world.center.y + world.rx * Math.sin(angle) });
+  const alongY = path.local({ x: world.center.x - world.ry * Math.sin(angle), y: world.center.y + world.ry * Math.cos(angle) });
+  if (!center || !alongX || !alongY) return null;
+  const u = { x: alongX.x - center.x, y: alongX.y - center.y }, v = { x: alongY.x - center.x, y: alongY.y - center.y };
+  const aligned = (major: number, minor: number) => Math.abs(minor) < 1e-6 * Math.abs(major);
+  if (aligned(u.x, u.y) && aligned(v.y, v.x)) return { world, center, rx: Math.abs(u.x), ry: Math.abs(v.y) };
+  if (aligned(u.y, u.x) && aligned(v.x, v.y)) return { world, center, rx: Math.abs(v.x), ry: Math.abs(u.y) };
+  return null;
+}
+
+/** Whether `curve` lies on `ellipse`: five of its points satisfy the ellipse equation. A cubic arc of a quarter turn is off by 3e-4 of the radius. */
+function curveOnEllipse(curve: paper.Curve, ellipse: WorldEllipse): boolean {
+  const angle = -ellipse.rotation * Math.PI / 180;
+  return [0, 0.25, 0.5, 0.75, 1].every((time) => {
+    const point = curve.getPointAtTime(time);
+    const dx = point.x - ellipse.center.x, dy = point.y - ellipse.center.y;
+    const x = (dx * Math.cos(angle) - dy * Math.sin(angle)) / ellipse.rx, y = (dx * Math.sin(angle) + dy * Math.cos(angle)) / ellipse.ry;
+    return Math.abs(Math.hypot(x, y) - 1) < 2e-3;
+  });
+}
+
+/** The angle of `point` on `ellipse` in degrees, as TikZ measures `start angle` and `end angle`. */
+function ellipseAngle(path: CuttablePath, ellipse: LocalEllipse, point: Point): number | null {
+  const local = path.local(point);
+  return local ? Math.atan2((local.y - ellipse.center.y) / ellipse.ry, (local.x - ellipse.center.x) / ellipse.rx) * 180 / Math.PI : null;
+}
+
+/** The signed difference `to - from` in degrees, in (-180, 180]. */
+function turn(from: number, to: number): number {
+  const delta = (to - from) % 360;
+  return delta > 180 ? delta - 360 : delta <= -180 ? delta + 360 : delta;
+}
+
+/** The body of one remaining piece, or null when a point cannot be written in the statement's coordinates. */
+function pieceBody(path: CuttablePath, piece: paper.Path, ellipses: readonly LocalEllipse[]): string | null {
+  const write = (point: Point): string | null => {
+    const original = path.kept.find((item) => item.raw && samePoint(item.world, point));
+    if (original?.raw) return original.raw;
+    const local = path.local(point);
+    return local ? `(${formatNumber(local.x)},${formatNumber(local.y)})` : null;
+  };
+  const first = write(piece.firstSegment.point);
+  if (!first) return null;
+  const parts = [first];
+  const curves = piece.curves;
+  for (let index = 0; index < curves.length; index++) {
+    const curve = curves[index];
+    const closes = piece.closed && index === curves.length - 1;
+    if (!curve.hasHandles()) {
+      const target = closes ? "cycle" : write(curve.point2);
+      if (!target) return null;
+      parts.push(`-- ${target}`);
+      continue;
+    }
+    const ellipse = ellipses.find((candidate) => curveOnEllipse(curve, candidate.world));
+    if (ellipse) {
+      const start = ellipseAngle(path, ellipse, curve.point1);
+      if (start === null) return null;
+      let angle = start, sweep = 0;
+      // Consecutive curves on one ellipse are one arc; each is under half a turn, so its middle fixes its direction.
+      for (; index < curves.length && curveOnEllipse(curves[index], ellipse.world); index++) {
+        const middle = ellipseAngle(path, ellipse, curves[index].getPointAtTime(0.5)), end = ellipseAngle(path, ellipse, curves[index].point2);
+        if (middle === null || end === null) return null;
+        sweep += turn(angle, middle) + turn(middle, end);
+        angle = end;
+      }
+      index--;
+      const from = ((Number(formatNumber(start)) % 360) + 360) % 360;
+      const radii = Math.abs(ellipse.rx - ellipse.ry) < 1e-6 * ellipse.rx
+        ? `radius=${formatNumber(ellipse.rx, { fractionDigits: 4 })}`
+        : `x radius=${formatNumber(ellipse.rx, { fractionDigits: 4 })}, y radius=${formatNumber(ellipse.ry, { fractionDigits: 4 })}`;
+      parts.push(`arc[start angle=${formatNumber(from)}, end angle=${formatNumber(from + sweep)}, ${radii}]`);
+      if (piece.closed && index === curves.length - 1) parts.push("-- cycle");
+      continue;
+    }
+    const control1 = write(curve.point1.add(curve.handle1)), control2 = write(curve.point2.add(curve.handle2));
+    const target = closes ? "cycle" : write(curve.point2);
+    if (!control1 || !control2 || !target) return null;
+    parts.push(`.. controls ${control1} and ${control2} .. ${target}`);
+  }
+  return parts.join(" ");
+}
+
+/**
+ * The statements left of `path` after `region` is erased: null when the region misses it,
+ * an empty list when it covers it, otherwise the remaining pieces.
+ */
+export function remainingStatements(path: CuttablePath, region: paper.PathItem, minimumLength: number): string[] | null {
+  const scope = geometryScope();
+  const rest: paper.Path[] = [];
+  let touched = false;
+  for (const subpath of path.geometry()) {
+    if (subpath.getIntersections(region).length === 0 && !region.contains(subpath.firstSegment.point)) { rest.push(subpath); continue; }
+    touched = true;
+    const cut = subpath.subtract(region, { trace: false, insert: false });
+    rest.push(...(cut instanceof scope.CompoundPath ? cut.children : [cut]) as paper.Path[]);
+  }
+  if (!touched) return null;
+  const pieces = rest.filter((piece) => piece.segments.length > 1 && piece.length >= minimumLength);
+  const ellipses = path.ellipses.flatMap((ellipse) => localEllipse(path, ellipse) ?? []);
+  const bodies: string[] = [];
+  for (const piece of pieces) {
+    const body = pieceBody(path, piece, ellipses);
+    if (body === null) return null;
+    bodies.push(body);
+  }
+  if (bodies.length === 0) return [];
+  return path.onePath ? [path.text(bodies.join(" "))] : bodies.map((body) => path.text(body));
+}
