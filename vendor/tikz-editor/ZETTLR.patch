--- /dev/null
+++ b/packages/core/src/edit/lattice-units.ts
@@ -0,0 +1,35 @@
+import type { WorldTransform } from "../coords/transforms.js";
+import { LATTICE_UNIT_PT } from "./snapping/grid-snaps.js";
+import type { InspectorProperty } from "./inspector/types.js";
+
+/**
+ * Points per lattice step along each canvas axis, or null where the figure's
+ * lattice vector for that axis is skewed off the canvas axis, so a canvas-axis
+ * length is not a whole number of lattice steps.
+ */
+/** The unit label of a value stated in lattice units; such values are written to TikZ as bare numbers. */
+export const LATTICE_UNIT = "units";
+
+export type AxisLatticeScale = { x: number | null; y: number | null };
+
+/** The frame maps source points, where one lattice step is LATTICE_UNIT_PT, to world points. */
+export function axisLatticeScale(frame: WorldTransform): AxisLatticeScale {
+  return {
+    x: Math.abs(frame.b) < 1e-9 ? Math.abs(frame.a) * LATTICE_UNIT_PT : null,
+    y: Math.abs(frame.c) < 1e-9 ? Math.abs(frame.d) * LATTICE_UNIT_PT : null
+  };
+}
+
+type ShiftField = Extract<InspectorProperty, { kind: "number" }>;
+
+/** A canvas-axis shift stated in lattice units; read-only in pt when the lattice is skewed on that axis. */
+export function latticeShiftField(field: Omit<ShiftField, "unit" | "ptPerUnit" | "value" | "defaultValue" | "step"> & {
+  valuePt: number;
+  defaultPt: number;
+}, ptPerUnit: number | null): ShiftField {
+  const { valuePt, defaultPt, ...rest } = field;
+  if (ptPerUnit === null) {
+    return { ...rest, value: valuePt, defaultValue: defaultPt, step: 0.1, unit: "pt", readOnlyReason: "This figure's lattice is skewed on this axis; move the element on the canvas instead." };
+  }
+  return { ...rest, value: valuePt / ptPerUnit, defaultValue: defaultPt / ptPerUnit, step: 0.25, unit: LATTICE_UNIT, ptPerUnit };
+}
