+/** The midpoint of the one cubic `(0,0) .. controls A and B .. (6,0)` in the rewritten source. */
+function mergedCubicMidpoint(newSource: string): { x: number; y: number } {
+  const merged = /\\draw \(0,0\) \.\. controls \(([^,]+),([^)]+)\) and \(([^,]+),([^)]+)\) \.\. \(6,0\)/u.exec(newSource);
+  if (!merged) {
+    throw new Error(`Expected one cubic from (0,0) to (6,0) in ${newSource}`);
+  }
+  const [c1x, c1y, c2x, c2y] = merged.slice(1).map(Number);
+  return { x: (3 * c1x + 3 * c2x + 6) / 8, y: (3 * c1y + 3 * c2y) / 8 };
+}
