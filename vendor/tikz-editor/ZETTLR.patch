diff --git a/packages/app/src/ui/ZoomDisplayControl.tsx b/packages/app/src/ui/ZoomDisplayControl.tsx
new file mode 100644
index 00000000..e45afbd7
--- /dev/null
+++ b/packages/app/src/ui/ZoomDisplayControl.tsx
@@ -0,0 +1,53 @@
+import { useState } from "react";
+import { useEditorStore } from "../store/store";
+import { CANVAS_ZOOM_BASE_SCALE, CANVAS_ZOOM_PRESET_PERCENTS } from "../store/workspace-state";
+import { ToolbarToolPopup, ToolbarPopupSection } from "./ToolbarToolPopup";
+import css from "./ZoomDisplayControl.module.css";
+
+const MIN_ZOOM_PERCENT = CANVAS_ZOOM_PRESET_PERCENTS[0];
+const MAX_ZOOM_PERCENT = 400;
+
+/** Zoom and canvas aids behind one control showing the zoom percentage. */
+export function ZoomDisplayControl({ triggerClassName }: { triggerClassName: string }) {
+  const [open, setOpen] = useState(false);
+  const showGrid = useEditorStore((state) => state.showGrid);
+  const showRulers = useEditorStore((state) => state.showRulers);
+  const showGuides = useEditorStore((state) => state.showGuides);
+  const showDocumentBounds = useEditorStore((state) => state.showDocumentBounds);
+  const canvasTransform = useEditorStore((state) => state.canvasTransform);
+  const canvasFitToContentScale = useEditorStore((state) => state.canvasFitToContentScale);
+  const dispatch = useEditorStore((state) => state.dispatch);
+
+  const zoomPercent = Math.round((canvasTransform.scale / CANVAS_ZOOM_BASE_SCALE) * 100);
+  const fitToContentDoubleZoomPercent = canvasFitToContentScale == null
+    ? MAX_ZOOM_PERCENT
+    : Math.ceil((canvasFitToContentScale / CANVAS_ZOOM_BASE_SCALE) * 200);
+  const maxZoomPercent = Math.max(MAX_ZOOM_PERCENT, fitToContentDoubleZoomPercent, zoomPercent);
+  const sliderZoomPercent = Math.max(MIN_ZOOM_PERCENT, Math.min(maxZoomPercent, zoomPercent));
+  const zoomOptions = [...new Set([
+    ...CANVAS_ZOOM_PRESET_PERCENTS.filter((level) => level <= maxZoomPercent),
+    maxZoomPercent,
+    zoomPercent
+  ])].sort((left, right) => left - right);
+  const requestZoomPercent = (percent: number) =>
+    dispatch({ type: "REQUEST_ZOOM_SCALE", scale: (percent / 100) * CANVAS_ZOOM_BASE_SCALE });
+
+  return (
+    <ToolbarToolPopup open={open} onClose={() => setOpen(false)} popup={
+      <ToolbarPopupSection title="Zoom and display">
+        <button type="button" className={css.action} onClick={() => dispatch({ type: "REQUEST_FIT_TO_CONTENT" })}>Fit diagram</button>
+        <label>Zoom <input type="range" min={MIN_ZOOM_PERCENT} max={maxZoomPercent} value={sliderZoomPercent}
+          aria-label="Zoom" onChange={(event) => requestZoomPercent(Number(event.currentTarget.value))} /></label>
+        <div className={css.levels}>{zoomOptions.map((level) => <button type="button" key={level}
+          className={css.action} aria-pressed={zoomPercent === level} onClick={() => requestZoomPercent(level)}>{level}%</button>)}</div>
+        {([{ aid: "grid", label: "Grid", checked: showGrid }, { aid: "rulers", label: "Rulers", checked: showRulers },
+          { aid: "guides", label: "Ruler guides", checked: showGuides },
+          { aid: "documentBounds", label: "Output bounds", checked: showDocumentBounds }] as const).map(({ aid, label, checked }) =>
+          <button type="button" key={aid} className={css.action} aria-pressed={checked}
+            onClick={() => dispatch({ type: "TOGGLE_CANVAS_AID", aid })}>{label}</button>)}
+      </ToolbarPopupSection>}>
+      <button type="button" className={triggerClassName} aria-label="Zoom and display" aria-haspopup="dialog" aria-expanded={open}
+        onClick={() => setOpen((current) => !current)}>{zoomPercent}%</button>
+    </ToolbarToolPopup>
+  );
+}
