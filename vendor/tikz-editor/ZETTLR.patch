+import type { EditHandle } from "tikz-editor/semantic/types";
+import { findClosestSegmentWorldPoint, resolveEligibleExplicitPath } from "tikz-editor/edit/path-editing";
+import type { EditParseOptions } from "tikz-editor/edit/parse-options";
+import type { WorldPoint } from "../coords/types";
+
+/** How far from a path, in screen pixels, a label still lands on it. */
+const LABEL_HOST_RADIUS_PX = 12;
+
+export type LabelHostSnap = { sourceId: string; world: WorldPoint };
+
+/**
+ * The editable path a label placed at the pointer attaches to, and the point on it the label
+ * takes: the nearest path within reach whose points the pointer can be written against.
+ */
+export function resolveLabelHostSnap(input: {
+  pointerWorld: WorldPoint;
+  zoom: number;
+  editHandles: readonly EditHandle[];
+  source: string;
+  parseOptions: EditParseOptions;
+}): LabelHostSnap | null {
+  const reach = LABEL_HOST_RADIUS_PX / Math.max(input.zoom, 1e-6);
+  let best: (LabelHostSnap & { distance: number }) | null = null;
+  for (const sourceId of candidateSourceIds(input.editHandles, input.pointerWorld, reach)) {
+    const resolved = resolveEligibleExplicitPath(input.source, sourceId, input.parseOptions, { allowAttachedNodes: true });
+    if (resolved.kind !== "eligible") continue;
+    const closest = findClosestSegmentWorldPoint(input.editHandles, sourceId, resolved.analysis, input.pointerWorld, input.source);
+    if (!closest || closest.distance > reach) continue;
+    if (!best || closest.distance < best.distance) {
+      best = { sourceId, world: closest.point, distance: closest.distance };
+    }
+  }
+  return best ? { sourceId: best.sourceId, world: best.world } : null;
+}
+
+/**
+ * Paths whose handle box, grown by the reach, holds the pointer. A line lies in the box of its
+ * ends and a cubic in the box of its anchors and controls (the convex hull property of Bézier
+ * curves), so no path outside this set can be within reach.
+ */
+function candidateSourceIds(editHandles: readonly EditHandle[], pointer: WorldPoint, reach: number): string[] {
+  const boxes = new Map<string, { minX: number; minY: number; maxX: number; maxY: number }>();
+  for (const handle of editHandles) {
+    if (handle.kind !== "path-point" && handle.kind !== "path-control") continue;
+    const box = boxes.get(handle.sourceRef.sourceId);
+    if (!box) {
+      boxes.set(handle.sourceRef.sourceId, { minX: handle.world.x, minY: handle.world.y, maxX: handle.world.x, maxY: handle.world.y });
+      continue;
+    }
+    box.minX = Math.min(box.minX, handle.world.x);
+    box.minY = Math.min(box.minY, handle.world.y);
+    box.maxX = Math.max(box.maxX, handle.world.x);
+    box.maxY = Math.max(box.maxY, handle.world.y);
+  }
+  return [...boxes.entries()]
+    .filter(([, box]) =>
+      pointer.x >= box.minX - reach && pointer.x <= box.maxX + reach &&
+      pointer.y >= box.minY - reach && pointer.y <= box.maxY + reach)
+    .map(([sourceId]) => sourceId);
+}
