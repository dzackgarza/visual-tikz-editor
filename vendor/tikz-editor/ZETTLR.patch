+    expect(applyMoveIntoScopeAction(source, [definition.id], scope.id).kind).toBe('unsupported');
+  });
+});
+
+describe('saved command shortcuts', () => {
+  const key = (value: string, modifiers: Partial<{ ctrlKey: boolean; metaKey: boolean; altKey: boolean; shiftKey: boolean }> = {}) =>
