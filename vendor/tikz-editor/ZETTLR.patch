+
+/** Whether the construction in progress has a Finish step: an open path with its points placed. */
+export function constructionFinishes(snapshot: CanvasSessionSnapshot): boolean {
+  return snapshot.matches({ work: "constructing" }) && snapshot.context.construction?.kind === "path";
