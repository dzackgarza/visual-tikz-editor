diff --git a/test/statement-marks.spec.ts b/test/statement-marks.spec.ts
new file mode 100644
index 00000000..a1817e3f
--- /dev/null
+++ b/test/statement-marks.spec.ts
@@ -0,0 +1,91 @@
+import { describe, expect, it } from "vitest";
+import { computeSnapshot } from "../packages/app/src/compute.js";
+import { documentLockStatements } from "../packages/app/src/store/element-locks.js";
+import { editorReducer, makeInitialState } from "../packages/app/src/store/reducer.js";
+import type { EditorAction, EditorState } from "../packages/app/src/store/types.js";
+
+// A layer's visibility and lock are view state beside the source (data-model Layer):
+// hiding or locking one never changes the source, and each mark follows its statement.
+const source = String.raw`\begin{tikzpicture}
+\begin{scope}[name=Rear]
+\draw (0,0) -- (4,0);
+\end{scope}
+\begin{scope}[name=Front]
+\draw (0,2) -- (4,2);
+\end{scope}
+\end{tikzpicture}`;
+
+let request = 0;
+async function rendered(state: EditorState, text: string): Promise<EditorState> {
+  const id = `marks-${++request}`;
+  let next = editorReducer(state, { type: "CODE_EDITED", source: text });
+  next = editorReducer(next, { type: "COMPUTE_REQUESTED", requestId: id });
+  const { snapshot } = await computeSnapshot({ id, source: text });
+  return editorReducer(next, { type: "SNAPSHOT_READY", requestId: id, snapshot });
+}
+
+const dispatch = (state: EditorState, ...actions: EditorAction[]) => actions.reduce(editorReducer, state);
+const active = (state: EditorState) => state.documents[state.activeDocumentId]!;
+function layer(state: EditorState, name: string) {
+  const document = active(state);
+  const scope = documentLockStatements(document).find((statement) =>
+    document.source.slice(statement.span.from, statement.span.to).startsWith(String.raw`\begin{scope}[name=${name}]`));
+  if (!scope) throw new Error(`No layer ${name}`);
+  const paths = (document.snapshot.scene?.elements ?? [])
+    .filter((element) => element.sourceRef.sourceSpan.from > scope.span.from && element.sourceRef.sourceSpan.to < scope.span.to)
+    .map((element) => element.sourceRef.sourceId);
+  expect(paths).toHaveLength(1);
+  return { id: scope.id, path: paths[0]! };
+}
+
+describe("statement marks", () => {
+  it("hides a layer without changing the source, and its object is neither drawn nor selected", async () => {
+    const state = await rendered(makeInitialState(), source);
+    const rear = layer(state, "Rear"), front = layer(state, "Front");
+    const hidden = dispatch(state, { type: "SET_STATEMENT_MARK", mark: "hidden", id: rear.id, on: true });
+    expect(hidden.source).toBe(source);
+    expect(hidden.hiddenElementIds.has(rear.path)).toBe(true);
+    expect(hidden.hiddenElementIds.has(front.path)).toBe(false);
+    const selected = dispatch(hidden, { type: "SELECT_RANGE", ids: [rear.path, front.path] });
+    expect([...selected.selectedElementIds]).toEqual([front.path]);
+    const shown = dispatch(hidden, { type: "SET_STATEMENT_MARK", mark: "hidden", id: rear.id, on: false });
+    expect(shown.hiddenElementIds.size).toBe(0);
+  });
+
+  it("hiding a selected layer clears its object from the selection", async () => {
+    const state = await rendered(makeInitialState(), source);
+    const rear = layer(state, "Rear");
+    const after = dispatch(state,
+      { type: "SELECT_RANGE", ids: [rear.path] },
+      { type: "SET_STATEMENT_MARK", mark: "hidden", id: rear.id, on: true });
+    expect(after.selectedElementIds.size).toBe(0);
+  });
+
+  it("keeps a lock and a hide on their statements through an edit before them", async () => {
+    const state = await rendered(makeInitialState(), source);
+    const marked = dispatch(state,
+      { type: "SET_STATEMENT_MARK", mark: "hidden", id: layer(state, "Rear").id, on: true },
+      { type: "SET_STATEMENT_MARK", mark: "locked", id: layer(state, "Front").id, on: true });
+    const edited = await rendered(marked, `% note\n${source}`);
+    const document = active(edited);
+    expect(document.hiddenStatements).toHaveLength(1);
+    expect(document.lockedStatements).toHaveLength(1);
+    expect(edited.hiddenElementIds.has(layer(edited, "Rear").path)).toBe(true);
+    expect(edited.lockedElementIds.has(layer(edited, "Front").path)).toBe(true);
+    expect(edited.source).toBe(`% note\n${source}`);
+  });
+
+  it("restores kept marks only where the source still holds their text", async () => {
+    const state = await rendered(makeInitialState(), source);
+    const marked = dispatch(state,
+      { type: "SET_STATEMENT_MARK", mark: "hidden", id: layer(state, "Rear").id, on: true },
+      { type: "SET_STATEMENT_MARK", mark: "locked", id: layer(state, "Front").id, on: true });
+    const kept = { locked: active(marked).lockedStatements, hidden: active(marked).hiddenStatements };
+    const fresh = await rendered(makeInitialState(), source);
+    const restored = dispatch(fresh, { type: "RESTORE_STATEMENT_MARKS", ...kept });
+    expect(restored.hiddenElementIds.has(layer(restored, "Rear").path)).toBe(true);
+    expect(restored.lockedElementIds.has(layer(restored, "Front").path)).toBe(true);
+    const stale = dispatch(fresh, { type: "RESTORE_STATEMENT_MARKS", locked: [], hidden: [{ ...kept.hidden[0]!, text: "\\begin{scope}[name=Gone]" }] });
+    expect(active(stale).hiddenStatements).toEqual([]);
+  });
+});
