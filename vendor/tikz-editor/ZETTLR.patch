@@ -0,0 +1,36 @@
+import { useEffect } from "react";
+import { useShallow } from "zustand/react/shallow";
+import { getActiveEditorPlatform } from "../platform/current";
+import { useSettingsStore } from "../settings/useSettingsStore";
+
+/**
+ * Puts Settings › Appearance on the document: `data-color-scheme` follows the system while
+ * Match System Appearance is on, and holds the chosen scheme while it is off.
+ */
+export function useAppliedColorScheme(): void {
+  const { colorScheme, canvasInvert } = useSettingsStore(useShallow((s) => ({
+    colorScheme: s.settings.general.colorScheme,
+    canvasInvert: s.settings.general.canvasInvert
+  })));
+  const platformWindow = getActiveEditorPlatform().window;
+  useEffect(() => {
+    const apply = (dark: boolean) => {
+      document.documentElement.dataset.colorScheme = dark ? "dark" : "light";
+      if (dark && canvasInvert) {
+        document.documentElement.dataset.canvasInvert = "true";
+      } else {
+        delete document.documentElement.dataset.canvasInvert;
+      }
+      void platformWindow?.setTheme?.(colorScheme === "system" ? null : dark ? "dark" : "light");
+    };
+    if (colorScheme !== "system") {
+      apply(colorScheme === "dark");
+      return;
+    }
+    const mq = window.matchMedia("(prefers-color-scheme: dark)");
+    apply(mq.matches);
+    const handler = (e: MediaQueryListEvent) => { apply(e.matches); };
+    mq.addEventListener("change", handler);
+    return () => { mq.removeEventListener("change", handler); };
+  }, [canvasInvert, colorScheme, platformWindow]);
+}
