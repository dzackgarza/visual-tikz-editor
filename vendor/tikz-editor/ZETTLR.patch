diff --git a/packages/app/src/ui/canvas-panel/SelectionStrip.tsx b/packages/app/src/ui/canvas-panel/SelectionStrip.tsx
new file mode 100644
index 00000000..7a32a8e1
--- /dev/null
+++ b/packages/app/src/ui/canvas-panel/SelectionStrip.tsx
@@ -0,0 +1,52 @@
+import { useState, type CSSProperties, type MouseEvent as ReactMouseEvent, type Ref } from "react";
+import type { AppMenuCommandId, AppMenuItem } from "../../app-menu";
+import type { CommandBindings, CommandOrigin } from "../editor-command-runtime";
+import { ContextMenuPopup, applicableContextItems } from "../CanvasContextMenu";
+import css from "./FreehandResultPopup.module.css";
+
+/** A primary action of the selection: it is shown only when it applies. */
+export type StripAction = { label: string; run: () => void };
+/** A primary group of commands: shown only when one of its commands applies. */
+export type StripMenu = { label: string; items: readonly AppMenuItem[] };
+
+/**
+ * The one control every selection gets: what is selected, its lock, the primary
+ * actions for its kind, and More for the rest. Shape, curve, curve points, and
+ * several objects differ only in the scope line and the actions.
+ */
+export function SelectionStrip({ scope, lock, actions, menus, bindings, onCommandRun, onMore, measureRef, style }: {
+  /** What the strip acts on, for example "Rectangle", "Curve · 5 points", "2 points selected", "3 objects". */
+  scope: string;
+  lock: { locked: boolean; toggle: () => void } | null;
+  actions: readonly StripAction[];
+  menus: readonly StripMenu[];
+  bindings: CommandBindings;
+  onCommandRun: (commandId: AppMenuCommandId, origin: CommandOrigin) => void;
+  /** Opens the full command menu for the selection; null when no further command applies. */
+  onMore: ((event: ReactMouseEvent<HTMLButtonElement>) => void) | null;
+  measureRef: Ref<HTMLDivElement>;
+  style: CSSProperties;
+}) {
+  const [openMenu, setOpenMenu] = useState<string | null>(null);
+  const shownMenus = menus.filter((menu) => applicableContextItems(menu.items, bindings).length > 0);
+  const expanded = shownMenus.find((menu) => menu.label === openMenu) ?? null;
+  return (
+    <div ref={measureRef} role="toolbar" aria-label="Selection" className={`${css.rangeControls} ${css.strip}`} style={style}
+      onPointerDown={(event) => event.stopPropagation()}>
+      <span className={css.scope}>{scope}</span>
+      <div className={css.stripRow}>
+        {lock ? <button type="button" className={css.lockToggle} aria-pressed={lock.locked} onClick={lock.toggle}>
+          <span aria-hidden="true">{lock.locked ? "🔒" : "🔓"}</span>Lock
+        </button> : null}
+        {actions.map((action) => <button key={action.label} type="button" onClick={action.run}>{action.label}</button>)}
+        {shownMenus.map((menu) => (
+          <button key={menu.label} type="button" aria-haspopup="menu" aria-expanded={expanded?.label === menu.label}
+            onClick={() => setOpenMenu(expanded?.label === menu.label ? null : menu.label)}>{menu.label}</button>
+        ))}
+        {onMore ? <button type="button" aria-haspopup="menu" onClick={onMore}>More</button> : null}
+      </div>
+      {expanded ? <ContextMenuPopup items={expanded.items} path={expanded.label} bindings={bindings} origin="context-menu"
+        onCommandRun={(commandId, origin) => { setOpenMenu(null); onCommandRun(commandId, origin); }} /> : null}
+    </div>
+  );
+}
diff --git a/packages/app/src/ui/canvas-panel/arc-tool.ts b/packages/app/src/ui/canvas-panel/arc-tool.ts
new file mode 100644
index 00000000..a2cb4a9b
--- /dev/null
+++ b/packages/app/src/ui/canvas-panel/arc-tool.ts
@@ -0,0 +1,82 @@
+import { resolveSnapSettings, snapArcEndpointToLattice, type LatticeTransform, type SnapLine, type SnapSettingsPatch } from "tikz-editor/edit/snapping";
+import { applyMatrix, inverseMatrix } from "tikz-editor/semantic/transform";
+import { pt, worldPoint, worldTransform } from "tikz-editor/coords/index";
+import type { WorldPoint } from "../coords/types";
+import type { ArcDraft } from "./types";
+import { nearestArcMagnetDegrees, resolveToolCreateCurrentWorld, withSnapTarget } from "./interaction-helpers";
+
+/** The rules in force for the arc tool's next point. */
+export type ArcToolRules = {
+  latticeLock: boolean;
+  /** Shift or the constrain-geometry setting: fifteen-degree steps. */
+  constrainAngle: boolean;
+  /** Ctrl or Meta: the lattice does not pull. */
+  bypassLattice: boolean;
+  latticeTransform: LatticeTransform | undefined;
+  /** The snapping engine's reach in world units at the current zoom. */
+  reachWorld: number;
+};
+
+export type ArcToolPoint =
+  /** The radius point as the snapping engine placed it; the engine's target stands. */
+  | { point: WorldPoint; target: "engine" }
+  /** The end follows the pointer round the circle; no rule names it. */
+  | { point: WorldPoint; target: "none" }
+  | { point: WorldPoint; target: "named"; label: string };
+
+type ModifierKeys = { shiftKey: boolean; ctrlKey: boolean; metaKey: boolean };
+
+export function arcToolRules(event: ModifierKeys, constrainGeometry: boolean, settings: SnapSettingsPatch, zoom: number): ArcToolRules {
+  return {
+    latticeLock: Boolean(settings.latticeLock),
+    constrainAngle: event.shiftKey || constrainGeometry,
+    bypassLattice: event.ctrlKey || event.metaKey,
+    latticeTransform: settings.latticeTransform,
+    reachWorld: resolveSnapSettings(settings).thresholdPx / Math.max(zoom, 1e-6)
+  };
+}
+
+/**
+ * The arc tool's next point for a pointer. Before a start exists the point sets the radius: the
+ * snapping engine's choice stands, turned to a fifteen-degree step under the angle constraint. With a
+ * start the point is the end, on the circle at the pointer's angle in the figure frame. The angle
+ * constraint rounds it to fifteen degrees; otherwise the lattice, when locked, takes a lattice point
+ * of the circle within reach; otherwise a common angle pulls it; otherwise it is free.
+ */
+export function resolveArcToolPoint(draft: ArcDraft, rawWorld: WorldPoint, snappedWorld: WorldPoint, rules: ArcToolRules): ArcToolPoint {
+  if (draft.start === undefined) {
+    if (!rules.constrainAngle) return { point: snappedWorld, target: "engine" };
+    return { point: resolveToolCreateCurrentWorld(draft.center, snappedWorld, "addCircle", true, rules.latticeTransform), target: "named", label: "Angle" };
+  }
+  const t = rules.latticeTransform;
+  const frame = t ? worldTransform(t.a, t.b, t.c, t.d, t.e, t.f) : worldTransform(1, 0, 0, 1, 0, 0);
+  const inverse = inverseMatrix(frame);
+  if (!inverse) return { point: draft.start, target: "none" };
+  const center = applyMatrix(inverse, draft.center);
+  const start = applyMatrix(inverse, draft.start);
+  const pointer = applyMatrix(inverse, rawWorld);
+  const radius = Math.hypot(start.x - center.x, start.y - center.y);
+  const onCircle = (degrees: number): WorldPoint => {
+    const radians = degrees * Math.PI / 180;
+    return applyMatrix(frame, worldPoint(pt(center.x + radius * Math.cos(radians)), pt(center.y + radius * Math.sin(radians))));
+  };
+  const degrees = Math.atan2(pointer.y - center.y, pointer.x - center.x) * 180 / Math.PI;
+  if (rules.constrainAngle) return { point: onCircle(Math.round(degrees / 15) * 15), target: "named", label: "Angle" };
+  const free = onCircle(degrees);
+  if (rules.latticeLock && !rules.bypassLattice) {
+    const candidate = snapArcEndpointToLattice(draft.center, draft.start, rawWorld, t);
+    if (candidate.kind === "point" && Math.hypot(candidate.point.x - free.x, candidate.point.y - free.y) <= rules.reachWorld) {
+      return { point: candidate.point, target: "named", label: "Lattice" };
+    }
+  }
+  const magnet = nearestArcMagnetDegrees(degrees);
+  if (magnet !== null) return { point: onCircle(magnet), target: "named", label: "Angle" };
+  return { point: free, target: "none" };
+}
+
+/** The snap lines after the arc point: the engine's target stands, a free end has none, a named rule replaces it. */
+export function arcTargetLines(lines: readonly SnapLine[], resolved: ArcToolPoint): SnapLine[] {
+  if (resolved.target === "engine") return [...lines];
+  if (resolved.target === "none") return lines.filter((line) => line.type !== "target");
+  return withSnapTarget(lines, resolved.point, resolved.label);
+}
diff --git a/packages/app/src/ui/canvas-panel/canvas-session.ts b/packages/app/src/ui/canvas-panel/canvas-session.ts
new file mode 100644
index 00000000..e60d3051
--- /dev/null
+++ b/packages/app/src/ui/canvas-panel/canvas-session.ts
@@ -0,0 +1,331 @@
+/**
+ * The canvas session: the one interaction state the editor is in, and the provisional data that state owns.
+ * The editor store keeps authored source, the chosen tool and the object selection; this statechart keeps what
+ * the next pen contact does. The states are visual-tikz-editor's docs/interaction-model.md, written as an
+ * XState v5 machine (https://stately.ai/docs/xstate).
+ */
+import type { MutableRefObject } from "react";
+import { assign, createActor, emit, setup, type SnapshotFrom } from "xstate";
+
+import type { AppSettings, ArcConstruction, CircleConstruction } from "../../settings/types";
+import { useSettingsStore } from "../../settings/useSettingsStore";
+import { useEditorStore } from "../../store/store";
+import type { ToolMode } from "../../store/types";
+import type { ArcDraft, FreehandResultOffer, PathToolDraft, PendingBezier, StateSetter, TapDraft } from "./types";
+
+/** How the Circle and Arc tools take their points. */
+export type ConstructionVariant = { circle: CircleConstruction; arc: ArcConstruction };
+
+/** The provisional part of a construction: the points placed so far, before the construction commits. */
+export type Construction =
+  | { kind: "taps"; draft: TapDraft }
+  | { kind: "arc"; draft: ArcDraft }
+  | { kind: "path"; draft: PathToolDraft }
+  | { kind: "bezier"; draft: PendingBezier };
+
+/** The selected curve's editing session: its lock, the selected point subset, and touch multi-select. */
+export type CurveSession = {
+  lockedId: string | null;
+  points: ReadonlySet<number>;
+  touchMultiple: boolean;
+};
+
+/** The freehand settings a new stroke takes; the session can hold its own values apart from the saved defaults. */
+export type NewStrokeSettings = Pick<AppSettings["canvas"], "freehandSimplificationUnits" | "freehandSmoothingUnits" | "freehandAutoApply" | "freehandPreserveOriginal">;
+
+/** The values a new stroke takes: the saved defaults under the session's own values. */
+export function newStrokeSettings(canvas: AppSettings["canvas"], session: Partial<NewStrokeSettings>): NewStrokeSettings {
+  const { freehandSimplificationUnits, freehandSmoothingUnits, freehandAutoApply, freehandPreserveOriginal } = canvas;
+  return { freehandSimplificationUnits, freehandSmoothingUnits, freehandAutoApply, freehandPreserveOriginal, ...session };
+}
+
+type SessionContext = {
+  tool: ToolMode;
+  variant: ConstructionVariant;
+  construction: Construction | null;
+  curve: CurveSession;
+  refinement: FreehandResultOffer | null;
+  newStrokes: Partial<NewStrokeSettings>;
+};
+
+type SessionEvent =
+  | { type: "tool.chosen"; tool: ToolMode; variant: ConstructionVariant }
+  | { type: "construction.set"; construction: Construction }
+  | { type: "construction.clear"; kind: Construction["kind"] }
+  | { type: "construction.cancel" }
+  | { type: "construction.finish" }
+  | { type: "selection.changed"; ids: ReadonlySet<string> }
+  | { type: "curve.lock"; id: string | null }
+  | { type: "curve.points"; points: ReadonlySet<number> }
+  | { type: "curve.touchMultiple"; on: boolean }
+  | { type: "refinement.offer"; offer: FreehandResultOffer }
+  | { type: "refinement.close" }
+  | { type: "refinement.cancel" }
+  | { type: "newStrokes.set"; values: Partial<NewStrokeSettings> }
+  | { type: "newStrokes.save" };
+
+const IDLE_CURVE: CurveSession = { lockedId: null, points: new Set(), touchMultiple: false };
+
+// The next pen contact makes a mark at once with these tools; Select and Lasso select; every other tool constructs.
