+++ b/packages/core/src/edit/color-value.ts
@@ -0,0 +1,13 @@
+/** Convert picker RGBA values into TikZ color and opacity options. */
+export function tikzColorValue(value: string): { color: string; opacity: number | null } {
+  const rgba = /^rgba\(\s*(\d+(?:\.\d+)?)\s*,\s*(\d+(?:\.\d+)?)\s*,\s*(\d+(?:\.\d+)?)\s*,\s*(\d*(?:\.\d+)?)\s*\)$/iu.exec(value.trim());
+  if (!rgba) return { color: value, opacity: null };
+  const channels = rgba.slice(1, 4).map((part) => Math.round(Math.max(0, Math.min(255, Number(part)))));
+  const opacity = Math.max(0, Math.min(1, Number(rgba[4])));
+  return { color: `{rgb,255:red,${channels[0]};green,${channels[1]};blue,${channels[2]}}`, opacity };
+}
+
+export function tikzColorOptions(key: "draw" | "fill" | "text", value: string): string[] {
+  const { color, opacity } = tikzColorValue(value);
+  return [`${key}=${color}`, ...(opacity === null ? [] : [`${key === "draw" ? "draw" : key === "fill" ? "fill" : "text"} opacity=${opacity}`])];
+}
