+import type { EditHandle } from "../semantic/types.js";
+import { ensureNodeSourceHasName } from "./node-naming.js";
+import type { EditParseOptions } from "./parse-options.js";
+import { parseStatementSnapshot } from "./statement-ops.js";
+
+export type NamedPoint = {
+  source: string;
+  /** The text a coordinate can reference the point by: `(A)` for a node, `(p1)` for a named path coordinate. */
+  reference: string;
+  insertedAt: number | null;
+};
+
+const GENERATED_POINT_NAME_RE = /\(p(\d+)(?:\.[^)]*)?\)/g;
+
+/**
+ * Names the point a handle stands on so a stroke can be written against it: a node by its
+ * name (generated when it has none) and a path coordinate by a `coordinate (pN)` written
+ * directly after it, or by the one already there.
+ */
+export function ensurePointHasName(source: string, handle: EditHandle, parseOptions: EditParseOptions): NamedPoint | null {
+  if (handle.kind === "node-position") {
+    const named = ensureNodeSourceHasName(source, handle.sourceRef.sourceId, parseOptions);
+    return named ? { source: named.source, reference: named.name, insertedAt: named.insertedSpan?.from ?? null } : null;
+  }
+  if (handle.kind !== "path-point") {
+    return null;
+  }
+  const span = handle.sourceRef.sourceSpan;
+  if (source.slice(span.from, span.to) !== handle.sourceText) {
+    return null;
+  }
+  const ref = parseStatementSnapshot(source, parseOptions).byId.get(handle.sourceRef.sourceId);
+  if (ref?.statement.kind !== "Path" || ref.statement.command === "node" || ref.statement.command === "coordinate") {
+    return null;
+  }
+  const items = ref.statement.items;
+  const index = items.findIndex((item) => item.kind === "Coordinate" && item.span.from === span.from && item.span.to === span.to);
+  if (index < 0) {
+    return null;
+  }
+  const next = items[index + 1];
+  if (next?.kind === "CoordinateOperation" && next.name) {
+    return { source, reference: next.name, insertedAt: null };
+  }
+  const name = nextGeneratedPointName(source);
+  const insertion = ` coordinate (${name})`;
+  return {
+    source: source.slice(0, span.to) + insertion + source.slice(span.to),
+    reference: name,
+    insertedAt: span.to
+  };
+}
+
+function nextGeneratedPointName(source: string): string {
+  const used = new Set<number>();
+  for (const match of source.matchAll(GENERATED_POINT_NAME_RE)) {
+    used.add(Number(match[1]));
+  }
+  let index = 1;
+  while (used.has(index)) {
+    index += 1;
+  }
+  return `p${index}`;
+}
