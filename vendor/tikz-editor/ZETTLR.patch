diff --git a/packages/app/src/ui/ShapeNumericEntry.tsx b/packages/app/src/ui/ShapeNumericEntry.tsx
new file mode 100644
index 00000000..657e96cd
--- /dev/null
+++ b/packages/app/src/ui/ShapeNumericEntry.tsx
@@ -0,0 +1,119 @@
+import { useState } from "react";
+import { worldPoint, pt } from "tikz-editor/coords/index";
+import { resolveFigureCoordinateFrame } from "tikz-editor/edit/coordinate-frame";
+import { applyMatrix } from "tikz-editor/semantic/transform";
+import { snapArcEndpointToLattice, snapToUnitLattice } from "tikz-editor/edit/snapping";
+import { PT_PER_CM } from "tikz-editor/edit/format";
+import { useSettingsStore } from "../settings/useSettingsStore";
+import { activeSnapRules } from "../settings/types";
+import { useEditorStore } from "../store/store";
+import { arcThroughThree, circleOnDiameter, circleThroughThree } from "./canvas-panel/geometry";
+import css from "./Toolbar.module.css";
+
+/** The Shapes picker choices that take their figure by numbers as well as by the pen. */
+const NUMERIC_CONSTRUCTIONS = ["addCircle:centre", "addCircle:diameter", "addCircle:three-points", "addArc:centre", "addArc:three-points"] as const;
+export type NumericConstruction = (typeof NUMERIC_CONSTRUCTIONS)[number];
+export function isNumericConstruction(choiceId: string): choiceId is NumericConstruction {
+  return (NUMERIC_CONSTRUCTIONS as readonly string[]).includes(choiceId);
+}
+
+const INITIAL_VALUES = { x: 0, y: 0, radius: 3, start: 0, end: 90, x2: 4, y2: 0, x3: 0, y3: 4 };
+type GeometryValues = typeof INITIAL_VALUES;
+type Field = { key: keyof GeometryValues; label: string };
+
+const CENTRE: Field[] = [{ key: "x", label: "Centre X" }, { key: "y", label: "Centre Y" }, { key: "radius", label: "Radius" }];
+const POINTS: Field[] = [
+  { key: "x", label: "Point 1 X" }, { key: "y", label: "Point 1 Y" },
+  { key: "x2", label: "Point 2 X" }, { key: "y2", label: "Point 2 Y" },
+  { key: "x3", label: "Point 3 X" }, { key: "y3", label: "Point 3 Y" }
+];
+const FIELDS: Record<NumericConstruction, Field[]> = {
+  "addCircle:centre": CENTRE,
+  "addCircle:diameter": POINTS.slice(0, 4),
+  "addCircle:three-points": POINTS,
+  "addArc:centre": [...CENTRE, { key: "start", label: "Start angle (°)" }, { key: "end", label: "End angle (°)" }],
+  "addArc:three-points": POINTS
+};
+
+const isInteger = (value: number) => Math.abs(value - Math.round(value)) <= 1e-7;
+
+/**
+ * The circle or arc of the chosen construction by numbers, in figure coordinates (GeoGebra's
+ * Circle with Center and Radius tool; Inkscape's ellipse tool Start and End fields). Insert
+ * writes it to the source and closes the menu.
+ */
+export function ShapeNumericEntry({ construction, onInserted }: { construction: NumericConstruction; onInserted: () => void }) {
+  const source = useEditorStore((state) => state.source);
+  const activeFigureId = useEditorStore((state) => state.activeFigureId);
+  const dispatch = useEditorStore((state) => state.dispatch);
+  const strokeColor = useEditorStore((state) => state.creationStrokeColor);
+  const fillColor = useEditorStore((state) => state.creationFillColor);
+  const latticeLock = useSettingsStore((state) => activeSnapRules(state.settings.canvas).latticeLock);
+  const [drafts, setDrafts] = useState<{ [Key in keyof GeometryValues]: string }>(() =>
+    Object.fromEntries(Object.entries(INITIAL_VALUES).map(([key, value]) => [key, String(value)])) as { [Key in keyof GeometryValues]: string });
+  const [error, setError] = useState<string | null>(null);
+  const fields = FIELDS[construction];
+  const arc = construction.startsWith("addArc");
+
+  const insert = () => {
+    const values = Object.fromEntries(Object.entries(drafts).map(([key, value]) => [key, Number(value)])) as GeometryValues;
+    if (fields.some(({ key }) => !drafts[key].trim() || !Number.isFinite(values[key]))) { setError("Complete each field with a finite number."); return; }
+    const points = fields.filter(({ label }) => label.startsWith("Point")).map(({ key }) => values[key]);
+    if (latticeLock && !points.every(isInteger)) { setError("Enter lattice points, or turn off the Lattice snapping rule."); return; }
+    const first = { x: values.x, y: values.y }, second = { x: values.x2, y: values.y2 }, third = { x: values.x3, y: values.y3 };
+    let { x, y, radius } = values;
+    let startAngle = values.start, endAngle = values.end;
+    if (construction !== "addCircle:centre" && construction !== "addArc:centre") {
+      const circle = construction === "addCircle:diameter" ? circleOnDiameter(first, second) : circleThroughThree(first, second, third);
+      if (!circle) { setError("Choose three distinct points that are not on one line."); return; }
+      ({ x, y } = circle.center);
+      radius = circle.radius;
+      if (construction === "addArc:three-points") {
+        const turn = arcThroughThree(circle.center, first, second, third);
+        startAngle = turn.startAngle;
+        endAngle = turn.startAngle + turn.sweep;
+      } else if (latticeLock && !(isInteger(x) && isInteger(y))) {
+        setError("This circle has a fractional centre. Choose points with a lattice centre, or turn off the Lattice snapping rule."); return;
+      }
+    }
+    if (!(radius > 0)) { setError("Radius must be positive."); return; }
+    let at = worldPoint(pt(x * PT_PER_CM), pt(y * PT_PER_CM));
+    const onCircle = (angle: number) => worldPoint(pt((x + radius * Math.cos(angle * Math.PI / 180)) * PT_PER_CM), pt((y + radius * Math.sin(angle * Math.PI / 180)) * PT_PER_CM));
+    let start = construction === "addArc:three-points" ? worldPoint(pt(first.x * PT_PER_CM), pt(first.y * PT_PER_CM)) : onCircle(startAngle);
+    let end = construction === "addArc:three-points" ? worldPoint(pt(third.x * PT_PER_CM), pt(third.y * PT_PER_CM)) : onCircle(endAngle);
+    if (latticeLock && (construction === "addCircle:centre" || construction === "addArc:centre")) {
+      at = snapToUnitLattice(at);
+      x = at.x / PT_PER_CM; y = at.y / PT_PER_CM;
+      radius = Math.max(1, Math.round(radius));
+      if (arc) {
+        const east = onCircle(0);
+        const snappedStart = snapArcEndpointToLattice(at, east, onCircle(values.start));
+        const snappedEnd = snapArcEndpointToLattice(at, east, onCircle(values.end));
+        if (snappedStart.kind === "unavailable" || snappedEnd.kind === "unavailable") { setError("No exact lattice endpoint is available for this radius."); return; }
+        start = snappedStart.point; end = snappedEnd.point;
+        const angleOf = (point: typeof at, requested: number) => { const angle = Math.atan2(point.y - at.y, point.x - at.x) * 180 / Math.PI; return angle + 360 * Math.round((requested - angle) / 360); };
+        startAngle = angleOf(start, values.start); endAngle = angleOf(end, values.end);
+      }
+    }
+    const circleEdge = construction === "addCircle:centre" ? onCircle(0) : worldPoint(pt(first.x * PT_PER_CM), pt(first.y * PT_PER_CM));
+    const frame = resolveFigureCoordinateFrame(source, { activeFigureId });
+    dispatch({ type: "APPLY_EDIT_ACTION", action: { kind: "addElement", at: applyMatrix(frame, at),
+      template: arc ? { kind: "arc", start: applyMatrix(frame, start), end: applyMatrix(frame, end), startAngle, endAngle, strokeColor } : { kind: "circle", edge: applyMatrix(frame, circleEdge), strokeColor, fillColor }
+    } });
+    setError(null);
+    onInserted();
+  };
+
+  // Positions and the radius are figure coordinates, which TikZ writes as bare numbers.
+  return <div className={css.numericEntry}>
+    {fields.map(({ key, label }) => <label className={css.numberField} key={key}>
+      <span>{label}</span>
+      <input type="text" inputMode="decimal" aria-label={label} value={drafts[key]}
+        onChange={(event) => { const value = event.currentTarget.value; setDrafts((previous) => ({ ...previous, [key]: value })); }} />
+    </label>)}
+    <div className={css.menuActions}>
+      <button type="button" onClick={insert}>Insert {arc ? "arc" : "circle"}</button>
+    </div>
+    {error && <p role="alert">{error}</p>}
+  </div>;
+}
