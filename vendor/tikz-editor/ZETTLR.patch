--- /dev/null
+++ b/packages/app/src/ui/canvas-panel/semantic-curve-edit.ts
@@ -0,0 +1,188 @@
+import { originalStrokes } from "../../original-ink";
+import { applyEditAction, type EditAction } from "tikz-editor/edit/actions";
+import { resolveEligibleExplicitPath, resolveActivePathPointHandle, resolvePathControlHandle } from "tikz-editor/edit/path-editing";
+import { applyMatrix, inverseMatrix } from "tikz-editor/semantic/transform";
+import { pt, worldPoint } from "tikz-editor/coords/index";
+import { PT_PER_CM, formatNumber } from "tikz-editor/edit/format";
+import type { EditHandle } from "tikz-editor/semantic/types";
+import { renderTikzToSvg } from "tikz-editor/render/index";
+
+export type SemanticCurveEditResult = { kind: "success"; source: string } | { kind: "unsupported"; reason: string };
+
+function endpointEdit(source: string, elementId: string, handle: EditHandle, all: EditHandle[], operation: "delete" | "smooth", activeFigureId: string | null): SemanticCurveEditResult | null {
+  const resolved = resolveEligibleExplicitPath(source, elementId, { activeFigureId });
+  if (resolved.kind !== "eligible") return null;
+  const analysis = resolved.analysis;
+  const selected = resolveActivePathPointHandle(all, analysis, handle.id, source);
+  if (selected.kind !== "found") return { kind: "unsupported", reason: selected.reason };
+  if (analysis.closed && operation === "smooth") {
+    const index = selected.anchorIndex;
+    const previous = analysis.segments.find((segment) => segment.endAnchorIndex === index);
+    const next = analysis.segments.find((segment) => segment.startAnchorIndex === index);
+    if (!previous || !next) return { kind: "unsupported", reason: "The closed curve node has no cyclic neighbors." };
+    const node = (anchorIndex: number) => all.find((item) => item.kind === "path-point" && item.sourceRef.sourceId === elementId && item.sourceRef.sourceSpan.from === analysis.anchors[anchorIndex].item.span.from);
+    const before = node(previous.startAnchorIndex), after = node(next.endAnchorIndex);
+    if (!before || !after) return { kind: "unsupported", reason: "The cyclic neighboring nodes could not be resolved." };
+    const inverse = inverseMatrix(handle.transform);
+    if (!inverse) return { kind: "unsupported", reason: "The closed curve node has a singular source frame." };
+    const format = (x: number, y: number) => {
+      const local = applyMatrix(inverse, worldPoint(pt(x), pt(y)));
+      return `(${formatNumber(local.x / PT_PER_CM)},${formatNumber(local.y / PT_PER_CM)})`;
+    };
+    const tangentX = (after.world.x - before.world.x) / 6, tangentY = (after.world.y - before.world.y) / 6;
+    const incoming = format(handle.world.x - tangentX, handle.world.y - tangentY);
+    const outgoing = format(handle.world.x + tangentX, handle.world.y + tangentY);
+    const replacements: Array<{ from: number; to: number; text: string }> = [];
+    for (const [segment, incomingSide] of [[previous, true], [next, false]] as const) {
+      if (segment.kind === "cubic") {
+        const coordinate = analysis.statement.items[incomingSide ? segment.control2Index : segment.control1Index];
+        if (coordinate.kind !== "Coordinate" || !resolvePathControlHandle(all, elementId, coordinate, source)) return { kind: "unsupported", reason: "A cyclic control is not safely editable." };
+        replacements.push({ ...coordinate.span, text: incomingSide ? incoming : outgoing });
+      } else {
+        const operator = analysis.statement.items[segment.operatorIndex].span;
+        const first = incomingSide ? format(before.world.x + (handle.world.x - before.world.x) / 3, before.world.y + (handle.world.y - before.world.y) / 3) : outgoing;
+        const last = incomingSide ? incoming : format(after.world.x + (handle.world.x - after.world.x) / 3, after.world.y + (handle.world.y - after.world.y) / 3);
+        replacements.push({ ...operator, text: `.. controls ${first} and ${last} ..` });
+      }
+    }
+    let nextSource = source;
+    for (const replacement of replacements.sort((left, right) => right.from - left.from)) nextSource = nextSource.slice(0, replacement.from) + replacement.text + nextSource.slice(replacement.to);
+    return { kind: "success", source: nextSource };
+  }
+  if (analysis.closed) return null;
+  const index = selected.anchorIndex;
+  if (index !== 0 && index !== analysis.anchors.length - 1) return null;
+  const edge = index === 0 ? analysis.segments[0] : analysis.segments[analysis.segments.length - 1];
+  if (!edge) return { kind: "unsupported", reason: "This endpoint has no surviving curve segment." };
+  const absolute = (coordinate: EditHandle) => {
+    const inverse = inverseMatrix(coordinate.transform);
+    if (!inverse) return null;
+    const local = applyMatrix(inverse, coordinate.world);
+    return `(${formatNumber(local.x / PT_PER_CM)},${formatNumber(local.y / PT_PER_CM)})`;
+  };
+  if (operation === "delete") {
+    if (analysis.anchors.length <= 2) {
+      const result = applyEditAction(source, all, { kind: "deleteElements", elementIds: [elementId] }, { parseOptions: { activeFigureId } });
+      return result.kind === "success" ? { kind: "success", source: result.newSource } : { kind: "unsupported", reason: result.kind === "error" ? result.message : result.reason };
+    }
+    if (index > 0) {
+      const from = analysis.statement.items[edge.operatorIndex].span.from;
+      const to = analysis.anchors[index].item.span.to;
+      return { kind: "success", source: source.slice(0, from) + source.slice(to) };
+    }
+    const nextAnchor = analysis.anchors[1];
+    const nextHandle = all.find((candidate) => candidate.kind === "path-point" && candidate.sourceRef.sourceId === elementId && candidate.sourceRef.sourceSpan.from === nextAnchor.item.span.from);
+    if (!nextHandle) return { kind: "unsupported", reason: "The new starting node could not be resolved." };
+    const replacement = nextHandle.relativePrefix ? absolute(nextHandle) : nextAnchor.raw;
+    if (!replacement) return { kind: "unsupported", reason: "The new starting node has a singular source frame." };
+    const from = analysis.anchors[0].item.span.from, to = nextAnchor.item.span.to;
+    const candidate = source.slice(0, from) + replacement + source.slice(to);
+    const delta = replacement.length - (to - from);
+    const rendered = renderTikzToSvg(candidate, { parse: { activeFigureId } });
+    const repairs: Array<{ from: number; to: number; text: string }> = [];
+    for (const original of all.filter((item) => item.sourceRef.sourceId === elementId && item.sourceRef.sourceSpan.from >= to && (item.kind === "path-point" || item.kind === "path-control"))) {
+      const span = original.sourceRef.sourceSpan;
+      const current = rendered.semantic.editHandles.find((item) => item.sourceRef.sourceId === elementId && item.sourceRef.sourceSpan.from === span.from + delta && item.sourceRef.sourceSpan.to === span.to + delta);
+      if (!current) return { kind: "unsupported", reason: "Deleting the starting node would affect unresolved authored coordinates." };
+      if (Math.hypot(current.world.x - original.world.x, current.world.y - original.world.y) < 1e-5) continue;
+      const text = absolute(original);
+      if (!original.relativePrefix || !text) return { kind: "unsupported", reason: "Deleting the starting node would change an authored coordinate that cannot be preserved." };
+      repairs.push({ from: span.from + delta, to: span.to + delta, text });
+    }
+    let next = candidate;
+    for (const repair of repairs.sort((left, right) => right.from - left.from)) next = next.slice(0, repair.from) + repair.text + next.slice(repair.to);
+    return { kind: "success", source: next };
+  }
+  const neighborAnchor = analysis.anchors[index === 0 ? 1 : index - 1];
+  const neighbor = all.find((item) => item.kind === "path-point" && item.sourceRef.sourceId === elementId && item.sourceRef.sourceSpan.from === neighborAnchor.item.span.from);
+  if (!neighbor) return { kind: "unsupported", reason: "The endpoint neighbor could not be resolved." };
+  if (edge.kind === "cubic") {
+    const item = analysis.statement.items[index === 0 ? edge.control1Index : edge.control2Index];
+    if (item.kind !== "Coordinate") return { kind: "unsupported", reason: "The endpoint control is not an authored coordinate." };
+    const control = resolvePathControlHandle(all, elementId, item, source);
+    if (!control) return { kind: "unsupported", reason: "The endpoint control could not be resolved." };
+    const position = worldPoint(pt(handle.world.x + (neighbor.world.x - handle.world.x) / 3), pt(handle.world.y + (neighbor.world.y - handle.world.y) / 3));
+    const result = applyEditAction(source, all, { kind: "moveHandle", handleId: control.id, newWorld: position }, { parseOptions: { activeFigureId } });
+    return result.kind === "success" ? { kind: "success", source: result.newSource } : { kind: "unsupported", reason: result.kind === "error" ? result.message : result.reason };
+  }
+  const first = index === 0 ? handle : neighbor, last = index === 0 ? neighbor : handle;
+  const inverse = inverseMatrix(handle.transform);
+  if (!inverse) return { kind: "unsupported", reason: "The endpoint has a singular source frame." };
+  const localFirst = applyMatrix(inverse, first.world), localLast = applyMatrix(inverse, last.world);
+  const format = (t: number) => `(${formatNumber((localFirst.x + (localLast.x - localFirst.x) * t) / PT_PER_CM)},${formatNumber((localFirst.y + (localLast.y - localFirst.y) * t) / PT_PER_CM)})`;
+  const operator = analysis.statement.items[edge.operatorIndex].span;
+  return { kind: "success", source: source.slice(0, operator.from) + `.. controls ${format(1 / 3)} and ${format(2 / 3)} ..` + source.slice(operator.to) };
+}
+
+/** Compose edits against recomputed handles and commit the whole gesture atomically. */
+export function editSemanticCurveNodes(
+  source: string,
+  elementId: string,
+  selectedIndices: ReadonlySet<number>,
+  operation: "delete" | "smooth",
+  autoSmooth: boolean,
+  activeFigureId: string | null,
+  lockedElementIds: ReadonlySet<string>
+): SemanticCurveEditResult {
+  if (lockedElementIds.has(elementId)) return { kind: "unsupported", reason: "This curve is locked." };
+  let nextSource = source;
+  const handlesFor = (input: string) => {
+    const rendered = renderTikzToSvg(input, { parse: { activeFigureId } });
+    return {
+      scene: rendered.semantic.scene,
+      all: rendered.semantic.editHandles,
+      nodes: rendered.semantic.editHandles.filter((handle) => handle.kind === "path-point" && handle.sourceRef.sourceId === elementId)
+        .sort((left, right) => left.sourceRef.sourceSpan.from - right.sourceRef.sourceSpan.from)
+    };
+  };
+  const original = handlesFor(source);
+  const indices = selectedIndices.size > 0 ? [...selectedIndices] : operation === "smooth"
+    ? original.nodes.map((_, index) => index) : [];
+  if (indices.length === 0) return { kind: "unsupported", reason: "Select editable interior curve nodes." };
+  if (indices.some((index) => index < 0 || index >= original.nodes.length)) return { kind: "unsupported", reason: "The selected curve nodes are stale." };
+  if (operation === "delete" && original.nodes.length - indices.length < 2) {
+    const selected = original.scene.elements.find((element) => element.sourceRef.sourceId === elementId);
+    if (!selected) return { kind: "unsupported", reason: "The selected curve could not be resolved." };
+    const span = selected.sourceRef.sourceSpan;
+    const envelope = originalStrokes(source).find((entry) => span.from >= entry.drawingFrom && span.to <= entry.drawingTo);
+    if (envelope) {
+      if (original.scene.elements.some((element) => lockedElementIds.has(element.sourceRef.sourceId) && element.sourceRef.sourceSpan.from >= envelope.drawingFrom && element.sourceRef.sourceSpan.to <= envelope.drawingTo)) {
+        return { kind: "unsupported", reason: "The original stroke contains a locked element." };
+      }
+      return { kind: "success", source: source.slice(0, envelope.from) + source.slice(envelope.to) };
+    }
+    const deletion = applyEditAction(source, original.all, { kind: "deleteElements", elementIds: [elementId] }, { parseOptions: { activeFigureId } });
+    return deletion.kind === "success" ? { kind: "success", source: deletion.newSource }
+      : { kind: "unsupported", reason: deletion.kind === "error" ? deletion.message : deletion.reason };
+  }
+  const perform = (index: number, kind: "delete" | "smooth"): SemanticCurveEditResult => {
+    const handles = handlesFor(nextSource);
+    const handle = handles.nodes[index];
+    if (!handle) return { kind: "unsupported", reason: "The selected curve node could not be resolved." };
+    const endpoint = endpointEdit(nextSource, elementId, handle, handles.all, kind, activeFigureId);
+    if (endpoint) { if (endpoint.kind === "success") nextSource = endpoint.source; return endpoint; }
+    const action: EditAction = kind === "delete"
+      ? { kind: "deletePathPoint", elementId, handleId: handle.id }
+      : { kind: "setPathPointKind", elementId, handleId: handle.id, pointKind: "smooth" };
+    const result = applyEditAction(nextSource, handles.all, action, { parseOptions: { activeFigureId } });
+    if (result.kind !== "success") return { kind: "unsupported", reason: result.kind === "error" ? result.message : result.reason };
+    nextSource = result.newSource;
+    return { kind: "success", source: nextSource };
+  };
+  const originalCount = handlesFor(nextSource).nodes.length;
+  for (const index of indices.sort((left, right) => right - left)) {
+    const result = perform(index, operation);
+    if (result.kind !== "success") return result;
+  }
+  if (operation === "delete" && autoSmooth) {
+    // Only the surviving neighbours of deleted nodes are smoothed; every other node keeps its tangent.
+    const deleted = new Set(indices);
+    const survivors = Array.from({ length: originalCount }, (_, index) => index).filter((index) => !deleted.has(index));
+    const neighbours = survivors.flatMap((original, position) => deleted.has(original - 1) || deleted.has(original + 1) ? [position] : []);
+    for (const position of neighbours.reverse()) {
+      const result = perform(position, "smooth");
+      if (result.kind !== "success") return result;
+    }
+  }
+  return { kind: "success", source: nextSource };
+}
