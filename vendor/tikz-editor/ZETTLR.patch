diff --git a/packages/app/src/settings/keybindings.ts b/packages/app/src/settings/keybindings.ts
new file mode 100644
index 00000000..d369d5af
--- /dev/null
+++ b/packages/app/src/settings/keybindings.ts
@@ -0,0 +1,132 @@
+import { z } from "zod";
+import { APP_MENU_COMMAND_IDS as ID, APP_MENU_DEFINITION, type AppMenuCommandId, type AppMenuItem } from "../app-menu";
+
+export type ShortcutOverrides = Partial<Record<AppMenuCommandId, string[]>>;
+export type ShortcutEvent = Pick<KeyboardEvent, "key" | "ctrlKey" | "metaKey" | "altKey" | "shiftKey">;
+export type ShortcutCommand = { id: AppMenuCommandId; label: string; defaults: string[]; embedded: boolean };
+
+const embeddedViewCommands = new Set<AppMenuCommandId>([
+  ID.FIT_TO_CONTENT, ID.ZOOM_IN, ID.ZOOM_OUT, ID.TOGGLE_GRID, ID.TOGGLE_OUTPUT_BOUNDS,
+  ID.TOGGLE_LATTICE_LOCK, ID.TOGGLE_SNAP_OBJECTS, ID.TOGGLE_SNAP_ALIGNMENT,
+  ID.TOGGLE_RULERS, ID.TOGGLE_GUIDES, ID.TOGGLE_INSPECTOR_PANEL, ID.TOGGLE_OBJECTS_PANEL, ID.OPEN_SETTINGS
+]);
+// App-owned shortcuts keep their existing routes, even without a canvas Settings row.
+const GLOBAL_SHORTCUT_COMMAND_IDS = new Set<AppMenuCommandId>([
+  ID.NEW_DOCUMENT, ID.OPEN_DOCUMENT, ID.SAVE_DOCUMENT, ID.CLOSE_DOCUMENT,
+  ID.FORMAT_TIKZ, ID.TOGGLE_ASSISTANT_PANEL
+]);
+export function isShortcutCommandInScope(command: ShortcutCommand, embedded: boolean): boolean {
+  return !embedded || command.embedded || GLOBAL_SHORTCUT_COMMAND_IDS.has(command.id);
+}
+
+const commands = new Map<AppMenuCommandId, ShortcutCommand>();
+function collect(items: readonly AppMenuItem[]): void {
+  for (const item of items) {
+    if (item.kind === "submenu") { collect(item.items); continue; }
+    if (item.kind !== "command") continue;
+    const existing = commands.get(item.commandId);
+    if (existing) {
+      if (item.accelerator && !existing.defaults.includes(item.accelerator)) existing.defaults.push(item.accelerator);
+      continue;
+    }
+    const embedded = /^(edit|path|tree|matrix|node|insert)\./.test(item.commandId) && item.commandId !== ID.FORMAT_TIKZ || embeddedViewCommands.has(item.commandId);
+    commands.set(item.commandId, {
+      id: item.commandId, label: item.label.replace(/\.\.\.$|…$/u, ""),
+      defaults: item.accelerator ? [item.accelerator] : [], embedded
+    });
+  }
+}
+for (const section of APP_MENU_DEFINITION) collect(section.items);
+const contextCommands: readonly [AppMenuCommandId, string, readonly string[]][] = [
+  [ID.SELECT_ALL, "Select All", ["CmdOrCtrl+A"]], [ID.EDIT_EQUATION, "Edit Equation", ["CmdOrCtrl+Shift+E"]],
+  [ID.ADD_LABEL, "Add Label", []], [ID.ADD_PIN, "Add Pin", []],
+  [ID.PATH_SIMPLIFY, "Simplify Path", []],
+  [ID.TREE_ADD_CHILD, "Add Tree Child", []], [ID.TREE_ADD_SIBLING_BEFORE, "Add Tree Sibling Before", []],
+  [ID.TREE_ADD_SIBLING_AFTER, "Add Tree Sibling After", []],
+  [ID.MATRIX_ADD_ROW_END, "Add Matrix Row", []], [ID.MATRIX_ADD_COLUMN_END, "Add Matrix Column", []],
+  [ID.MATRIX_INSERT_ROW_ABOVE, "Insert Matrix Row Above", []], [ID.MATRIX_INSERT_ROW_BELOW, "Insert Matrix Row Below", []],
+  [ID.MATRIX_INSERT_COLUMN_LEFT, "Insert Matrix Column Left", []], [ID.MATRIX_INSERT_COLUMN_RIGHT, "Insert Matrix Column Right", []],
+  [ID.MATRIX_REMOVE_ROW, "Remove Matrix Row", []], [ID.MATRIX_REMOVE_COLUMN, "Remove Matrix Column", []],
+  [ID.MATRIX_TRANSPOSE, "Transpose Matrix", []],
+  [ID.NODE_POSITION_RELATIVE_TO, "Position Node Relative To", []], [ID.NODE_CONVERT_TO_ABSOLUTE, "Convert Node to Absolute Position", []],
+  [ID.TOGGLE_GEOMETRY_CONSTRAINT, "Constrain geometry", []],
+  [ID.TOOL_SELECT, "Select", ["V"]], [ID.TOOL_LASSO, "Lasso", []], [ID.TOOL_ERASER, "Eraser", []],
+  [ID.TOOL_MAGNIFY, "Magnify", ["M"]], [ID.TOOL_BUCKET, "Bucket", []],
+  [ID.INSERT_ARC, "Arc", []], [ID.INSERT_POINT, "Point", []], [ID.INSERT_IMAGE, "Image", []]
+];
+for (const [id, label, defaults] of contextCommands) commands.set(id, { id, label, defaults: [...defaults], embedded: id !== ID.TOOL_MAGNIFY });
+commands.set(ID.CLEAR_RECENT_FILES, { id: ID.CLEAR_RECENT_FILES, label: "Clear Recent Files", defaults: [], embedded: false });
+// Context commands without a menu accelerator keep the same common defaults.
+for (const [id, shortcuts] of [[ID.SELECT_ALL, ["CmdOrCtrl+A"]], [ID.FIT_TO_CONTENT, ["CmdOrCtrl+0"]],
+  [ID.OPEN_DOCUMENT, ["CmdOrCtrl+O"]], [ID.ZOOM_IN, ["CmdOrCtrl+=", "CmdOrCtrl+Shift+="]], [ID.DELETE, ["Delete", "Backspace"]],
+  [ID.EDIT_EQUATION, ["CmdOrCtrl+Shift+E"]]] as const) {
+  const command = commands.get(id);
+  if (command) command.defaults = [...shortcuts];
+}
+const layers = commands.get(ID.TOGGLE_OBJECTS_PANEL);
+if (layers) layers.label = "Layers";
+const properties = commands.get(ID.TOGGLE_INSPECTOR_PANEL);
+if (properties) properties.label = "Properties";
+const curve = commands.get(ID.INSERT_BEZIER);
+if (curve) curve.label = "Curve";
+
+export const SHORTCUT_COMMANDS: readonly ShortcutCommand[] = [...commands.values()];
+const overrideSchema = z.record(z.string(), z.array(z.string().min(1)));
+export function parseShortcutOverrides(value: unknown): ShortcutOverrides {
+  const parsed = overrideSchema.safeParse(value);
+  if (!parsed.success) return {};
+  return Object.fromEntries(Object.entries(parsed.data).filter(([id, shortcuts]) =>
+    commands.has(id as AppMenuCommandId) && shortcuts.every(shortcut => shortcutParts(shortcut) !== null)));
+}
+export function shortcutsFor(id: AppMenuCommandId, overrides: ShortcutOverrides): readonly string[] {
+  return overrides[id] ?? commands.get(id)?.defaults ?? [];
+}
+function shortcutParts(shortcut: string): { key: string; modifiers: Set<string> } | null {
+  const parts = shortcut.split("+");
+  const key = parts.pop()?.toLowerCase();
+  if (!key || parts.some(part => !["CmdOrCtrl", "Ctrl", "Meta", "Alt", "Shift"].includes(part))) return null;
+  return { key, modifiers: new Set(parts) };
+}
+export function matchesShortcut(shortcut: string, event: ShortcutEvent): boolean {
+  const parsed = shortcutParts(shortcut);
+  if (!parsed) return false;
+  const { key, modifiers } = parsed;
+  return key === (event.key === " " ? "space" : event.key === "+" ? "=" : event.key.toLowerCase()) &&
+    (modifiers.has("CmdOrCtrl") ? (event.ctrlKey || event.metaKey) && !(event.ctrlKey && event.metaKey)
+      : event.ctrlKey === modifiers.has("Ctrl") && event.metaKey === modifiers.has("Meta")) &&
+    event.altKey === modifiers.has("Alt") && event.shiftKey === modifiers.has("Shift");
+}
+export function matchesCommand(id: AppMenuCommandId, event: ShortcutEvent, overrides: ShortcutOverrides): boolean {
+  return shortcutsFor(id, overrides).some(shortcut => matchesShortcut(shortcut, event));
+}
+export function recordShortcut(event: ShortcutEvent): string | null {
+  if (["Control", "Meta", "Alt", "Shift", "Dead", "Unidentified"].includes(event.key)) return null;
+  if (event.key === "Escape") return null;
+  const modifiers = [event.ctrlKey && event.metaKey ? "Ctrl+Meta" : event.ctrlKey || event.metaKey ? "CmdOrCtrl" : "",
+    event.altKey ? "Alt" : "", event.shiftKey ? "Shift" : ""].filter(Boolean);
+  const key = event.key === " " ? "Space" : event.key === "+" ? "=" : event.key.length === 1 ? event.key.toUpperCase() : event.key;
+  return [...modifiers, key].join("+");
+}
+export function shortcutLabel(shortcut: string): string {
+  const mac = typeof navigator !== "undefined" && /Mac|iPhone|iPad/i.test(navigator.platform);
+  return shortcut.replace("CmdOrCtrl", mac ? "Cmd" : "Ctrl");
+}
+export function shortcutConflict(id: AppMenuCommandId, shortcut: string, overrides: ShortcutOverrides, embedded: boolean): ShortcutCommand | undefined {
+  const parts = shortcutParts(shortcut);
+  if (!parts) return undefined;
+  const controlKeys = parts.modifiers.has("CmdOrCtrl")
+    ? [{ ctrlKey: true, metaKey: false }, { ctrlKey: false, metaKey: true }]
+    : [{ ctrlKey: parts.modifiers.has("Ctrl"), metaKey: parts.modifiers.has("Meta") }];
+  const events = controlKeys.map(keys => ({ key: parts.key, ...keys,
+    altKey: parts.modifiers.has("Alt"), shiftKey: parts.modifiers.has("Shift") }));
+  return SHORTCUT_COMMANDS.find(command => {
+    if (command.id === id || !isShortcutCommandInScope(command, embedded)) return false;
+    return events.some(event => {
+      if (!matchesCommand(command.id, event, overrides)) return false;
+      // Edit and Insert Equation intentionally share their shipped contextual shortcut.
+      const sharedDefault = commands.get(id)?.defaults.some(binding => matchesShortcut(binding, event)) &&
+        overrides[command.id] === undefined && command.defaults.some(binding => matchesShortcut(binding, event));
+      return !sharedDefault;
+    });
+  });
+}
