+    case "addArc": return variant.arc === "three-points" ? "Arc through three points" : "Arc";
+    case "addCircle": return variant.circle === "three-points" ? "Circle through three points" : variant.circle === "diameter" ? "Circle on a diameter" : "Circle";
+    case "addLine": return "Line";
+    case "addArrow": return "Arrow";
+    case "addPath": return "Path";
+    case "addBezier": return "Curve";
+    case "addPoint": return "Point";
+    case "addEllipse": return "Ellipse";
+    case "addRect": return "Rectangle";
+    case "addGrid": return "Grid";
+    case "addShape": return "Node shape";
+    case "addMatrix": return "Matrix";
+    case "addNode": return "Text";
+    case "addImage": return "Image";
