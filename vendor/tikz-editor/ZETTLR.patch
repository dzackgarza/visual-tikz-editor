+  font: 14px var(--font-ui);
+  cursor: pointer;
+}
+
+.reapply:focus-visible {
+  outline: 2px solid #9e2a2b;
+  outline-offset: 2px;
+}
+.rangeControls {
+  position: fixed;
+  z-index: 190;
+  display: grid;
+  gap: 6px;
+  width: 280px;
+  max-width: calc(100vw - 24px);
