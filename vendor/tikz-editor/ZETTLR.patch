+describe('a move gesture written from its base source', () => {
+  const mergeKey = 'drag-element:path:1:7';
+  const step = (
+    state: ReturnType<typeof makeInitialState>,
+    precomputedSource: string,
+    newSource: string,
+    precomputedAgainstGestureBase = true
+  ) =>
+    editorReducer(state, {
+      type: 'APPLY_EDIT_ACTION',
+      action: { kind: 'moveElements', elementIds: ['path:1'], delta: wp(0, 0) },
+      historyMergeKey: mergeKey,
+      precomputedSource,
+      precomputedAgainstGestureBase,
+      precomputedResult: { kind: 'success', newSource, patches: [] }
+    });
+
+  it('accepts each step precomputed against the source the gesture started from and patches the current source', () => {
+    const initial = makeInitialState();
+    const base = initial.source;
+    const first = `${base}\n\\draw (0.33,0) -- (1,0);`;
+    const second = `${base}\n\\draw (0.5,0) -- (1,0);`;
+    const afterSecond = step(step(initial, base, first), base, second);
+    expect(afterSecond.source).toBe(second);
+    expect(afterSecond.history).toHaveLength(initial.history.length + 1);
+    const entry = afterSecond.history[afterSecond.historyIndex];
+    expect(entry?.sourceBefore).toBe(base);
+    expect(entry?.sourceAfter).toBe(second);
+    const patches = afterSecond.lastEditPatches;
+    expect(patches).toHaveLength(1);
+    const patch = patches![0]!;
+    expect(first.slice(0, patch.oldSpan.from) + patch.replacement + first.slice(patch.oldSpan.to)).toBe(second);
+  });
+
+  it('does not accept a step precomputed against a source that is neither current nor the gesture base', () => {
+    const initial = makeInitialState();
+    const base = initial.source;
+    const first = `${base}\n\\draw (0.33,0) -- (1,0);`;
+    const afterFirst = step(initial, base, first);
+    const stale = step(afterFirst, `${base}\n% elsewhere`, `${base}\n\\draw (2,0) -- (3,0);`);
+    expect(stale.source).toBe(first);
+  });
+
+  it('does not let a per-element write that shares the merge key replace the steps before it', () => {
+    // A group scale writes one property per element against the source it closed over; the second
+    // element's result must not stand in for the first's.
+    const initial = makeInitialState();
+    const base = initial.source;
+    const first = `${base}\n\\draw (0.33,0) -- (1,0);`;
+    const afterFirst = step(initial, base, first);
+    const perElement = step(afterFirst, base, `${base}\n\\draw (0.5,0) -- (1,0);`, false);
+    expect(perElement.source).toBe(first);
+  });
+});
