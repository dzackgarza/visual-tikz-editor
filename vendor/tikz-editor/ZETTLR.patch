+++ b/packages/app/src/ui/SnapControl.tsx
@@ -0,0 +1,46 @@
+import { useState } from "react";
+import type { SnapRuleKey } from "../settings/types";
+import { useSettingsStore } from "../settings/useSettingsStore";
+import { ToolbarToolPopup, ToolbarPopupSection } from "./ToolbarToolPopup";
+import css from "./SnapControl.module.css";
+
+/** The snapping rules in precedence order. */
+const SNAP_RULES: readonly { key: SnapRuleKey; label: string }[] = [
+  { key: "latticeLock", label: "Lattice" },
+  { key: "snapObjects", label: "Objects" },
+  { key: "snapAlignment", label: "Alignment" },
+  { key: "constrainGeometry", label: "Angle" }
+];
+
+/**
+ * Inkscape's snap toolbar (share/ui/toolbar-snap.ui): a toggle that turns all
+ * snapping on or off, and a button beside it that opens the rules. While
+ * snapping is off the rules keep their states and are disabled, as Inkscape
+ * disables them (actions-canvas-snapping.cpp, set_actions_canvas_snapping).
+ */
+export function SnapControl({ triggerClassName, activeClassName }: { triggerClassName: string; activeClassName: string }) {
+  const [open, setOpen] = useState(false);
+  const canvas = useSettingsStore((state) => state.settings.canvas);
+  const updateCanvasSettings = useSettingsStore((state) => state.updateCanvasSettings);
+
+  return <>
+    <button type="button" className={`${triggerClassName} ${canvas.snapping ? activeClassName : ""}`}
+      aria-pressed={canvas.snapping} onClick={() => updateCanvasSettings({ snapping: !canvas.snapping })}>
+      Snap
+    </button>
+    <ToolbarToolPopup open={open} onClose={() => setOpen(false)} popup={
+      <ToolbarPopupSection title="Snapping">
+        <div className={css.rules}>{SNAP_RULES.map((rule) => (
+          <button type="button" key={rule.key} className={css.rule} aria-label={rule.label} aria-pressed={canvas[rule.key]}
+            disabled={!canvas.snapping} onClick={() => updateCanvasSettings({ [rule.key]: !canvas[rule.key] })}>
+            {rule.label}
+          </button>
+        ))}</div>
+      </ToolbarPopupSection>}>
+      <button type="button" className={triggerClassName} aria-label="Snapping rules"
+        aria-haspopup="dialog" aria-expanded={open} onClick={() => setOpen((current) => !current)}>
+        <span aria-hidden="true">▾</span>
+      </button>
+    </ToolbarToolPopup>
+  </>;
+}
