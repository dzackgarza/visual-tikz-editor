+  max-width: calc(100vw - 24px);
+  padding: 12px;
+  border: 1px solid var(--border);
+  border-radius: 12px;
+  color: var(--text);
+  background: var(--bg-pane);
+  box-shadow: 0 8px 24px color-mix(in srgb, black 25%, transparent);
+  font-size: 14px;
+}
+
+.popup strong {
+  text-transform: capitalize;
+}
+
+.popup label {
+  display: grid;
+  grid-template-columns: 1fr auto;
+  align-items: center;
+  gap: 6px;
+}
+
