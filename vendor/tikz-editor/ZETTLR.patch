@@ -0,0 +1,88 @@
+import { buildStatementSnapshotFromStatements } from "tikz-editor/edit/statement-ops";
+import type { DocumentSession } from "./types";
+
+export function documentLockStatements(document: DocumentSession) {
+  if (!document.snapshot.parseResult) return [];
+  return buildStatementSnapshotFromStatements(document.snapshot.source, document.snapshot.parseResult.figure.body).all;
+}
+
+export function resolveLockedElementIds(document: DocumentSession): ReadonlySet<string> {
+  const statements = documentLockStatements(document);
+  const lockedSpans = statements.filter((statement) => {
+    const span = mapUnchangedSpan(document.snapshot.source, document.source, statement.span);
+    return span && document.lockedStatements.some((lock) => lock.from === span.from && lock.to === span.to &&
+      lock.text === document.snapshot.source.slice(statement.span.from, statement.span.to));
+  }).map((statement) => statement.span);
+  const ids = new Set<string>();
+  for (const statement of statements) if (lockedSpans.some((span) => statement.span.from >= span.from && statement.span.to <= span.to)) ids.add(statement.id);
+  for (const element of document.snapshot.scene?.elements ?? []) {
+    const span = element.sourceRef.sourceSpan;
+    if (span && lockedSpans.some((lock) => span.from >= lock.from && span.to <= lock.to)) {
+      ids.add(element.id); ids.add(element.sourceRef.sourceId);
+    }
+  }
+  for (const handle of document.snapshot.editHandles) {
+    const span = handle.sourceRef.sourceSpan;
+    if (lockedSpans.some((lock) => span.from >= lock.from && span.to <= lock.to)) {
+      ids.add(handle.id); ids.add(handle.runtimeId); ids.add(handle.sourceRef.sourceId);
+    }
+  }
+  return ids;
+}
+
+export function editActionTouchesLockedElement(document: DocumentSession, action: object): boolean {
+  const ids = resolveLockedElementIds(document);
+  const statements = documentLockStatements(document);
+  const targetLocked = (id: string) => {
+    if (ids.has(id)) return true;
+    const owner = statements.find((statement) => statement.id === id);
+    if (owner && statements.some((child) => ids.has(child.id) && child.span.from >= owner.span.from && child.span.to <= owner.span.to)) return true;
+    const handle = document.snapshot.editHandles.find((candidate) => candidate.id === id);
+    return handle != null && ids.has(handle.sourceRef.sourceId);
+  };
+  function containsTarget(value: unknown, key = ""): boolean {
+    if (typeof value === "string") return /(?:Id|Ids)$/.test(key) && targetLocked(value);
+    if (Array.isArray(value)) return value.some((entry) => containsTarget(entry, key));
+    if (value && typeof value === "object") {
+      if (key === "span" && "from" in value && "to" in value && typeof value.from === "number" && typeof value.to === "number") {
+        const targetFrom = value.from, targetTo = value.to;
+        if (statements.some((statement) => ids.has(statement.id) && statement.span.from < targetTo && statement.span.to > targetFrom)) return true;
+      }
+      return Object.entries(value).some(([field, entry]) => containsTarget(entry, field));
+    }
+    return false;
+  }
+  return containsTarget(action);
+}
+
+export function mapUnchangedSpan(previous: string, next: string, span: { from: number; to: number }) {
+  if (previous === next) return span;
+  let start = 0;
+  while (start < previous.length && start < next.length && previous[start] === next[start]) start++;
+  let beforeEnd = previous.length, afterEnd = next.length;
+  while (beforeEnd > start && afterEnd > start && previous[beforeEnd - 1] === next[afterEnd - 1]) { beforeEnd--; afterEnd--; }
+  if (span.to <= start) return span;
+  if (span.from >= beforeEnd) { const delta = afterEnd - beforeEnd; return { from: span.from + delta, to: span.to + delta }; }
+  return null;
+}
+
+export function reconcileElementLocks(previous: DocumentSession, next: DocumentSession): DocumentSession {
+  if (previous.source === next.source || previous.lockedStatements.length === 0) return next;
+  const patches = next.lastEditPatchBaseRevision === previous.sourceRevision ? next.lastEditPatches : null;
+  const locks = previous.lockedStatements.flatMap((lock) => {
+    let span: { from: number; to: number } | null = { from: lock.from, to: lock.to };
+    if (patches) {
+      let offset = 0;
+      for (const patch of patches) {
+        if (patch.oldSpan.to <= lock.from) offset += patch.replacement.length - (patch.oldSpan.to - patch.oldSpan.from);
+        else if (patch.oldSpan.from < lock.to && patch.oldSpan.to > lock.from) { span = null; break; }
+      }
+      if (span) span = { from: lock.from + offset, to: lock.to + offset };
+    } else span = mapUnchangedSpan(previous.source, next.source, lock);
+    return span && next.source.slice(span.from, span.to) === lock.text ? [{ ...span, text: lock.text }] : [];
+  });
+  const released = locks.length !== previous.lockedStatements.length;
+  return { ...next, lockedStatements: locks,
+    lastEditWarningMessage: released ? "A layer lock was released because its source changed. Review the Layers panel." : next.lastEditWarningMessage,
+    lastEditWarningToken: next.lastEditWarningToken + (released ? 1 : 0) };
+}
