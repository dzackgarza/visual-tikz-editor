+  it('names the point a stroke end attaches to and reuses the name it already has', () => {
+    const source = figure('\\node[draw] (A) at (2,6) {A};\n\\node[draw] at (1,1) {B};\n\\draw (3.37,8.61) -- (7.23,9.29);\n\\draw (0,0) -- (p1);');
+    const handles = handlesOf(source);
