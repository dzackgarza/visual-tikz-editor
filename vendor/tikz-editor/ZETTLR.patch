--- /dev/null
+++ b/packages/app/src/ui/canvas-panel/canvas-session.ts
@@ -0,0 +1,320 @@
+/**
+ * The canvas session: the one interaction state the editor is in, and the provisional data that state owns.
+ * The editor store keeps authored source, the chosen tool and the object selection; this statechart keeps what
+ * the next pen contact does. The states are visual-tikz-editor's docs/interaction-model.md, written as an
+ * XState v5 machine (https://stately.ai/docs/xstate).
+ */
+import type { MutableRefObject } from "react";
+import type { Span } from "tikz-editor/ast/types";
+import { walkStatements } from "tikz-editor/ast/walk";
+import { parseTikzForEdit } from "tikz-editor/edit/parse-options";
+import { assign, createActor, emit, setup, type SnapshotFrom } from "xstate";
+
+import type { ArcConstruction, CircleConstruction } from "../../settings/types";
+import { useSettingsStore } from "../../settings/useSettingsStore";
+import { useEditorStore } from "../../store/store";
+import type { ToolMode } from "../../store/types";
+import type { ArcDraft, FreehandResultOffer, PathToolDraft, PendingBezier, StateSetter, TapDraft } from "./types";
+
+/** How the Circle and Arc tools take their points. */
+export type ConstructionVariant = { circle: CircleConstruction; arc: ArcConstruction };
+
+/** The provisional part of a construction: the points placed so far, before the construction commits. */
+export type Construction =
+  | { kind: "taps"; draft: TapDraft }
+  | { kind: "arc"; draft: ArcDraft }
+  | { kind: "path"; draft: PathToolDraft }
+  | { kind: "bezier"; draft: PendingBezier };
+
+/** The selected curve's editing session: the selected point subset, and touch multi-select. */
+export type CurveSession = {
+  points: ReadonlySet<number>;
+  touchMultiple: boolean;
+};
+
+/** A source that Undo, Redo, or another view wrote, and the ranges of it that the change wrote. */
+/** A source that another view wrote; `changed` holds the ranges an Undo or Redo step wrote, and is null for any other edit. */
+export type ReplacedSource = { source: string; changed: readonly Span[] | null };
+
+type SessionContext = {
+  tool: ToolMode;
+  variant: ConstructionVariant;
+  construction: Construction | null;
+  curve: CurveSession;
+  /** The locked selection: a tap that misses keeps it (FR-052). Null when the selection is not locked. */
+  lockedSelection: ReadonlySet<string> | null;
+  refinement: FreehandResultOffer | null;
+  /** A replaced source whose changed curve points the canvas has yet to choose, once it shows that source. */
+  replaced: ReplacedSource | null;
+};
+
+type SessionEvent =
+  | { type: "tool.chosen"; tool: ToolMode; variant: ConstructionVariant }
+  | { type: "construction.set"; construction: Construction }
+  | { type: "construction.clear"; kind: Construction["kind"] }
+  | { type: "construction.cancel" }
+  | { type: "construction.finish" }
+  | { type: "selection.changed"; ids: ReadonlySet<string> }
+  | { type: "selection.lock"; ids: ReadonlySet<string> | null }
+  | { type: "curve.points"; points: ReadonlySet<number> }
+  | { type: "curve.touchMultiple"; on: boolean }
+  | { type: "refinement.offer"; offer: FreehandResultOffer }
+  | { type: "refinement.close" }
+  | { type: "source.replaced"; replaced: ReplacedSource | null };
+
+const IDLE_CURVE: CurveSession = { points: new Set(), touchMultiple: false };
+
+export function sameIds(left: ReadonlySet<string>, right: ReadonlySet<string>): boolean {
+  return left.size === right.size && [...left].every((id) => right.has(id));
+}
+
+// The next pen contact makes a mark at once with these tools; Select and Lasso select; every other tool constructs.
+const DRAWING_TOOLS: ReadonlySet<ToolMode> = new Set(["addFreehand", "erase", "addBucket", "magnify"]);
+const SELECTING_TOOLS: ReadonlySet<ToolMode> = new Set(["select", "lasso"]);
+
+/** The offer's preview is still on the canvas only while the document stands at the revision the offer recorded. */
+export function offerIsCurrent(offer: FreehandResultOffer): boolean {
+  const { activeDocumentId, sourceRevision } = useEditorStore.getState();
+  return activeDocumentId === offer.documentId && sourceRevision === offer.sourceRevision;
+}
+
+export const canvasSessionMachine = setup({
+  types: {
+    context: {} as SessionContext,
+    events: {} as SessionEvent,
+    input: {} as { tool: ToolMode; variant: ConstructionVariant },
+    // The canvas owns the gesture in progress and the path commit; it listens for these.
+    emitted: {} as { type: "construction.cancelled" } | { type: "construction.finished" }
+  },
+  guards: {
+    drawingTool: ({ context }) => DRAWING_TOOLS.has(context.tool),
+    selectingTool: ({ context }) => SELECTING_TOOLS.has(context.tool),
+    editsPoints: ({ context }) => context.curve.points.size > 0 || context.curve.touchMultiple
+  },
+  actions: {
+    // Leaving a refinement, by Cancel or otherwise, drops its unapplied preview.
+    settleRefinement: ({ context }) => {
+      const offer = context.refinement;
+      if (offer && offerIsCurrent(offer)) useEditorStore.getState().dispatch({ type: "SET_SOURCE_TRANSIENT", source: offer.baseSource });
+    }
+  }
+}).createMachine({
+  id: "session",
+  context: ({ input }) => ({ tool: input.tool, variant: input.variant, construction: null, curve: IDLE_CURVE, lockedSelection: null, refinement: null, replaced: null }),
+  initial: "work",
+  on: {
+    // A tool change ends the construction, the curve session, and the lock; finished geometry is already committed.
+    "tool.chosen": {
+      target: ".work.route",
+      actions: ["settleRefinement", assign(({ event }) => ({ tool: event.tool, variant: event.variant, construction: null, curve: IDLE_CURVE, lockedSelection: null }))]
+    },
+    // Use for new strokes holds for this session; Save as default makes the session's values the saved defaults.
+    "source.replaced": { actions: assign(({ event }) => ({ replaced: event.replaced })) }
+  },
+  states: {
+    work: {
+      initial: "route",
+      entry: assign({ refinement: null }),
+      on: {
+        "refinement.offer": { target: "refining", actions: assign(({ event }) => ({ refinement: event.offer })) }
+      },
+      states: {
+        route: {
+          always: [{ guard: "drawingTool", target: "drawing" }, { guard: "selectingTool", target: "objects" }, { target: "constructing" }]
+        },
+        drawing: {},
+        constructing: {
+          on: {
+            "construction.set": { actions: assign(({ event }) => ({ construction: event.construction })) },
+            "construction.clear": { actions: assign(({ context, event }) => ({ construction: context.construction?.kind === event.kind ? null : context.construction })) },
+            "construction.cancel": { actions: [assign({ construction: null }), emit({ type: "construction.cancelled" })] },
+            "construction.finish": { guard: ({ context }) => context.construction?.kind === "path", actions: emit({ type: "construction.finished" }) }
+          }
+        },
+        objects: {
+          initial: "selecting",
+          on: {
+            "selection.changed": {
+              target: ".selecting",
+              // A command that changes the selection, as Delete or Duplicate does, ends its lock.
+              actions: assign(({ context, event }) => ({
+                curve: { ...context.curve, points: new Set<number>() },
+                lockedSelection: context.lockedSelection !== null && sameIds(context.lockedSelection, event.ids) ? context.lockedSelection : null
+              }))
+            },
+            "selection.lock": { actions: assign(({ event }) => ({ lockedSelection: event.ids })) },
+            "curve.points": { target: ".selecting", actions: assign(({ context, event }) => ({ curve: { ...context.curve, points: event.points } })) },
+            "curve.touchMultiple": { target: ".selecting", actions: assign(({ context, event }) => ({ curve: { ...context.curve, touchMultiple: event.on } })) }
+          },
+          states: {
+            selecting: { always: { guard: "editsPoints", target: "editingPoints" } },
+            editingPoints: { always: { guard: ({ context }) => context.curve.points.size === 0 && !context.curve.touchMultiple, target: "selecting" } }
+          }
+        },
+        resume: { type: "history", history: "deep", target: "route" }
+      }
+    },
+    refining: {
+      on: {
+        "refinement.offer": { actions: assign(({ event }) => ({ refinement: event.offer })) },
+        "refinement.close": { target: "#session.work.resume", actions: "settleRefinement" }
+      }
+    }
+  }
+});
+
+export type CanvasSessionSnapshot = SnapshotFrom<typeof canvasSessionMachine>;
+
+function chosenVariant(): ConstructionVariant {
+  const { circleConstruction, arcConstruction } = useSettingsStore.getState().settings.toolbar;
+  return { circle: circleConstruction, arc: arcConstruction };
+}
+
+/** The editor's one canvas session, beside the editor store it reads. */
+export const canvasSession = createActor(canvasSessionMachine, { input: { tool: useEditorStore.getState().toolMode, variant: chosenVariant() } }).start();
+
+// The session follows the store's tool, selection and chosen construction, whichever surface changed them.
+let followedSelection = useEditorStore.getState().selectedElementIds;
+function followStore(): void {
+  const { toolMode: tool, selectedElementIds } = useEditorStore.getState();
+  if (selectedElementIds !== followedSelection) {
+    followedSelection = selectedElementIds;
+    canvasSession.send({ type: "selection.changed", ids: selectedElementIds });
+  }
+  const variant = chosenVariant();
+  const { context } = canvasSession.getSnapshot();
+  if (context.tool === tool && context.variant.circle === variant.circle && context.variant.arc === variant.arc) return;
+  canvasSession.send({ type: "tool.chosen", tool, variant });
+}
+useEditorStore.subscribe(followStore);
+useSettingsStore.subscribe(followStore);
+
+/** The session state the interaction model names. */
+export function sessionStateName(snapshot: CanvasSessionSnapshot): "drawing" | "constructing" | "selecting" | "editingPoints" | "refining" {
+  if (snapshot.matches("refining")) return "refining";
+  if (snapshot.matches({ work: "drawing" })) return "drawing";
+  if (snapshot.matches({ work: { objects: "editingPoints" } })) return "editingPoints";
+  if (snapshot.matches({ work: "objects" })) return "selecting";
+  return "constructing";
+}
+
+/** The name the Geometry picker and the Label control give a construction. */
+export function constructionName(tool: ToolMode, variant: ConstructionVariant): string {
+  switch (tool) {
+    case "addArc": return variant.arc === "three-points" ? "Arc through three points" : "Arc";
+    case "addCircle": return variant.circle === "three-points" ? "Circle through three points" : variant.circle === "diameter" ? "Circle on a diameter" : "Circle";
+    case "addLine": return "Line";
+    case "addArrow": return "Arrow";
+    case "addPath": return "Path";
+    case "addBezier": return "Curve";
+    case "addPoint": return "Point";
+    case "addEllipse": return "Ellipse";
+    case "addRect": return "Rectangle";
+    case "addGrid": return "Grid";
+    case "addShape": return "Node shape";
+    case "addMatrix": return "Matrix";
+    case "addNode": return "Text";
+    case "addImage": return "Image";
+    default: return tool;
+  }
+}
+
+/** Whether the construction in progress has a Finish step: an open path with its points placed. */
+export function constructionFinishes(snapshot: CanvasSessionSnapshot): boolean {
+  return snapshot.matches({ work: "constructing" }) && snapshot.context.construction?.kind === "path";
+}
+
+/** Whether a construction is in progress, so its Cancel belongs in the Active Tool Menu (FR-032). */
+export function constructing(snapshot: CanvasSessionSnapshot): boolean {
+  return snapshot.matches({ work: "constructing" });
+}
+
+function readConstruction(): Construction | null {
+  return canvasSession.getSnapshot().context.construction;
+}
+
+function sendDraft(kind: Construction["kind"], construction: Construction | null): void {
+  canvasSession.send(construction ? { type: "construction.set", construction } : { type: "construction.clear", kind });
+}
+
+// React-style setters, so gesture code writes construction stages as it wrote component state.
+export const setPathDraft: StateSetter<PathToolDraft | null> = (update) => {
+  const current = readConstruction();
+  const next = typeof update === "function" ? update(current?.kind === "path" ? current.draft : null) : update;
+  sendDraft("path", next && { kind: "path", draft: next });
+};
+export const setPendingBezier: StateSetter<PendingBezier | null> = (update) => {
+  const current = readConstruction();
+  const next = typeof update === "function" ? update(current?.kind === "bezier" ? current.draft : null) : update;
+  sendDraft("bezier", next && { kind: "bezier", draft: next });
+};
+export const setArcDraft: StateSetter<ArcDraft | null> = (update) => {
+  const current = readConstruction();
+  const next = typeof update === "function" ? update(current?.kind === "arc" ? current.draft : null) : update;
+  sendDraft("arc", next && { kind: "arc", draft: next });
+};
+export const setTapDraft: StateSetter<TapDraft | null> = (update) => {
+  const current = readConstruction();
+  const next = typeof update === "function" ? update(current?.kind === "taps" ? current.draft : null) : update;
+  sendDraft("taps", next && { kind: "taps", draft: next });
+};
+
+/** Whether a change that wrote `range` touched `span`: a written range meets it, and a deletion falls inside it. */
+export function changeTouches(span: Span, range: Span): boolean {
+  if (range.from === range.to) return span.from < range.from && range.from < span.to;
+  return span.from < range.to && range.from < span.to;
+}
+
+/**
+ * Show a source that Undo, Redo, or another view wrote. After Undo or Redo the selection becomes the path
+ * statements that the step touched, and in Edit Points the canvas then chooses the curve points it touched
+ * (FR-054); after another edit the selection keeps the statements that the figure still holds.
+ */
+export function replaceSource(replaced: ReplacedSource): void {
+  const { activeFigureId, dispatch, selectedElementIds } = useEditorStore.getState();
+  const { changed } = replaced;
+  const selected = new Set<string>();
+  walkStatements(parseTikzForEdit(replaced.source, { activeFigureId }).figure.body, {
+    onStatement: (statement) => {
+      const keep = changed === null
+        ? selectedElementIds.has(statement.id)
+        : statement.kind === "Path" && changed.some((range) => changeTouches(statement.span, range));
+      if (keep) selected.add(statement.id);
+    }
+  });
+  dispatch({ type: "SOURCE_REPLACED", source: replaced.source, selectedElementIds: selected });
+  canvasSession.send({ type: "source.replaced", replaced });
+}
+
+/** The canvas took the replaced source's points, or the source changed again before it could. */
+export function settleReplacedSource(): void {
+  canvasSession.send({ type: "source.replaced", replaced: null });
+}
+
+/** Lock the given selection, or unlock with null. */
+export function setLockedSelection(ids: ReadonlySet<string> | null): void {
+  canvasSession.send({ type: "selection.lock", ids });
+}
+export const setSelectedNodeIndices: StateSetter<ReadonlySet<number>> = (update) => {
+  const points = typeof update === "function" ? update(canvasSession.getSnapshot().context.curve.points) : update;
+  canvasSession.send({ type: "curve.points", points });
+};
+export function setTouchNodeSelection(on: boolean): void {
+  canvasSession.send({ type: "curve.touchMultiple", on });
+}
+/** Open or update the refinement of a freehand result; null closes it, dropping an unapplied preview. */
+export function setFreehandResultOffer(offer: FreehandResultOffer | null): void {
+  canvasSession.send(offer ? { type: "refinement.offer", offer } : { type: "refinement.close" });
+}
+
+
+/** The path stage as a ref, for gesture handlers that read it between renders. */
+export const pathDraftRef: MutableRefObject<PathToolDraft | null> = {
+  get current() {
+    const current = readConstruction();
+    return current?.kind === "path" ? current.draft : null;
+  },
+  set current(draft) {
+    setPathDraft(draft);
+  }
+};
diff --git a/packages/app/src/ui/canvas-panel/eraser-sweep.ts b/packages/app/src/ui/canvas-panel/eraser-sweep.ts
new file mode 100644
index 00000000..71cb58d6
--- /dev/null
+++ b/packages/app/src/ui/canvas-panel/eraser-sweep.ts
@@ -0,0 +1,111 @@
+import paper from "paper";
+type Point = { x: number; y: number };
+export type EraserStroke = { sourceId: string; strokeRadius: number; segments: Array<readonly [Point, Point]> };
+
+function distanceToSegment(point: Point, start: Point, end: Point): number {
+  const dx = end.x - start.x;
+  const dy = end.y - start.y;
+  const length = dx * dx + dy * dy;
+  const t = length === 0 ? 0 : Math.max(0, Math.min(1, ((point.x - start.x) * dx + (point.y - start.y) * dy) / length));
+  return Math.hypot(point.x - start.x - t * dx, point.y - start.y - t * dy);
+}
+function cross(a: Point, b: Point, c: Point): number {
+  return (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x);
+}
+export function sweptStrokeIds(strokes: readonly EraserStroke[], from: Point, to: Point, radius: number): string[] {
+  return strokes.filter((stroke) => stroke.segments.some(([a, b]) => {
+    const c1 = cross(from, to, a), c2 = cross(from, to, b), c3 = cross(a, b, from), c4 = cross(a, b, to);
+    const crossing = c1 * c2 < 0 && c3 * c4 < 0;
+    return crossing || Math.min(distanceToSegment(a, from, to), distanceToSegment(b, from, to),
+      distanceToSegment(from, a, b), distanceToSegment(to, a, b)) <= radius + stroke.strokeRadius;
+  })).map((stroke) => stroke.sourceId);
+}
+
+function visibleGeometry(path: SVGGeometryElement): boolean {
+  for (let element: Element | null = path; element; element = element.parentElement) {
+    const style = getComputedStyle(element);
+    if (style.display === "none" || style.visibility === "hidden" || Number.parseFloat(style.opacity) === 0) return false;
+  }
+  const style = getComputedStyle(path);
+  const hasStroke = style.stroke !== "none" && Number.parseFloat(style.strokeOpacity) !== 0;
+  const hasFill = style.fill !== "none" && Number.parseFloat(style.fillOpacity) !== 0;
+  return hasStroke || hasFill;
+}
+
+function clipRegions(path: SVGGeometryElement, scope: paper.PaperScope): paper.PathItem[][] | null {
+  const regions: paper.PathItem[][] = [];
+  for (let element: Element | null = path; element instanceof SVGElement; element = element.parentElement) {
+    const clip = getComputedStyle(element).clipPath;
+    if (clip === "none") continue;
+    const id = /#([^"')]+)["']?\)$/u.exec(clip)?.[1];
+    const definition = id ? path.ownerSVGElement?.querySelector<SVGClipPathElement>(`#${CSS.escape(id)}`) : null;
+    if (!definition || definition.getAttribute("clipPathUnits") === "objectBoundingBox") return null;
+    const region: paper.PathItem[] = [];
+    for (const geometry of Array.from(definition.querySelectorAll<SVGGeometryElement>("path, circle, ellipse, rect, line, polyline, polygon"))) {
+      const matrix = geometry.getScreenCTM();
+      if (!matrix) return null;
+      const clone = geometry.cloneNode(true) as SVGGeometryElement;
+      clone.removeAttribute("transform");
+      clone.setAttribute("fill-rule", getComputedStyle(geometry).clipRule);
+      const item = scope.project.importSVG(clone, { insert: false, expandShapes: true });
+      if (!(item instanceof scope.PathItem)) { item.remove(); return null; }
+      item.fillRule = getComputedStyle(geometry).clipRule === "evenodd" ? "evenodd" : "nonzero";
+      item.transform(new scope.Matrix(matrix.a, matrix.b, matrix.c, matrix.d, matrix.e, matrix.f));
+      region.push(item);
+    }
+    regions.push(region);
+  }
+  return regions;
+}
+
+/** Split at true clip boundary intersections, including visible intervals narrower than the sampling step. */
+function clippedSegments(from: Point, to: Point, regions: readonly paper.PathItem[][], scope: paper.PaperScope): Array<readonly [Point, Point]> {
+  if (regions.length === 0) return [[from, to]];
+  const inside = (point: Point) => regions.every((region) => region.some((path) => path.contains(new scope.Point(point.x, point.y))));
+  const line = new scope.Path.Line({ from: new scope.Point(from.x, from.y), to: new scope.Point(to.x, to.y), insert: false });
+  const length = line.length;
+  if (length === 0) { line.remove(); return inside(from) ? [[from, to]] : []; }
