+.popup {
+  position: fixed;
+  z-index: 200;
+  display: grid;
+  gap: 10px;
+  width: 268px;
+  max-width: calc(100vw - 24px);
+  padding: 12px;
+  border: 1px solid var(--border);
+  border-radius: 12px;
+  color: var(--text);
+  background: var(--bg-pane);
+  box-shadow: 0 8px 24px color-mix(in srgb, black 25%, transparent);
+  font-size: 14px;
+}
+
+.popup strong {
+  text-transform: capitalize;
+}
+
+.popup label {
+  display: grid;
+  grid-template-columns: 1fr auto;
+  align-items: center;
+  gap: 6px;
+}
+
+.popup input {
+  grid-column: 1 / -1;
+  width: 100%;
+  accent-color: #9e2a2b;
+}
+
+.actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+}
+
+.actions button {
+  min-height: 44px;
+  padding: 4px 10px;
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  background: var(--bg-app);
+  color: var(--text);
+  font: inherit;
+  cursor: pointer;
+}
+
+.actions button:focus-visible {
+  outline: 2px solid #9e2a2b;
+  outline-offset: 2px;
+}
+
+.reapply {
+  position: fixed;
+  z-index: 190;
+  min-height: 44px;
+  padding: 8px 14px;
