+// The shell keeps the one history of the document, which every view of the source shares; the
+// editor's Undo and Redo ask the shell to step it (Emacs keeps the history by buffer, not by window:
+// https://www.gnu.org/software/emacs/manual/html_node/emacs/Undo.html).
+export function requestUndo(): void {
+  window.dispatchEvent(new Event("tikz-embed-undo-request"));
+}
+
+export function requestRedo(): void {
+  window.dispatchEvent(new Event("tikz-embed-redo-request"));
+}
