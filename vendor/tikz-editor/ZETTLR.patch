@@ -0,0 +1,44 @@
+/** Window-coordinate depth that the docked rail, the open properties panel, and the on-screen keyboard take from each canvas edge. */
+export type OccupiedInsets = { left: number; right: number; top: number; bottom: number };
+
+/** Dispatched on `window` when the rail, the properties panel, or the keyboard changes the space it takes. */
+export const OCCUPIED_INSETS_EVENT = "tikz-occupied-insets";
+
+function inset(name: string): number {
+  return Number.parseFloat(getComputedStyle(document.documentElement).getPropertyValue(name));
+}
+
+function railInsets(): OccupiedInsets {
+  return { left: inset("--rail-inset-left"), right: inset("--rail-inset-right"), top: inset("--rail-inset-top"), bottom: inset("--rail-inset-bottom") };
+}
+
+/**
+ * The depth the rail and the panel take as laid out with the keyboard closed: the
+ * frame that zoom-to-fit and the startup view use, so the keyboard never changes the zoom.
+ * The bottom sheet rides on the higher of the rail and the keyboard (DockLayout.css),
+ * so the keyboard's lift above the rail comes off the sheet's inset.
+ */
+export function restingInsets(): OccupiedInsets {
+  const rail = railInsets();
+  const sheet = inset("--panel-inset-bottom");
+  const lift = Math.max(0, inset("--keyboard-inset-bottom") - rail.bottom);
+  return {
+    ...rail,
+    right: Math.max(rail.right, inset("--panel-inset-right")),
+    bottom: Math.max(rail.bottom, sheet > 0 ? sheet - lift : 0)
+  };
+}
+
+export function occupiedInsets(): OccupiedInsets {
+  const resting = restingInsets();
+  return { ...resting, bottom: Math.max(inset("--panel-inset-bottom"), inset("--keyboard-inset-bottom"), resting.bottom) };
+}
+
+/** Writes the named inset properties and announces the change; unchanged values announce nothing. */
+export function publishOccupiedInsets(insets: Readonly<Record<string, number>>): void {
+  const root = document.documentElement.style;
+  const changed = Object.entries(insets).filter(([name, size]) => root.getPropertyValue(name) !== `${size}px`);
+  if (changed.length === 0) return;
+  for (const [name, size] of changed) root.setProperty(name, `${size}px`);
+  window.dispatchEvent(new Event(OCCUPIED_INSETS_EVENT));
+}
