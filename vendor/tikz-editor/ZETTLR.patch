index 00000000..8b3e1132
--- /dev/null
+++ b/packages/core/src/edit/actions/layer-actions.ts
@@ -0,0 +1,110 @@
+import type { EditActionResultLike } from "../result-types.js";
+import type { Span } from "../../ast/types.js";
+import type { EditParseOptions } from "../parse-options.js";
+import {
+  applyTextReplacements,
+  formatSnippetsForInsertion,
+  lineIndentAtOffset,
+  mapSpansToStatementIds,
+  parseStatementSnapshot,
+  resolveRootInsertionPoint,
+  resolveStatementRefs,
+  statementSnippet,
+  type StatementRef
+} from "../statement-ops.js";
+import { normalizeElementIds } from "../statement-find.js";
+import { collectSiblingDependencyConstraints, preservesDependencyOrder } from "./group-ungroup-actions.js";
+
+const END_SCOPE = "\\end{scope}";
+
+/** Add an empty layer, a top-level scope named `name`, in front of everything else. */
+export function applyAddLayerAction(source: string, name: string): EditActionResultLike {
+  if (name.trim().length === 0) throw new Error("A layer needs a name.");
+  const at = resolveRootInsertionPoint(source);
+  const indent = at.indent.slice(0, -2);
+  const text = `${at.indent}\\begin{scope}[name=${name}]\n${at.indent}\\end{scope}\n${indent}`;
+  // On its own line, \end{tikzpicture} keeps its indentation after the new scope; after content, it moves to a new line.
+  const lineStart = source.lastIndexOf("\n", at.offset - 1) + 1;
+  const ownLine = source.slice(lineStart, at.offset).trim().length === 0;
+  const applied = applyTextReplacements(source, [ownLine
+    ? { span: { from: lineStart, to: at.offset }, text }
+    : { span: { from: at.offset, to: at.offset }, text: `\n${text}` }]);
+  return {
+    kind: "success",
+    newSource: applied.source,
+    patches: applied.patches,
+    selectedSourceIds: []
+  };
+}
+
+/**
+ * Move statements to the end of a scope's body (a layer, when the scope is top level).
+ * Refused when the move would put a statement after one that uses what it defines, or before one it uses.
+ */
+export function applyMoveIntoScopeAction(
+  source: string,
+  elementIds: readonly string[],
+  scopeId: string,
+  parseOptions: EditParseOptions = {}
+): EditActionResultLike {
+  const snapshot = parseStatementSnapshot(source, parseOptions);
+  const scope = snapshot.byId.get(scopeId);
+  if (!scope || scope.statement.kind !== "Scope") {
+    return { kind: "unsupported", reason: `${scopeId} is not a scope.` };
+  }
+  const within = (inner: Span, outer: Span) => inner.from >= outer.from && inner.to <= outer.to;
+  const selected = resolveStatementRefs(snapshot, normalizeElementIds(elementIds));
+  if (selected.some((ref) => within(scope.span, ref.span))) {
+    return { kind: "unsupported", reason: "A layer cannot be moved into itself." };
+  }
+  // Outermost selected statements not already in the scope; their children move with them.
+  const moved = selected
+    .filter((ref) => !within(ref.span, scope.span))
+    .filter((ref) => !selected.some((other) => other !== ref && within(ref.span, other.span)))
+    .sort((left, right) => left.span.from - right.span.from);
+  if (moved.length === 0) {
+    return { kind: "unsupported", reason: "The selection is already in this layer." };
+  }
+
+  const isMoved = (ref: StatementRef) => moved.some((block) => within(ref.span, block.span));
+  const ordered = [...snapshot.all].sort((left, right) => left.span.from - right.span.from);
+  const staying = ordered.filter((ref) => !isMoved(ref));
+  const lastInScope = staying.reduce((index, ref, position) => within(ref.span, scope.span) ? position : index, -1);
+  const nextOrder = [...staying.slice(0, lastInScope + 1), ...ordered.filter(isMoved), ...staying.slice(lastInScope + 1)].map((ref) => ref.id);
+  const constraints = collectSiblingDependencyConstraints(source, ordered.map((ref) => ref.id), parseOptions);
+  if (!preservesDependencyOrder(nextOrder, constraints)) {
+    return { kind: "unsupported", reason: "Moving this into the layer would draw it out of order with a node or coordinate it defines or uses." };
+  }
+
+  const endIndex = source.lastIndexOf(END_SCOPE, scope.span.to - END_SCOPE.length);
+  const scopeIndent = lineIndentAtOffset(source, scope.span.from);
+  const endLineStart = source.lastIndexOf("\n", endIndex - 1) + 1;
+  const endOnOwnLine = endLineStart > scope.span.from && source.slice(endLineStart, endIndex).trim().length === 0;
+  const insertion = formatSnippetsForInsertion(moved.map((ref) => statementSnippet(source, ref)), `${scopeIndent}  `, endOnOwnLine
+    ? undefined
+    : { trailingNewline: true, newline: `\n${scopeIndent}` });
+  const insertAt = endOnOwnLine ? endLineStart - 1 : endIndex;
+  const applied = applyTextReplacements(source, [
+    ...moved.map((ref) => ({ span: removalSpan(source, ref.span), text: "" })),
+    { span: { from: insertAt, to: insertAt }, text: insertion.text }
+  ]);
+  const inserted = applied.applied.find((entry) => entry.oldSpan.from === insertAt && entry.oldSpan.to === insertAt)!;
+  return {
+    kind: "success",
+    newSource: applied.source,
+    patches: applied.patches,
+    selectedSourceIds: mapSpansToStatementIds(applied.source, insertion.snippetSpans.map((span) => ({
+      from: inserted.newSpan.from + span.from,
+      to: inserted.newSpan.from + span.to
+    })))
+  };
+}
+
+/** A statement's span widened to its whole line when nothing else shares the line. */
+function removalSpan(source: string, span: Span): Span {
+  const lineStart = source.lastIndexOf("\n", span.from - 1) + 1;
+  const lineEnd = source.indexOf("\n", span.to);
+  const end = lineEnd < 0 ? source.length : lineEnd;
+  const alone = source.slice(lineStart, span.from).trim().length === 0 && source.slice(span.to, end).trim().length === 0;
+  return alone && lineStart > 0 ? { from: lineStart - 1, to: end } : span;
+}
