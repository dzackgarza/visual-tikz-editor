diff --git a/src/zettlr-host.css b/src/zettlr-host.css
new file mode 100644
index 0000000..72f7f70
--- /dev/null
+++ b/src/zettlr-host.css
@@ -0,0 +1,104 @@
+html,
+body.zettlr-quiver-host {
+    width: 100%;
+    height: 100%;
+    margin: 0;
+    overflow: hidden;
+}
+
+body.zettlr-quiver-host.ui {
+    position: relative;
+    width: 100%;
+    height: 100%;
+}
+
+/* Zettlr owns persistence, source editing, macros and mode switching. Keep
+ * Quiver's actual diagram editor, inspector, toolbar, touch gestures and
+ * shortcuts, but remove the website-oriented import/export/share surface. */
+body.zettlr-quiver-host .panel.global,
+body.zettlr-quiver-host .port,
+body.zettlr-quiver-host #welcome-pane,
+body.zettlr-quiver-host .version,
+body.zettlr-quiver-host > a > .logo,
+body.zettlr-quiver-host .pane:not(#keyboard-shortcuts-pane) {
+    display: none !important;
+}
+
+/* The upstream toolbar is a fixed 672px strip. In the RHS editor pane that
+ * pushes legitimate editor actions beyond the iframe viewport. Host mode wraps
+ * the same native actions instead of hiding/scaling them; fullscreen restores
+ * Quiver's ordinary single-row toolbar geometry. */
+body.zettlr-quiver-host .toolbar {
+    left: 8px;
+    right: 8px;
+    top: 8px;
+    width: auto;
+    height: auto;
+    min-height: 60px;
+    transform: none;
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: center;
+}
+
+body.zettlr-quiver-host:not(.dark-theme) .toolbar {
+    background: #f5f6f2;
+    border: 1px solid #d7ddd4;
+    box-shadow: 0 8px 24px rgba(28, 42, 35, 0.16);
+    color: #27342f;
+}
+
+body.zettlr-quiver-host .toolbar .action {
+    cursor: pointer;
+}
+
+body.zettlr-quiver-host .toolbar .action .name,
+body.zettlr-quiver-host .toolbar .action .shortcut {
+    color: inherit;
+    font-size: 11px;
+    line-height: 11px;
+}
+
+body.zettlr-quiver-host:not(.dark-theme) .toolbar .action img {
+    filter: brightness(0);
+}
+
+body.zettlr-quiver-host:not(.dark-theme) .toolbar .action:hover,
+body.zettlr-quiver-host:not(.dark-theme) .toolbar .action:focus-visible {
+    background: #e3ece7;
+}
+
+body.zettlr-quiver-host .toolbar .action:focus-visible {
+    outline: 2px solid #1883a5;
+    outline-offset: -2px;
+}
+
+body.zettlr-quiver-host:not(.dark-theme) .toolbar .action .subtoolbar {
+    background: #f5f6f2;
+    box-shadow: 0 8px 24px rgba(28, 42, 35, 0.16);
+}
+
+body.zettlr-quiver-host .toolbar .action:focus-within .subtoolbar {
+    display: block;
+}
+
+body.zettlr-quiver-host.zettlr-fullscreen .toolbar {
+    left: 50%;
+    right: auto;
+    top: 16px;
+    width: auto;
+    height: 60px;
+    min-height: 0;
+    transform: translateX(-50%);
+    display: block;
+}
+
+/* Upstream positions help immediately below its one-row toolbar. Host mode can
+ * have multiple rows, so centre the shortcuts pane independently. */
+body.zettlr-quiver-host #keyboard-shortcuts-pane {
+    left: 50%;
+    top: 50%;
+    transform: translate(-50%, -50%);
+    width: min(72%, 48rem);
+    max-height: 72%;
+}
